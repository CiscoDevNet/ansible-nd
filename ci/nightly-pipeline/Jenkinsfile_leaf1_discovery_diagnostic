# Authoritative lab roster from nd_prerequisite_profiles.yaml (lab.switches), grouped by the
# fabric each switch is onboarded into (shallow discovery is scoped to a single fabric).
ROSTER = {
    'VXLAN_EVPN_Fabric': [
        {'ip': '192.0.2.195', 'serial': 'SERIAL00001', 'name': 'vxlan_leaf_1', 'role': 'leaf'},
        {'ip': '192.0.2.196', 'serial': 'SERIAL00002', 'name': 'vxlan_leaf_2', 'role': 'leaf'},
        {'ip': '192.0.2.194', 'serial': 'SERIAL00003', 'name': 'vxlan_spine_1', 'role': 'spine'},
        {'ip': '192.0.2.88', 'serial': 'SERIAL00004', 'name': 'vxlan_border_1', 'role': 'border'},
        {'ip': '192.0.2.85', 'serial': 'SERIAL00008', 'name': 'vxlan_leaf_3', 'role': 'leaf'},
        {'ip': '192.0.2.86', 'serial': 'SERIAL00009', 'name': 'vxlan_leaf_4', 'role': 'leaf'},
    ],
    'External_Connectivity_Fabric': [
        {'ip': '192.0.2.89', 'serial': 'SERIAL00005', 'name': 'external_edge_1', 'role': 'edge_router'},
        {'ip': '192.0.2.90', 'serial': 'SERIAL00006', 'name': 'external_edge_2', 'role': 'edge_router'},
