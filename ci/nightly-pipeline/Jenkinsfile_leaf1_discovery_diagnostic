// Read-only roster discovery with timed device/SNMP probes for leaf_1 and leaf_2.
pipeline {
    agent { docker { image 'ansible_nd_setup'; args '--user root' } }
    options {
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }
    stages {
        stage('Probe roster discovery') {
            steps {
                script {
                    try {
                        sh '''#!/bin/bash
set -euo pipefail
if ! command -v ping >/dev/null || ! command -v snmpget >/dev/null || ! command -v snmpwalk >/dev/null; then
    if command -v apt-get >/dev/null && \
       timeout 120 apt-get update -qq -o Acquire::Retries=0 -o Acquire::http::Timeout=15 -o Acquire::https::Timeout=15 && \
       timeout 120 apt-get install -y -qq --no-install-recommends iputils-ping snmp; then
        echo 'Diagnostic transport tools are available.'
    else
        echo 'Diagnostic dependency installation failed; unavailable probes will be reported as tool_missing.' >&2
    fi
fi
'''
                        withCredentials([
                            string(credentialsId: 'ANSIBLE_NDFC_USERNAME', variable: 'NDFC_USER'),
                            string(credentialsId: 'ANSIBLE_NDFC_41_117_PASSWORD', variable: 'NDFC_PASSWORD'),
                            usernamePassword(credentialsId: 'SWITCH_CREDENTIALS',
                                usernameVariable: 'ANSIBLE_NXOS_SWITCH_USERNAME',
                                passwordVariable: 'ANSIBLE_NXOS_SWITCH_PASSWORD')
                        ]) {
                            sh '''#!/bin/bash
set -euo pipefail
set +x
umask 077
probe_exit=0
"$HOME/ansible/venv/bin/python" -u - <<'PY' | tee discovery_diagnostic.jsonl || probe_exit=$?
