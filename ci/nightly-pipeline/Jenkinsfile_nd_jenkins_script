    }
}

/**
 * Parses test results from the test output.
 * Sets failure flag if test failures are detected.
 * @param ndfcConfig The NDFC configuration object.
 * @param failureFlagName The failure flag to set on failure.
 */
def parseTestResults(ndfcConfig, failureFlagName, pb, testType = 'smoke', expectedRunMarker = '', reportContext = [:]) {
    def reportingFabric = reportContext.fabric ?: ndfcConfig.fabric_name
    def reportingScope = reportContext.scope ?: fabricScopeLabel(ndfcConfig.fabric_name)
    echo "⏱ Function 'parseTestResults' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"

    // DEBUG: Used for sample test. def testOutputFileResponse = httpRequest(url: "http://198.51.100.155:8500/v1/kv/ansible-nd/sample_output.txt?raw")
    // def testOutputFileName = "sample_output.txt"
    def testOutputFileName = "${env.COLLECTIONS_DIRECTORY}/test_output_${ndfcConfig.fabric_name}_${ndfcConfig.versionId}_${pb}.txt"
    def totalFailedCount = 0

    try {
        def testOutput = withEnv(["ND_REPORT_LOG=${testOutputFileName}", "ND_REPORT_MODULE=${pb}", "ND_REPORT_RUN=${expectedRunMarker}"]) {
            sh(script: '''#!/bin/bash
                set -e
                "$HOME/ansible/venv/bin/python" "$COLLECTIONS_DIRECTORY/nd_result_summary.py" summarize \\
                    --log "$ND_REPORT_LOG" --module "$ND_REPORT_MODULE" --run-id "$ND_REPORT_RUN" \\
                    --require-execution --format recap
            ''', returnStdout: true).trim()
        }
        echo "📊 Parsing test results from: ${testOutputFileName}"

        // A previous build's successful recap must never satisfy this run. Every
        // execution writes the marker before Ansible starts, and parsing fails
        // closed unless the output contains this run's exact marker.
        if (!expectedRunMarker || !testOutput.contains("[RUN_MARKER: ${expectedRunMarker}]")) {
            setFailureFlag(failureFlagName, true)
            error("Test stage failed: output for ${pb} is missing the current-run marker")
        }

        def capabilityCases = virtualPeerLinkCapabilityFailures(testOutput)
        def capabilityNote = capabilityCases ? "NDP_UNSUPPORTED_CAPABILITY count=${capabilityCases.size()} tests=${capabilityCases.join('; ')}" : ''
        def activityRow = MODULE_ACTIVITY_RESULTS[activityResultKey(ndfcConfig, pb, expectedRunMarker)]
        if (activityRow != null) { activityRow.capability_note = capabilityNote }
        if (capabilityNote) {
            if (!testOutput.contains('PLAY RECAP')) {
                echo "${pb} [${ndfcConfig.fabric_name}]: N9K-C9300v virtual peer-link / vPC Fabric Peering is unsupported. ${capabilityNote}"
                def capabilityLabel = ((testType == 'smoke') ? "${pb} (smoke)" : pb) + (ndfcConfig.round_tag ?: '')
                TEST_RESULT_SUMMARY_BUF += "\nERR|${capabilityLabel}|${reportingFabric}|${ndfcConfig.version}|-|-|-|-|${capabilityNote}|${reportingScope}"
                setFailureFlag(failureFlagName, true)
                error("Test stage failed: unsupported virtual peer-link capability (no PLAY RECAP)")
            }
        }

        // The shell records a nonzero ansible-playbook exit after tee completes.
        // Parse it independently of PLAY RECAP so unreachable/parser failures
        // cannot be mistaken for success merely because failed=0.
        def ansibleExitStatus = 0
        def exitStatusMarker = '[ANSIBLE_EXIT_STATUS:'
        if (testOutput.contains(exitStatusMarker)) {
            def outputLines = testOutput.split('\n')
            for (int i = 0; i < outputLines.size(); i++) {
                def line = outputLines[i]
                def markerIdx = line.indexOf(exitStatusMarker)
                if (markerIdx >= 0) {
                    def afterMarker = line.substring(markerIdx + exitStatusMarker.length())
                    def endIdx = afterMarker.indexOf(']')
                    if (endIdx > 0) {
                        def statusValue = afterMarker.substring(0, endIdx).trim().replaceAll('[^0-9]', '')
                        if (statusValue.length() > 0) {
                            def parsedStatus = statusValue as Integer
                            if (parsedStatus > ansibleExitStatus) {
                                ansibleExitStatus = parsedStatus
                            }
                        }
                    }
                }
            }
            echo "📍 Recorded ansible-playbook exit status: ${ansibleExitStatus}"
        }

        // Extract duration from test output
        def durationSeconds = 0
        def durationStr = "N/A"
        if (testOutput.contains('[DURATION_SECONDS:')) {
            def durationIdx = testOutput.indexOf('[DURATION_SECONDS:')
            if (durationIdx >= 0) {
                def afterDuration = testOutput.substring(durationIdx + 19) // "[DURATION_SECONDS: ".length() = 19
                def endIdx = afterDuration.indexOf(']')
                if (endIdx > 0) {
                    def durationValue = afterDuration.substring(0, endIdx).trim()
                    try {
                        durationSeconds = durationValue as Integer
                        def minutes = durationSeconds / 60
                        def seconds = durationSeconds % 60
                        durationStr = String.format("%dm %ds", minutes as Integer, seconds as Integer)
                        echo "⏱️ Test duration: ${durationStr} (${durationSeconds}s)"
                    } catch (Exception e) {
                        echo "⚠️ Could not parse duration: ${durationValue}"
                        durationStr = "N/A"
                    }
                }
            }
        }

        def activityKey = activityResultKey(ndfcConfig, pb, expectedRunMarker)
        if (MODULE_ACTIVITY_RESULTS.containsKey(activityKey)) {
            MODULE_ACTIVITY_RESULTS[activityKey].duration = durationStr
        }

        // Pattern 1: Check for Ansible PLAY RECAP failures using simple string operations
        // Example: "leaf1 : ok=5 changed=3 unreachable=0 failed=2 skipped=1"
        def failedCount = 0
        def okCount = 0
        def skippedCount = 0
        def hasRecap = testOutput.contains('PLAY RECAP')
        
        if (hasRecap) {
            echo "✅ Found PLAY RECAP in output"
            // Use simple string matching instead of regex to avoid CPS issues
            def lines = testOutput.split('\n')
            for (int i = 0; i < lines.size(); i++) {
                def line = lines[i]
                // Look for "failed=" pattern
                if (line.contains('failed=')) {
                    // Extract the number after "failed="
                    def failedIdx = line.indexOf('failed=')
                    if (failedIdx >= 0) {
                        def afterFailed = line.substring(failedIdx + 7) // "failed=".length() = 7
                        // Find the next space or end of string
                        def endIdx = afterFailed.indexOf(' ')
                        def failedStr = (endIdx > 0) ? afterFailed.substring(0, endIdx) : afterFailed
                        // Remove any non-digit characters
                        failedStr = failedStr.replaceAll('[^0-9]', '')
                        if (failedStr.length() > 0) {
                            def failed = failedStr as Integer
                            failedCount += failed
                            echo " Found failed=${failed} in line: ${line.trim()}"
                        }
                    }
                }
                // Look for "ok=" pattern
                if (line.contains('ok=')) {
                    // Extract the number after "ok="
                    def okIdx = line.indexOf('ok=')
                    if (okIdx >= 0) {
                        def afterOk = line.substring(okIdx + 3) // "ok=".length() = 3
                        // Find the next space or end of string
                        def endIdx = afterOk.indexOf(' ')
                        def okStr = (endIdx > 0) ? afterOk.substring(0, endIdx) : afterOk
                        // Remove any non-digit characters
                        okStr = okStr.replaceAll('[^0-9]', '')
                        if (okStr.length() > 0) {
                            def ok = okStr as Integer
                            okCount += ok
                            echo " Found ok=${ok} in line: ${line.trim()}"
                        }
                    }
                }
                // Look for "skipped=" pattern
                if (line.contains('skipped=')) {
                    def skipIdx = line.indexOf('skipped=')
                    if (skipIdx >= 0) {
                        def afterSkip = line.substring(skipIdx + 8) // "skipped=".length() = 8
                        def endIdx = afterSkip.indexOf(' ')
                        def skipStr = (endIdx > 0) ? afterSkip.substring(0, endIdx) : afterSkip
                        skipStr = skipStr.replaceAll('[^0-9]', '')
                        if (skipStr.length() > 0) {
                            def skipped = skipStr as Integer
                            skippedCount += skipped
                            echo " Found skipped=${skipped} in line: ${line.trim()}"
                        }
                    }
                }
            }

            if (failedCount == 0 && ansibleExitStatus == 0) {
                capabilityNote = ''
            }
            if (capabilityNote) {
                echo "${pb} [${ndfcConfig.fabric_name}]: N9K-C9300v virtual peer-link / vPC Fabric Peering is unsupported. ${capabilityNote}"
            }

            // A module whose declared lab substrate (port/link/vPC) is unavailable ends cleanly after the
            // planner emits NDP_MODULE_SKIPPED. Report it as SKIP with the reason rather than a misleading OK.
            def moduleSkipped = false
            def skipNote = ''
            def skipMarkerIdx = testOutput.indexOf('NDP_MODULE_SKIPPED')
            if (skipMarkerIdx >= 0 && failedCount == 0 && ansibleExitStatus == 0) {
                moduleSkipped = true
                def skipTail = testOutput.substring(skipMarkerIdx, Math.min(testOutput.length(), skipMarkerIdx + 420))
                skipTail = skipTail.replace('\r', ' ').replace('\n', ' ').replaceAll('\\s+', ' ')
                def cutAt = skipTail.length()
                ['\'', ' Read `', ' TASK [', ' PLAY ['].each { token ->
                    def tokenIdx = skipTail.indexOf(token, 20)
                    if (tokenIdx > 0 && tokenIdx < cutAt) {
                        cutAt = tokenIdx
                    }
                }
                skipNote = skipTail.substring(0, cutAt).replace('|', '/').trim()
                if (skipNote.length() > 200) {
                    skipNote = skipNote.substring(0, 200)
                }
            }

            // Every run gates the build and is counted in both totals (smoke included).
            totalFailedCount += failedCount
            def currentTotalFailed = env.TOTAL_FAILED_COUNT as Integer
            env.TOTAL_FAILED_COUNT = (currentTotalFailed + failedCount).toString()
            def currentTotalPassed = env.TOTAL_PASSED_COUNT as Integer
            env.TOTAL_PASSED_COUNT = (currentTotalPassed + (moduleSkipped ? 0 : okCount)).toString()

            echo "📊 Diagnostic Ansible failed-task count: ${failedCount} | Duration: ${durationStr} | Playbook: ${pb} | Fabric: ${reportingFabric} (${reportingScope})"

            // Per-module result ROW (pipe-delimited; rendered as an aligned table by
            // formatResultsTable). All runs are shown; smoke playbooks are tagged "(smoke)" and, when the
            // suite runs more than once, every row carries its fabric round, e.g. "(eBGP)".
            // Fields: status|playbook|fabric|nd|passed|failed|skipped|duration|note
            def pbLabel = ((testType == 'smoke') ? "${pb} (smoke)" : pb) + (ndfcConfig.round_tag ?: '')
            def rowStatus = moduleSkipped ? 'SKIP' : ((failedCount > 0 || ansibleExitStatus > 0) ? 'FAIL' : 'OK')
            if (moduleSkipped) {
                echo "Module ${pb} skipped because its declared lab substrate is unavailable: ${skipNote}"
                if (activityRow != null) { activityRow.skip_reason = skipNote }
                TEST_RESULT_SUMMARY_BUF += "\n${rowStatus}|${pbLabel}|${reportingFabric}|${ndfcConfig.version}|-|-|-|${durationStr}|${skipNote}|${reportingScope}"
            } else {
                TEST_RESULT_SUMMARY_BUF += "\n${rowStatus}|${pbLabel}|${reportingFabric}|${ndfcConfig.version}|${okCount}|${failedCount}|${skippedCount}|${durationStr}|${capabilityNote}|${reportingScope}"
            }
        }
        
        // Check for failures
        if (ansibleExitStatus > 0) {
            setFailureFlag(failureFlagName, true)
            echo "❌ ${ndfcConfig.fabric_name} Ansible execution exited with status ${ansibleExitStatus}"
            error("Test stage failed: Ansible exited with status ${ansibleExitStatus}")
        } else if (hasRecap && failedCount > 0) {
            setFailureFlag(failureFlagName, true)
            //env.BUILD_FAILURE_REASON += "❌ ${ndfcConfig.fabric_name} tests failed on ND ${ndfcConfig.version}: ${failedCount} tasks failed (Playbook: ${pb})"
            echo "❌ ${ndfcConfig.fabric_name} test parsing: ${failedCount} tasks failed"
            error("Test stage failed: ${failedCount} tasks failed")
        } else if (hasRecap) {
            echo "✅ ${ndfcConfig.fabric_name} test parsing completed - All tasks passed (0 failed)"
        } else {
            // Pattern 2: Fallback - check for generic test pattern using string operations
            echo "⚠️ No PLAY RECAP found, checking for generic test pattern"
            if (testOutput.contains(' tests, ') && testOutput.contains(' failed, ')) {
                // Try to extract test counts using string operations
                def lines = testOutput.split('\n')
                for (int i = 0; i < lines.size(); i++) {
                    def line = lines[i]
                    if (line.contains(' tests, ') && line.contains(' passed, ') && line.contains(' failed, ')) {
                        echo "Found test summary line: ${line}"
                        // Simple parsing without regex
                        def parts = line.split(',')
                        def failedTests = 0
                        for (int j = 0; j < parts.size(); j++) {
                            if (parts[j].contains(' failed')) {
                                def failedPart = parts[j].trim().split(' ')[0]
                                failedTests = failedPart as Integer
                                break
                            }
                        }
                        
                        if (failedTests > 0) {
                            setFailureFlag(failureFlagName, true)
                            if (BUILD_FAILURE_REASON_BUF) {
                                BUILD_FAILURE_REASON_BUF += "\n"
                            }
                            BUILD_FAILURE_REASON_BUF += "❌ ${ndfcConfig.fabric_name} tests failed on ND ${ndfcConfig.version}: ${failedTests} tests failed (Playbook: ${pb})"
                            echo "❌ ${ndfcConfig.fabric_name} test parsing: ${failedTests} tests failed"
                            error("Test stage failed: ${failedTests} tests failed")
                        } else {
                            echo "✅ ${ndfcConfig.fabric_name} test parsing completed - 0 tests failed"
                        }
                        break
                    }
                }
            } else {
                echo "⚠️ Could not parse test results for ${ndfcConfig.fabric_name} - no standard pattern found"
                echo "📄 Output preview: ${testOutput.substring(0, Math.min(300, testOutput.length()))}"
                // No PLAY RECAP and no generic pattern -> the target errored before
                // any task ran (e.g. a playbook-style target run via include_role, or
                // a parse error). Surface it instead of silently dropping the module.
                def pbLabelErr = ((testType == 'smoke') ? "${pb} (smoke)" : pb) + (ndfcConfig.round_tag ?: '')
                TEST_RESULT_SUMMARY_BUF += "\nERR|${pbLabelErr}|${reportingFabric}|${ndfcConfig.version}|-|-|-|-|did not run (no PLAY RECAP -- see console)|${reportingScope}"
                setFailureFlag(failureFlagName, true)
            }
        }
        
    } catch (FileNotFoundException e) {
        echo "⚠️ Test output file not found: ${testOutputFileName}"
        setFailureFlag(failureFlagName, true)
        // Keep the DETAILED table consistent: show this module as an ERROR row
        // (same shape as the pass/fail rows) instead of leaving the section empty.
        TEST_RESULT_SUMMARY_BUF += "\nERR|${pb}${ndfcConfig.round_tag ?: ''}|${reportingFabric}|${ndfcConfig.version}|-|-|-|-|no test output (see console)|${reportingScope}"
        if (BUILD_FAILURE_REASON_BUF) {
            BUILD_FAILURE_REASON_BUF += "\n"
        }
        BUILD_FAILURE_REASON_BUF += "❌ ${ndfcConfig.fabric_name} test output file not found on ND ${ndfcConfig.version} (Playbook: ${pb})"
        error("Test output file not found: ${testOutputFileName}")
    } catch (Exception e) {
        def failureMessage = e.getMessage() ?: e.getClass().getName()
        if (failureMessage.contains("Test stage failed")) {
            // Re-throw test errors
            throw e
        } else {
            // Handle file reading or parsing errors
            echo "⚠️ Error parsing test results for ${ndfcConfig.fabric_name}: ${failureMessage}"
            setFailureFlag(failureFlagName, true)
            // Keep the DETAILED table consistent: show this module as an ERROR row
            // (same shape as the pass/fail rows) instead of leaving the section empty.
            TEST_RESULT_SUMMARY_BUF += "\nERR|${pb}${ndfcConfig.round_tag ?: ''}|${reportingFabric}|${ndfcConfig.version}|-|-|-|-|could not parse test output (see console)|${reportingScope}"
            if (BUILD_FAILURE_REASON_BUF) {
                BUILD_FAILURE_REASON_BUF += "\n"
            }
            BUILD_FAILURE_REASON_BUF += "❌ ${ndfcConfig.fabric_name} ${pb} on ND ${ndfcConfig.version}: test output missing/unreadable"
            error("${ndfcConfig.fabric_name} test result parsing failed: ${failureMessage}")
        }
    }
}

/**
 * Builds the configuration of one fabric round of one ND version from that version's base entry. The base entry
 * describes the canonical (first round) fabric; every switch that belongs to it (the six VXLAN switches) is assigned
 * to the round's fabric instead, while the external switches never move. The first round keeps the base version id,
 * so its output files, dynamic inventory and failure flag are exactly what they were before rounds existed.
 */
def buildRoundConfig(baseConfig, fabricRound) {
    def homeRound = FABRIC_ROUNDS[0]
    if (baseConfig.fabric_name != homeRound.fabric) {
        error("The base fabric ${baseConfig.fabric_name} must be the first round's fabric ${homeRound.fabric}")
    }
    // These values end up in shell command lines and file names, so refuse anything that is not a plain token.
    [fabricRound.fabric, fabricRound.type, fabricRound.vpcType, fabricRound.label, fabricRound.idSuffix].each { value ->
        if (value && !(value.toString() ==~ /^[A-Za-z0-9_.-]+$/)) {
            error("Unsafe fabric round value: ${value}")
        }
    }
    def roundConfig = [:]
    roundConfig.putAll(baseConfig)
    roundConfig.versionId = "${baseConfig.versionId}${fabricRound.idSuffix}".toString()
    roundConfig.fabric_name = fabricRound.fabric
    roundConfig.switches = baseConfig.switches.collect { sw ->
        [name: sw.name, ip: sw.ip, serial: sw.serial,
         fabric: (sw.fabric == baseConfig.fabric_name) ? fabricRound.fabric : sw.fabric,
         role: sw.role]
    }
    roundConfig.vpc_pair_fabric_type = fabricRound.vpcType
    roundConfig.primary_fabric_type = fabricRound.type
    roundConfig.round_label = fabricRound.label
    roundConfig.round_tag = (FABRIC_ROUNDS.size() > 1) ? " (${fabricRound.label})".toString() : ''
    // Only a round that leaves the canonical fabric needs the Consul lab files re-targeted.
    roundConfig.round_render = (fabricRound.fabric != homeRound.fabric)
    // Every fabric a VXLAN switch may be moved out of when it is re-homed into this round's fabric.
    roundConfig.rehome_fabrics = FABRIC_ROUNDS.collect { it.fabric }.unique()
    return roundConfig
}

/**
 * Re-targets the freshly installed Consul lab files (profile registry, validator, runner, reset playbook, switch
 * roster, ...) for a round whose primary fabric is not the canonical one. The validator's render-round command checks
 * the whole rendered set against the rendered validator before it replaces a single file, and keeps the untouched
 * canonical roster as integration_config.home.yml for the return to the home fabric. A failure leaves the canonical
 * files in place and fails the round.
 */
def applyFabricRound(ndfcConfig) {
    if (!ndfcConfig.round_render) {
        return
    }
    stage("NDFC ${ndfcConfig.version}${ndfcConfig.round_tag ?: ''} - Prepare ${ndfcConfig.round_label} fabric round") {
        echo "⏱ Preparing the ${ndfcConfig.round_label} round on ${ndfcConfig.fabric_name} (type ${ndfcConfig.primary_fabric_type}) at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
        withEnv(["ROUND_FABRIC=${ndfcConfig.fabric_name}",
                 "ROUND_FABRIC_TYPE=${ndfcConfig.primary_fabric_type}",
                 "ROUND_ND_HOST=${env.ANSIBLE_HOST}"]) {
            // Read-only check first, before any file is touched or any switch is moved: the round fabric must exist and
            // report the type this round is built for. The registry, the validator and nd_manage_switches all depend on
            // it (nd_manage_switches cannot onboard switches into, for example, an ND 'routed' fabric).
            def reportedType = sh(returnStdout: true, script: '''#!/bin/bash
                set -euo pipefail
                source $HOME/ansible/venv/bin/activate
                python - <<'PY'
import json
import os
import ssl
import urllib.request

host = os.environ["ROUND_ND_HOST"]
fabric = os.environ["ROUND_FABRIC"]
context = ssl._create_unverified_context()


def call(path, body=None, token=None):
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request("https://%s%s" % (host, path), data=data, method="POST" if body is not None else "GET")
    request.add_header("Content-Type", "application/json")
    if token:
        request.add_header("Authorization", "Bearer " + token)
    with urllib.request.urlopen(request, context=context, timeout=60) as response:
        return json.loads(response.read().decode())


try:
    login = {"userName": os.environ["NDFC_USER"], "userPasswd": os.environ["NDFC_PASSWORD"], "domain": "local"}
    token = call("/login", login)["jwttoken"]
    body = call("/api/v1/manage/fabrics/" + fabric, token=token)
    print((body.get("current", body).get("management") or {}).get("type", ""))
except Exception as exc:
    print("UNREADABLE: %s" % exc)
PY
            ''').trim()
            if (reportedType.startsWith('UNREADABLE')) {
                error("Cannot read ${ndfcConfig.fabric_name} from ND to verify its type (${reportedType})")
            }
            // The module supports vxlanEbgp; a generic routed fabric is not
            // sufficient evidence that this destination accepts VXLAN switches.
            if (reportedType.toLowerCase() != ndfcConfig.primary_fabric_type.toLowerCase()) {
                error("${ndfcConfig.fabric_name} reports '${reportedType}', expected '${ndfcConfig.primary_fabric_type}'; no switches were moved")
            }
            echo "NDP_FABRIC_DESTINATION_VALIDATED: ${ndfcConfig.fabric_name} (${reportedType})"
            sh '''#!/bin/bash
                set -euo pipefail
                cd ${COLLECTIONS_DIRECTORY}
                source $HOME/ansible/venv/bin/activate
                if ! grep -q 'render-round' validate_nd_prerequisites.py; then
                    echo "❌ The Consul validate_nd_prerequisites.py predates fabric-round support (no render-round command); publish the updated file to Consul before running more than one round" >&2
                    exit 1
                fi
                python validate_nd_prerequisites.py render-round \
                    --root "${COLLECTIONS_DIRECTORY}" \
                    --round-fabric "${ROUND_FABRIC}" \
                    --round-type "${ROUND_FABRIC_TYPE}"
            '''
        }
        env.HOME_ROSTER_COPY_READY = 'true'
    }
}

/**
 * Returns the lab to its canonical (first round) fabric after the last round: the VXLAN switches are moved back out of
 * the round fabric by the same switch sync, using the untouched roster copy the renderer saved. It runs AFTER the final
 * fabric reset (ND refuses to remove a switch that is still half of a vPC pair). A serial-less switch that cannot re-home
 * here only marks the build UNSTABLE (the next run's pre-flight re-adds it); an infra failure still stops the build.
 */
def restoreHomeFabric(ndfcVersions) {
    def firstConfig = ndfcVersions[0]
    def lastConfig = ndfcVersions[ndfcVersions.size() - 1]
    def needsRecovery = (env.ND_SWITCH_RESTORE_FAILED == 'true')
    def hasHomeCopy = (env.HOME_ROSTER_COPY_READY == 'true')
    if (lastConfig.fabric_name == firstConfig.fabric_name && !needsRecovery) {
        return
    }
    if (!hasHomeCopy && !needsRecovery) {
        echo "No round re-targeted the roster and no switch restore failed; home restore is not required"
        return
    }
    if (env.REQUIRED_FILES_READY != 'true') {
        env.ND_SWITCH_RESTORE_FAILED = 'true'
        env.PIPELINE_FAILED = 'true'
        error("NDP_SWITCH_RESTORE_FAILED: required files are unavailable for home-fabric recovery")
    }
    def homeRoster = hasHomeCopy ? "${COLLECTIONS_DIRECTORY}/integration_config.home.yml" : "${COLLECTIONS_DIRECTORY}/integration_config.yml"
    def homeConfig = [:] + lastConfig
    homeConfig.fabric_name = firstConfig.fabric_name
    homeConfig.primary_fabric_type = firstConfig.primary_fabric_type
    homeConfig.round_tag = firstConfig.round_tag
    try {
        withCredentials([usernamePassword(credentialsId: SWITCH_CREDENTIALS_ID,
                                          usernameVariable: 'ANSIBLE_NXOS_SWITCH_USERNAME',
                                          passwordVariable: 'ANSIBLE_NXOS_SWITCH_PASSWORD')]) {
            runSwitchMembershipSync(homeConfig, 'home', homeRoster)
        }
    } catch (Exception e) {
        rethrowIfInterrupt(e)
        env.ND_SWITCH_RESTORE_FAILED = 'true'
        env.PIPELINE_FAILED = 'true'
        throw e
    }
}

/**
 * Resets the network fabric between NDFC versions.
 * Runs ansible-playbook to reset specified fabrics.
 */
def resetFabricBetweenVersions(roundTag = '') {
    stage("Reset Fabric Between NDFC Versions${roundTag}") {
        // echo timestamp when stage starts
        echo "⏱ Stage 'Reset Fabric Between NDFC Versions${roundTag}' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
        try {
            // Use dynamic inventory if available, otherwise fallback to default inventory in collections dir
            def currentInventory = env.CURRENT_NDFC_INVENTORY ?: "${COLLECTIONS_DIRECTORY}/inventory.yaml"
            def resetFabricYaml = """${COLLECTIONS_DIRECTORY}/reset_fabric.yaml"""

            echo "📍 Using inventory for reset: ${currentInventory}"
            echo "📍 Using reset fabric yaml: ${resetFabricYaml}"

            // Verify inventory file exists using reusable function
            verifyInventoryFile(currentInventory)

            // List of fabrics to reset
            ['${FABRIC_NAME}'].each { fabric ->
                try {
                    echo "🔄 Resetting fabric: ${fabric}"
                    // IMPORTANT: cd into the collection dir and activate the venv in the
                    // SAME shell as ansible-playbook so the collection's ansible.cfg
                    // (collections_path/roles_path) is auto-loaded. A standalone
                    // `sh "cd ..."` runs in its own shell and has no effect, which made
                    // ansible run from the Jenkins workspace and fail to resolve
                    // cisco.nd.* modules (e.g. nd_manage_l3out).
                    // #!/bin/bash is required: the default /bin/sh (dash) has no
                    // `source` builtin, so this exited 127 and skipped the reset.
                    sh """#!/bin/bash
                        set -e
                        cd ${COLLECTIONS_DIRECTORY}
                        source \$HOME/ansible/venv/bin/activate
                        ansible-playbook -i ${currentInventory} ${resetFabricYaml}
                    """
                    echo "✅ Reset ${fabric} successfully"
                } catch (Exception e) {
                    echo "⚠️  Failed to reset ${fabric}: ${e.getMessage()}"
                    throw e
                }
            }

            echo "⏳ Waiting 3 minutes for fabric reset to complete..."
            //sleep(180) // Wait 3 minutes to ensure fabric reset completes
            echo "✅ Fabric reset completed, ready for next ND version"

        } catch (Exception e) {
            echo "⚠️  Fabric reset encountered issues: ${e.getMessage()}"
            throw e
        }
    }
}

def runNDFCVersionTests(ndfcConfig) {
    def roundTag = ndfcConfig.round_tag ?: ''
    stage(" NDFC ${ndfcConfig.version}${roundTag} - Run NDFCVersion Tests") {
        // echo timestamp when stage starts
        echo "⏱ Stage 'NDFC ${ndfcConfig.version}${roundTag} - Run NDFCVersion Tests' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
        env.NDFC_HOST = env.NDFC_HOST_CURRENT
        script {
            echo "📥 Downloading configuration files from Consul..."

            // Download all configuration files using helper function
            CONSUL_CONFIG_FILES.each { file ->
                downloadFromConsul(file)
            }

            sh 'mkdir -p nd_prerequisite'
            CONSUL_PREREQUISITE_FILES.each { file ->
                downloadFromConsul(file, file)
            }
            sh 'mkdir -p fixtures/nd_prerequisite'
            CONSUL_PREREQUISITE_SUPPORT_FILES.each { file ->
                downloadFromConsul(file, file)
            }

            // Download every active individual playbook and the integration runner
            // from Consul. Nothing is materialized from the embedded common code.
            def consulPlaybookFiles = (PLAYBOOK_FILES + CONSUL_RUNNER_FILES).unique()
            consulPlaybookFiles.each { pb ->
                downloadFromConsul(pb)
            }
            CONSUL_VPC_FILES.each { pb -> downloadFromConsul(pb) }

            // Switch-membership pre-flight is required for test execution. Keep the
            // readiness flag false when its Consul key is unavailable so the hard
            // pre-flight gate stops the suite before any module can run on stale or
            // partial inventory.
            env.ND_SWITCH_PREFLIGHT_READY = 'false'
            try {
                CONSUL_PREFLIGHT_FILES.each { pb -> downloadFromConsul(pb) }
                env.ND_SWITCH_PREFLIGHT_READY = 'true'
            } catch (Exception e) {
                env.CONSUL_SYNC_FAILED = 'false'
                echo "⚠️ Switch pre-flight playbook unavailable in Consul; test execution will be blocked: ${e.getMessage()}"
            }

            // Interface admin-up pre-flight is best-effort: if its Consul key is
            // missing the step is simply skipped (flag stays false), the suite is NOT
            // blocked. This decoupling is deliberate - a down interface should self-heal
            // when the playbook is present but must never gate the nightly on its own.
            env.ND_IFACE_PREFLIGHT_READY = 'false'
            try {
                CONSUL_INTERFACE_PREFLIGHT_FILES.each { pb -> downloadFromConsul(pb) }
                env.ND_IFACE_PREFLIGHT_READY = 'true'
            } catch (Exception e) {
                echo "⚠️ Interface admin-up pre-flight playbook unavailable in Consul; interface pre-flight will be skipped: ${e.getMessage()}"
            }

            // Port-channel unbundle pre-flight is best-effort too (own ND_PC_UNBUNDLE_READY
            // flag): if its Consul key is missing the step is simply skipped and the suite is
            // NOT blocked. When present it deletes any stale test port-channel50x left on the
            // shared Ethernet1/10-13 member switch by a crashed prior build and Recalculate &
            // Deploy, so the read-only verify_free_interfaces gate does not SKIP the
            // port-channel modules on an orphaned member.
            env.ND_PC_UNBUNDLE_READY = 'false'
            try {
                CONSUL_PC_UNBUNDLE_FILES.each { pb -> downloadFromConsul(pb) }
                env.ND_PC_UNBUNDLE_READY = 'true'
            } catch (Exception e) {
                echo "⚠️ Port-channel unbundle pre-flight playbook unavailable in Consul; unbundle pre-flight will be skipped: ${e.getMessage()}"
            }

            // Legacy common-code fallback intentionally disabled. Keep this line
            // commented so Consul remains the only active playbook source.
            // materializeEmbeddedTests()

            echo "✅ Config, individual playbooks, and integration runner downloaded from Consul"
        }
    }

    // Install version-specific dependencies
    stage("NDFC ${ndfcConfig.version}${roundTag} - Install version-specific Dependencies") {
        // echo timestamp when stage starts
        echo "⏱ Stage 'NDFC ${ndfcConfig.version}${roundTag} - Install version-specific Dependencies' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
        // Install every Consul-sourced playbook into the collection. The list is
        // derived from the active playbooks plus the required integration runner.
        def preflightInstallFiles = (env.ND_SWITCH_PREFLIGHT_READY == 'true') ? CONSUL_PREFLIGHT_FILES : []
        def interfacePreflightInstallFiles = (env.ND_IFACE_PREFLIGHT_READY == 'true') ? CONSUL_INTERFACE_PREFLIGHT_FILES : []
        def pcUnbundleInstallFiles = (env.ND_PC_UNBUNDLE_READY == 'true') ? CONSUL_PC_UNBUNDLE_FILES : []
        def moveFiles = (PLAYBOOK_FILES + CONSUL_RUNNER_FILES + CONSUL_VPC_FILES + CONSUL_PREREQUISITE_FILES + CONSUL_PREREQUISITE_SUPPORT_FILES + preflightInstallFiles + interfacePreflightInstallFiles + pcUnbundleInstallFiles).unique().join(' ')
        withEnv(["MOVE_FILES=${moveFiles}"]) {
            sh '''#!/bin/bash
                set -euo pipefail

                install_required_file() {
                    required_file=$1
                    destination="${COLLECTIONS_DIRECTORY}/${required_file}"
                    [ -f "${required_file}" ] && [ ! -L "${required_file}" ] || {
                        echo "❌ Required freshly downloaded file is missing or unsafe: ${required_file}" >&2
                        exit 1
                    }
                    [ -s "${required_file}" ] || {
                        echo "❌ Required freshly downloaded file is empty: ${required_file}" >&2
                        exit 1
                    }
                    mkdir -p "$(dirname "${destination}")"
                    [ ! -d "${destination}" ] || {
                        echo "❌ Required file destination is unexpectedly a directory: ${destination}" >&2
                        exit 1
                    }
                    mv -- "${required_file}" "${destination}"
                    [ -f "${destination}" ] || {
                        echo "❌ Required file was not installed: ${destination}" >&2
                        exit 1
                    }
                }

                install_required_file requirements.txt
                install_required_file requirements.yaml
                install_required_file integration_config.yml
                install_required_file inventory.yaml
                install_required_file ansible.cfg
                install_required_file reset_fabric.yaml

                # Install every required Consul-sourced playbook.
                for p in ${MOVE_FILES}; do
                    install_required_file "$p"
                done
                cd ${COLLECTIONS_DIRECTORY}
            '''
        }
        env.REQUIRED_FILES_READY = 'true'
        // Use inventory.yaml and requirements.yaml files from Jenkins workspace
        ndfcConfig.requirementsFile = "${COLLECTIONS_DIRECTORY}/requirements.txt"  // Adjust if Jenkins uses a different filename
        ndfcConfig.requirementsYamlFile = "${COLLECTIONS_DIRECTORY}/requirements.yaml"  // Use Jenkins-provided requirements.yaml

        echo "pwd: ${pwd}"
        echo "ls -l: ${sh(script: 'ls -l', returnStdout: true)}"
        echo "ls -l ${COLLECTIONS_DIRECTORY}: ${sh(script: 'ls -l ${COLLECTIONS_DIRECTORY}', returnStdout: true)}"

        // echo "📦 Installing dependencies for NDFC ${ndfcConfig.version}"
        // echo "Using requirements file: ${ndfcConfig.requirementsFile}"
        // echo "Using requirements yaml file: ${ndfcConfig.requirementsYamlFile}"
        // echo "${sh(script: 'ansible-galaxy collection list', returnStdout: true)}"

        // The requested branch was validated and installed in the Clone Repository stage.
    }

    // A round on a fabric other than the canonical one runs on re-targeted copies of the lab files just installed.
    applyFabricRound(ndfcConfig)

    echo "⏱ Stage 'NDFC ${ndfcConfig.version}${roundTag} - Fabric Tests' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
    // The Consul runner and nd_ensure_switches.yaml read these exact environment
    // variables. Bind them around the complete lifecycle so switch onboarding and
    // the included nd_manage_switches test receive the masked device credential.
    withCredentials([usernamePassword(credentialsId: SWITCH_CREDENTIALS_ID,
                                      usernameVariable: 'ANSIBLE_NXOS_SWITCH_USERNAME',
                                      passwordVariable: 'ANSIBLE_NXOS_SWITCH_PASSWORD')]) {
        // Fail before onboarding or destructive integration setup if the Jenkins
        // credential is present but either field is blank. Never print credential
        // contents; the Jenkins credential binding masks them in Ansible subprocesses.
        sh '''#!/bin/bash
            set -euo pipefail
            if [ -z "${ANSIBLE_NXOS_SWITCH_USERNAME:-}" ]; then
                echo "❌ Jenkins credential SWITCH_CREDENTIALS has an empty username; provide valid switch login credentials." >&2
                exit 1
            fi
            if [ -z "${ANSIBLE_NXOS_SWITCH_PASSWORD:-}" ]; then
                echo "❌ Jenkins credential SWITCH_CREDENTIALS has an empty password; provide valid switch login credentials." >&2
                exit 1
            fi
            echo "✅ Switch credential binding is present (values masked)."
        '''
        generateDynamicInventory(ndfcConfig)
        // Switch availability is confirmed at three points so no module ever runs on a
        // fabric that is missing a canonical switch: (1) an ENFORCED pre-flight here that
        // FAILS the build if the full 6+2 topology cannot be added/confirmed before the
        // suite starts; (2) a per-module guard inside runFabricTest that re-confirms and
        // re-adds any switch a prior destructive module removed, before EVERY module; and
        // (3) a post-suite restore in the finally below that re-adds + confirms at the end.
        try {
            runSwitchPreflight(ndfcConfig)
            runInterfacePreflight(ndfcConfig)
            runPortChannelUnbundlePreflight(ndfcConfig)
            runFabricTest(ndfcConfig)
        } finally {
            // This test deletes every switch from VXLAN_EVPN_Fabric. Restore the
            // canonical roster even if its integration lifecycle fails midway.
            runSwitchPostRestore(ndfcConfig)
        }
    }
}

/**
 * Enforced switch-membership pre-flight. Before the module suite runs it confirms
 * every canonical fabric switch is present in ND and, for any that are missing,
 * adds them (ND erases and reloads each switch first) then recalculates & deploys the fabric,
 * and finally REQUIRES the full 6+2 topology to be confirmed present. A failure
 * FAILS the build so the suite never starts on a broken topology. Audit-only (no
 * mutation) during a prerequisite-only run.
 */
def runSwitchPreflight(ndfcConfig) {
    runSwitchMembershipSync(ndfcConfig, 'pre')
}

/**
 * Best-effort interface admin-up pre-flight. After the switch-membership pre-flight
 * has confirmed the 6+2 topology, bring every allowlisted physical port that has a
 * managed policy and is administratively down back UP, so a shut fabric/uplink port
 * cannot silently degrade the fabric once the suite starts. DELIBERATELY non-fatal:
 * a missing Consul key, a stubborn port, or any playbook error is logged and the
 * suite proceeds — the switch pre-flight is the only hard topology gate. Audit-only
 * (never flips a port) during a prerequisite-only run.
 */
def runInterfacePreflight(ndfcConfig) {
    if (env.ND_IFACE_PREFLIGHT_READY != 'true') {
        echo "ℹ️ Interface admin-up pre-flight skipped for ND ${ndfcConfig.version} (nd_ensure_interfaces_up.yaml not available from Consul); suite continues."
        return
    }
    def roundTag = ndfcConfig.round_tag ?: ''
    def stageName = "Interface Pre-flight on NDFC ${ndfcConfig.version}${roundTag}"
    // Audit only (never flip a port) during a prerequisite-only run.
    def applyInterfaces = (env.ND_PREREQUISITE_ONLY_EFFECTIVE != 'true')
    stage(stageName) {
        echo "⏱ Stage '${stageName}' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
        def inventoryFile = env.CURRENT_NDFC_INVENTORY ?: "${COLLECTIONS_DIRECTORY}/inventory.yaml"
        try {
            withEnv(["IFACE_INVENTORY=${inventoryFile}",
                     "IFACE_APPLY=${applyInterfaces}",
                     "IFACE_TIMEOUT=${env.ND_IFACE_PREFLIGHT_TIMEOUT ?: '900'}"]) {
                sh '''#!/bin/bash
                    set -e
                    cd ${COLLECTIONS_DIRECTORY}
                    source $HOME/ansible/venv/bin/activate
                    PLAYBOOK="${COLLECTIONS_DIRECTORY}/nd_ensure_interfaces_up.yaml"
                    if [ ! -f "${IFACE_INVENTORY}" ] || [ -L "${IFACE_INVENTORY}" ] || [ ! -s "${IFACE_INVENTORY}" ]; then
                        echo "❌ Interface pre-flight inventory not found or unsafe: ${IFACE_INVENTORY}" >&2
                        exit 1
                    fi
                    if [ ! -f "${PLAYBOOK}" ] || [ -L "${PLAYBOOK}" ] || [ ! -s "${PLAYBOOK}" ]; then
                        echo "❌ Interface pre-flight playbook missing or unsafe: ${PLAYBOOK}" >&2
                        exit 1
                    fi
                    echo "🔎 Interface admin-up pre-flight (apply=${IFACE_APPLY}, timeout=${IFACE_TIMEOUT}s) against ${IFACE_INVENTORY}"
                    timeout "${IFACE_TIMEOUT}" ansible-playbook -i "${IFACE_INVENTORY}" "${PLAYBOOK}" \
                        -e "nd_iface_apply=${IFACE_APPLY}"
                '''
            }
            echo "✅ Interface admin-up pre-flight completed for ND ${ndfcConfig.version}"
        } catch (Exception e) {
            rethrowIfInterrupt(e)
            // Best-effort by design: a down/stubborn port or any error here never fails the build.
            echo "⚠️ Interface admin-up pre-flight did not complete for ND ${ndfcConfig.version} (non-fatal; suite continues). Cause: ${e.getMessage()}"
        }
    }
}

/**
 * Best-effort remediating port-channel unbundle pre-flight. The three
 * nd_interface_port_channel_* targets share member pool Ethernet1/10-13 on
 * vxlan_leaf_1 and each creates port-channel501/502/503; a build that crashes mid-test
 * can leave one of those port-channels behind still holding a member. The read-only
 * verify_free_interfaces prerequisite gate then SKIPs the port-channel modules on the
 * orphaned member and never clears it. Delete any leftover test port-channel50x and
 * Recalculate & Deploy BEFORE runFabricTest runs the gate, so the shared members are
 * free. DELIBERATELY non-fatal: a missing Consul key, a stuck port-channel or any
 * playbook error is logged and the suite proceeds. Audit-only (deletes nothing) during
 * a prerequisite-only run.
 */
def runPortChannelUnbundlePreflight(ndfcConfig) {
    if (env.ND_PC_UNBUNDLE_READY != 'true') {
        echo "ℹ️ Port-channel unbundle pre-flight skipped for ND ${ndfcConfig.version} (nd_ensure_pc_members_free.yaml not available from Consul); suite continues."
        return
    }
    def roundTag = ndfcConfig.round_tag ?: ''
    def stageName = "Port-channel Unbundle Pre-flight on NDFC ${ndfcConfig.version}${roundTag}"
    // ENFORCE (delete + Recalculate & Deploy) in a normal run; audit only (delete
    // nothing) during a prerequisite-only run.
    def applyUnbundle = (env.ND_PREREQUISITE_ONLY_EFFECTIVE != 'true')
    stage(stageName) {
        echo "⏱ Stage '${stageName}' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
        def inventoryFile = env.CURRENT_NDFC_INVENTORY ?: "${COLLECTIONS_DIRECTORY}/inventory.yaml"
        try {
            withEnv(["PC_INVENTORY=${inventoryFile}",
                     "PC_APPLY=${applyUnbundle}",
                     "PC_FABRIC=${ndfcConfig.fabric_name}",
                     "PC_SWITCH_IP=${env.ND_PC_UNBUNDLE_SWITCH_IP ?: '192.0.2.195'}",
                     "PC_TIMEOUT=${env.ND_PC_UNBUNDLE_TIMEOUT ?: '900'}"]) {
                sh '''#!/bin/bash
                    set -e
                    cd ${COLLECTIONS_DIRECTORY}
                    source $HOME/ansible/venv/bin/activate
                    PLAYBOOK="${COLLECTIONS_DIRECTORY}/nd_ensure_pc_members_free.yaml"
                    if [ ! -f "${PC_INVENTORY}" ] || [ -L "${PC_INVENTORY}" ] || [ ! -s "${PC_INVENTORY}" ]; then
                        echo "❌ Port-channel unbundle pre-flight inventory not found or unsafe: ${PC_INVENTORY}" >&2
                        exit 1
                    fi
                    if [ ! -f "${PLAYBOOK}" ] || [ -L "${PLAYBOOK}" ] || [ ! -s "${PLAYBOOK}" ]; then
                        echo "❌ Port-channel unbundle pre-flight playbook missing or unsafe: ${PLAYBOOK}" >&2
                        exit 1
                    fi
                    echo "🔎 Port-channel unbundle pre-flight (apply=${PC_APPLY}, timeout=${PC_TIMEOUT}s) on ${PC_FABRIC}/${PC_SWITCH_IP} against ${PC_INVENTORY}"
                    timeout "${PC_TIMEOUT}" ansible-playbook -i "${PC_INVENTORY}" "${PLAYBOOK}" \\
                        -e "nd_pc_unbundle_apply=${PC_APPLY}" \\
                        -e "nd_pc_fabric_name=${PC_FABRIC}" \\
                        -e "nd_pc_switch_ip=${PC_SWITCH_IP}"
                '''
            }
            echo "✅ Port-channel unbundle pre-flight completed for ND ${ndfcConfig.version}"
        } catch (Exception e) {
            rethrowIfInterrupt(e)
            // Best-effort by design: a stuck port-channel or any error here never fails the build.
            echo "⚠️ Port-channel unbundle pre-flight did not complete for ND ${ndfcConfig.version} (non-fatal; suite continues). Cause: ${e.getMessage()}"
        }
    }
}

/**
 * Post-suite switch-membership restore. The nd_manage_switches integration
 * target is destructive against the real VXLAN_EVPN_Fabric — its base "Clean Up
 * Existing Devices" deletes every switch and the overridden/deleted test cases
 * remove the rest — and it ships no cleanup.yaml, so the suite leaves the fabric
 * emptied (most visibly 192.0.2.196 / vxlan_leaf_2). Re-run the same
 * self-healing onboard AFTER the suite so the canonical switches are restored at
 * the end of the run instead of staying missing until the next night's
 * pre-flight. An incomplete restore marks the build UNSTABLE and skips later rounds.
 */
def runSwitchPostRestore(ndfcConfig) {
    runSwitchMembershipSync(ndfcConfig, 'post')
}

/**
 * Shared switch-membership sync used by the pre-flight, the post-suite restore and the
 * final return to the home fabric. phase 'pre' is an ENFORCED gate: it adds every missing canonical
 * switch, recalculates & deploys its fabric, then requires the full 6+2 topology
 * to be confirmed present — a failure here FAILS the build so the suite never
 * starts on a broken topology. phase 'post' restores switches a destructive module
 * removed; an incomplete restore is UNSTABLE and blocks later rounds. The pre-flight always
 * onboards + recalculates & deploys (prerequisites are always applied).
 * Every phase passes the round's fabrics to the playbook as nd_switch_rehome_fabrics_csv, so a
 * roster switch that still sits in the other VXLAN fabric is moved out of it first. phase 'home'
 * is the enforced return to the first round's fabric after the last round; it syncs against
 * rosterFile (the untouched canonical roster the renderer kept) instead of the installed roster.
 */
def runSwitchMembershipSync(ndfcConfig, phase, rosterFile = '') {
    def isPost = (phase != 'pre')
    def label = (phase == 'home') ? 'home-fabric restore' : (isPost ? 'restore' : 'pre-flight')
    if (env.ND_SWITCH_PREFLIGHT_READY != 'true') {
        // A missing membership guard must not be treated as a successful
        // pre-flight. Without it, a stale Consul runner can send an external
        // switch serial to a primary-fabric module and later modules can run
        // against an emptied/partial fabric.
        if (isPost) {
            env.ND_SWITCH_RESTORE_FAILED = 'true'
        }
        env.PIPELINE_FAILED = 'true'
        error("Switch membership ${label} cannot run: nd_ensure_switches.yaml is not available from Consul")
    }
    def roundTag = ndfcConfig.round_tag ?: ''
    def stageName = (phase == 'home') ? "Switch Home Restore on NDFC ${ndfcConfig.version}${roundTag}" : (isPost ? "Switch Restore on NDFC ${ndfcConfig.version}${roundTag}" : "Switch Pre-flight on NDFC ${ndfcConfig.version}${roundTag}")
    def rosterPath = rosterFile ? rosterFile : "${COLLECTIONS_DIRECTORY}/integration_config.yml"
    def rehomeFabrics = (ndfcConfig.rehome_fabrics ?: []).join(',')
    // Post keeps margin above the nominal boot/retry budget; home has no downstream round.
    def syncTimeout = (phase == 'home') ? (env.ND_SWITCH_HOME_SYNC_TIMEOUT ?: '1500') :
        ((phase == 'post') ? (env.ND_SWITCH_POST_SYNC_TIMEOUT ?: '2100') : (env.ND_SWITCH_SYNC_TIMEOUT ?: '3600'))
    stage(stageName) {
        echo "⏱ Stage '${stageName}' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
        def inventoryFile = env.CURRENT_NDFC_INVENTORY ?: "${COLLECTIONS_DIRECTORY}/inventory.yaml"
        // Both phases onboard: pre-flight now ENFORCES add + recalculate & deploy +
        // confirm the full 6+2 topology, and post restores what a destructive module
        // removed. Only a prerequisite-only audit stays read-only.
        def autoOnboard = (env.ND_PREREQUISITE_ONLY_EFFECTIVE != 'true')
        try {
            withEnv(["PREFLIGHT_INVENTORY=${inventoryFile}",
                         "PREFLIGHT_ROSTER=${rosterPath}",
                         "PREFLIGHT_REHOME_FABRICS=${rehomeFabrics}",
                         "PREFLIGHT_APPLY=${autoOnboard}",
                         "PREFLIGHT_FAIL_ON_MISSING=false",
                        "PREFLIGHT_REDISCOVER_ENABLED=${env.ND_SWITCH_REDISCOVER_ENABLED ?: (isPost ? 'false' : 'true')}",
                        "PREFLIGHT_ONBOARD_INITIAL_WAIT=${env.ND_SWITCH_ONBOARD_INITIAL_WAIT ?: (isPost ? '0' : '480')}",
                         "PREFLIGHT_TIMEOUT=${syncTimeout}"]) {
                    sh '''#!/bin/bash
                    set -e
                    cd ${COLLECTIONS_DIRECTORY}
                    source $HOME/ansible/venv/bin/activate
                    PLAYBOOK="${COLLECTIONS_DIRECTORY}/nd_ensure_switches.yaml"
                    if [ ! -f "${PREFLIGHT_INVENTORY}" ] || [ -L "${PREFLIGHT_INVENTORY}" ] || [ ! -s "${PREFLIGHT_INVENTORY}" ]; then
                        echo "❌ Pre-flight inventory not found or unsafe: ${PREFLIGHT_INVENTORY}" >&2
                        exit 1
                    fi
                    if [ ! -f "${PLAYBOOK}" ] || [ -L "${PLAYBOOK}" ] || [ ! -s "${PLAYBOOK}" ]; then
                        echo "❌ Pre-flight playbook missing or unsafe: ${PLAYBOOK}" >&2
                        exit 1
                    fi
                    if [ ! -f "${PREFLIGHT_ROSTER}" ] || [ -L "${PREFLIGHT_ROSTER}" ] || [ ! -s "${PREFLIGHT_ROSTER}" ]; then
                        echo "❌ Switch roster not found or unsafe: ${PREFLIGHT_ROSTER}" >&2
                        exit 1
                    fi
                    # Pure-develop run requested: NO cisco.nd patches are applied to the fresh
                    # clone. The cloned collection's plugins/ AND tests/integration/targets/ run
                    # exactly as upstream 'develop' - no cleanup-scope, no port-channel teardown,
                    # no expected_serial_number safeguard, and no git-apply step.
                    echo "🔎 Switch membership sync (apply=${PREFLIGHT_APPLY}, timeout=${PREFLIGHT_TIMEOUT}s, roster=${PREFLIGHT_ROSTER}, rehome=${PREFLIGHT_REHOME_FABRICS:-none}) against ${PREFLIGHT_INVENTORY}"
                    # Bound the onboard: a switch that will not become manageable can
                    # otherwise hang here for hours (the module's internal manageability
                    # wait is ~175 min and un-tunable). Default 3600s (60 min) lets a
                    # switch mid-reload/rediscovery converge; 1200s (20 min) was too
                    # tight and cut a recovering switch off (build #17 -> exit 124). On
                    # the pre-flight a timeout (124) or a confirm failure FAILS the build
                    # (see the catch below) so the suite never starts on a broken topology.
                    # Nominal boot/retry budget: 480s + 10 x 120s = 28 min, excluding REST work.
                    # Rehome force-delete: the iBGP -> eBGP move has to first REMOVE all six
                    # switches from VXLAN_EVPN_Fabric, and ND soft-blocks the delete of a switch
                    # that still has pending operations/anomalies ("Failed to delete the switch
                    # [<serial>/<name>]. Please check Anomalies for possible reasons." - seen on
                    # vxlan_leaf_3 / vxlan_leaf_4 in build #89). The cisco.nd module cannot pass
                    # force=true, so that removal fails hard, the switches never leave iBGP, the
                    # eBGP round gets no switches and the next round is refused. Enabling the
                    # playbook's opt-in force fallback lets it retry the stuck switches with
                    # switchActions/remove?force=true so the move completes unattended. Default
                    # on; set ND_SWITCH_REHOME_FORCE_DELETE=false to revert to the soft-block.
                    # Config-preserving restore: the nd_manage_switches suite DELETES every switch
                    # (its sanity/deleted tests end on a delete-all), so this sync is a RESTORE, not
                    # a greenfield bring-up. The playbook default (nd_switch_preserve_config=auto)
                    # re-adds a missing VXLAN switch GREENFIELD - ND wipes and RELOADS it - which is
                    # slow and is what ND tripped on in build #96 (leaf 192.0.2.195 came back with
                    # no serial during the reload, so NDP_SWITCH_RESTORE_FAILED blocked the eBGP
                    # round). preserve_config=true re-imports each switch's existing on-box config
                    # (no wipe/reload = quick re-add); the recalculate & deploy below still
                    # reconciles it to fabric intent. Set ND_SWITCH_PRESERVE_CONFIG=auto to restore
                    # the per-fabric-type greenfield behavior.
                    # Pre-delete Recalculate & Deploy: the nd_manage_tor test leaves a PENDING
                    # "Leaf-ToR unpairing" on vxlan_leaf_3 / vxlan_leaf_4 that ND will not let the
                    # iBGP -> eBGP re-home DELETE finish ("Please perform Recalculate and Deploy to
                    # complete Leaf-ToR unpairing before deleting the leaf switch from the fabric").
                    # The playbook now Recalculates (configSave) + Deploys (switchActions/deploy)
                    # the leaving switches on their source fabric BEFORE the removal so the unpair
                    # finalises on the devices and the delete is allowed. Default on; set
                    # ND_SWITCH_PREDELETE_DEPLOY=false to revert to delete-without-flush.
                    timeout "${PREFLIGHT_TIMEOUT}" ansible-playbook -i "${PREFLIGHT_INVENTORY}" "${PLAYBOOK}" \
                        -e "nd_switch_roster_file=${PREFLIGHT_ROSTER}" \
                        -e "nd_switch_rehome_fabrics_csv=${PREFLIGHT_REHOME_FABRICS}" \
                        -e "nd_switch_apply=${PREFLIGHT_APPLY}" \
                        -e "nd_switch_deploy=true" \
                        -e "nd_switch_settle_seconds=${ND_SWITCH_SETTLE_SECONDS:-45}" \
                        -e "nd_switch_onboard_retries=${ND_SWITCH_ONBOARD_RETRIES:-10}" \
                        -e "nd_switch_onboard_delay=${ND_SWITCH_ONBOARD_DELAY:-120}" \
                        -e "nd_switch_rediscover_enabled=${PREFLIGHT_REDISCOVER_ENABLED}" \
                        -e "nd_switch_onboard_initial_wait=${PREFLIGHT_ONBOARD_INITIAL_WAIT}" \
                        -e "nd_switch_rehome_force_delete=${ND_SWITCH_REHOME_FORCE_DELETE:-true}" \
                        -e "nd_switch_predelete_deploy=${ND_SWITCH_PREDELETE_DEPLOY:-true}" \
                        -e "nd_switch_preserve_config=${ND_SWITCH_PRESERVE_CONFIG:-true}" \
                        -e "nd_switch_require_full_roster=true" \
                        -e "nd_switch_fail_on_missing=${PREFLIGHT_FAIL_ON_MISSING}"
                    '''
            }
            if (isPost) {
                env.ND_SWITCH_RESTORE_FAILED = 'false'
            }
            echo "✅ Switch membership ${label} passed for ND ${ndfcConfig.version}"
        } catch (Exception e) {
            rethrowIfInterrupt(e)
            if (!isPost) {
                // Pre-flight is a HARD GATE: the suite must not start unless the full
                // canonical 6+2 topology was added, recalculated & deployed, and
                // confirmed present. A timeout (exit 124) or NDP_SWITCH_CONFIRM_FAIL
                // fails the build on purpose.
                echo "❌ Switch membership pre-flight FAILED for ND ${ndfcConfig.version} within ${env.ND_SWITCH_SYNC_TIMEOUT ?: '3600'}s: the full 6+2 topology could not be confirmed, so the suite will not start. If this was a timeout (exit 124) the switch never became manageable in the window - check device power/reachability and grep the log for NDP_SWITCH_PREFLIGHT_MISSING / NDP_SWITCH_CONFIRM_FAIL. Cause: ${e.getMessage()}"
                throw e
            }
            if (phase == 'home') {
                // Home restore runs after the last round, so nothing downstream depends on it:
                // a switch that re-presents serial-less (exit 124) must not bury a completed run.
                // The next run's pre-flight (a hard gate) re-adds the roster, so warn + UNSTABLE,
                // never FAILURE. Remove the UNSTABLE line to let a home-only miss stay SUCCESS.
                currentBuild.result = 'UNSTABLE'
                echo "⚠️ NDP_SWITCH_HOME_RESTORE_INCOMPLETE: ${label} could not return the full roster to ${ndfcConfig.fabric_name} for ND ${ndfcConfig.version} within ${syncTimeout}s (a switch likely re-presented serial-less after a greenfield reload). All rounds already completed; the next pre-flight will re-add the roster. Cause: ${e.getMessage()}"
                return
            }
            env.ND_SWITCH_RESTORE_FAILED = 'true'
            currentBuild.result = 'UNSTABLE'
            echo "NDP_SWITCH_RESTORE_INCOMPLETE: ${label} could not restore the full switch roster for ND ${ndfcConfig.version} within ${syncTimeout}s; later rounds will be skipped. Cause: ${e.getMessage()}"
            return
        }
    }
}

def runFabricTest(ndfcConfig) {
    stage("${ndfcConfig.fabric_name} on NDFC ${ndfcConfig.version}") {
        script {
            echo "⏱ Stage '${ndfcConfig.fabric_name} on NDFC ${ndfcConfig.version}' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
            // PLAYBOOK_FILES is a @Field, so it is always in scope here -- no fallback list needed.
            def playbookFiles = PLAYBOOK_FILES

            // Active playbooks were already downloaded from Consul and installed
            // atomically by runNDFCVersionTests(). Keep this hook commented for
            // future per-playbook handling; a second download here would be unused.
            // playbookFiles.each { playbookName ->
            //     downloadFromConsul(playbookName)
            // }
            sh '''#!/bin/bash
                cd ${COLLECTIONS_DIRECTORY}
                echo "pwd: $(pwd)"
            '''

            // Prepare Groovy-side variables and call shell with them passed via environment
            // Use dynamic inventory if available, otherwise fallback to default inventory in collections dir
            def inventory_file = env.CURRENT_NDFC_INVENTORY ?: "${COLLECTIONS_DIRECTORY}/inventory.yaml"
            def inventoryVarsFile = "${inventory_file}.runtime-vars.json"
            // Must match the flag the version loop checks (NDFC_<versionId>_FAILED),
            // otherwise parseTestResults' failures never flip env.PIPELINE_FAILED.
            def failureFlagName = "NDFC_${ndfcConfig.versionId}_FAILED"
            def playbooksForShell = playbookFiles.join(' ')
            def secondaryFabricName = "${ndfcConfig.fabric_name_2 ?: 'External_Connectivity_Fabric'}".trim()
            def networkFabricName = ndfcConfig.fabric_name
            def testRunMarker = "${env.BUILD_TAG ?: 'manual'}-${ndfcConfig.versionId}-${new Date().format('yyyyMMddHHmmssSSS')}"

            // The vPC-pair switches come from this ND version's roster so a serial lives in one place only.
            // The 'advanced' pair runs on this round's primary fabric with that fabric's pair type; the external pair never moves.
            def serialByName = [:]
            ndfcConfig.switches.each { sw -> serialByName[sw.name] = sw.serial }
            def vpcPairRows = []
            VPC_PAIR_EXECUTIONS.each { run ->
                def serial1 = serialByName[run.switch1]
                def serial2 = serialByName[run.switch2]
                if (!serial1 || !serial2) {
                    error("vPC pair ${run.id}: ${run.switch1} / ${run.switch2} are not both in the ${ndfcConfig.version} switch roster")
                }
                def pairFabric = (run.id == 'advanced') ? ndfcConfig.fabric_name : run.fabric
                def pairType = (run.id == 'advanced') ? (ndfcConfig.vpc_pair_fabric_type ?: run.type) : run.type
                vpcPairRows.add([id: run.id, fabric: pairFabric, type: pairType, switch1: serial1, switch2: serial2])
            }

            // These fixed identifiers end up in shell command lines, so refuse anything that is not a plain token.
            def runtimeIdentifiers = []
            vpcPairRows.each { row ->
                ['fabric', 'type', 'switch1', 'switch2'].each { key ->
                    runtimeIdentifiers.add([name: "vPC pair ${row.id} ${key}", value: row[key]])
                }
            }
            def unsafeRuntimeIdentifiers = runtimeIdentifiers.findAll { item ->
                item.value && !(item.value ==~ /^[A-Za-z0-9_.:-]+$/)
            }
            if (!unsafeRuntimeIdentifiers.isEmpty()) {
                error("Unsafe topology identifier(s): ${unsafeRuntimeIdentifiers.collect { it.name }.join(', ')}")
            }

            // nd_manage_links, nd_manage_tor and nd_vpc_pair always run on the registry-verified lab switches.

            // The destructive switch lifecycle runs last and is followed by the canonical restore.
            // Run numbered links after fabric/resource tests and immediately before
            // nd_manage_switches, whose upstream setup removes all VXLAN members.
            def effectiveIntegrationModules = INTEGRATION_MODULES + INTERFACE_INTEGRATION_MODULES + [
                'nd_resource_manager', 'nd_manage_fabric', 'nd_manage_links',
                // 'nd_manage_switches', // functional suite disabled; membership and recovery remain enabled
            ]
            // One standalone run (and output file) per fixed vPC pair: nd_vpc_pair.<id>.
            def standaloneTargets = vpcPairRows.collect { row -> "nd_vpc_pair.${row.id}".toString() }
            def orderedIntegrationTargets = []
            effectiveIntegrationModules.each { moduleName ->
                orderedIntegrationTargets.add(moduleName)
                if (moduleName == 'nd_manage_policy_group' && env.ND_PREREQUISITE_ONLY_EFFECTIVE != 'true') {
                    orderedIntegrationTargets.addAll(standaloneTargets)
                }
            }
            def plannedResultTargets = orderedIntegrationTargets.collect { [it, 'integration'] }
            if (env.ND_PREREQUISITE_ONLY_EFFECTIVE != 'true') {
                PLAYBOOK_FILES.each { plannedResultTargets.add([it, 'smoke']) }
            }
            def reportContextsForShell = plannedResultTargets.collect { target ->
                def context = resultContextForTarget(ndfcConfig, target[0], networkFabricName, vpcPairRows)
                def key = activityResultKey(ndfcConfig, target[0], testRunMarker)
                MODULE_ACTIVITY_RESULTS[key] = [module: target[0], nd: ndfcConfig.version,
                    run_id: testRunMarker, fabric: context.fabric, scope: context.scope,
                    result: 'UNKNOWN', coverage: 'UNKNOWN', counts: [:], case_totals: [:],
                    failure: 'result not collected; execution may be interrupted or not reached']
                "${target[0]}|${context.scope}|${context.fabric}"
            }.join('\n')
            def integrationForShell = effectiveIntegrationModules.join(' ')
            def standaloneIntegrationForShell = standaloneTargets.join(' ')
            def vpcPairRunsForShell = vpcPairRows.collect { row -> "${row.id}|${row.fabric}|${row.type}|${row.switch1}|${row.switch2}".toString() }.join(' ')
            def profileCoverageForShell = (effectiveIntegrationModules + STANDALONE_INTEGRATION_MODULES).join(',')

            def duplicateIntegrationTargets = []
            INTEGRATION_MODULES.each { moduleName ->
                if (STANDALONE_INTEGRATION_MODULES.contains(moduleName)) {
                    duplicateIntegrationTargets.add(moduleName)
                }
            }
            if (!duplicateIntegrationTargets.isEmpty()) {
                error("Integration target(s) configured in both runners: ${duplicateIntegrationTargets.join(', ')}")
            }

            echo "📍 Using inventory file: ${inventory_file}"
            // Reset failure flag using Groovy function (not in shell)
            setFailureFlag(failureFlagName, false)
            echo "DEBUG: Reset ${failureFlagName} to false"
            echo "pwd: ${pwd()}"
            echo "ls -l: ${sh(script: 'ls -l', returnStdout: true)}"
            try {
                // Deploy
                stage("Tests Run ${ndfcConfig.fabric_name}") {
                    // echo timestamp when stage starts
                    echo "⏱ Stage 'Tests Run ${ndfcConfig.fabric_name}' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE', catchInterruptions: false) {
                        echo "🚀 Beginning of function - Deploying ${ndfcConfig.fabric_name}"
                        echo "Using inventory file: ${inventory_file}"
                        //echo "Using playbook file: ${playbook_file}"
                        echo "Tests Run starts for ${ndfcConfig.fabric_name} to NDFC version: ${ndfcConfig.version}"
                        withEnv(["PLAYBOOK_LIST=${playbooksForShell}",
                                 "INTEGRATION_LIST=${integrationForShell}",
                                 "STANDALONE_INTEGRATION_LIST=${standaloneIntegrationForShell}",
                                 "ORDERED_INTEGRATION_LIST=${orderedIntegrationTargets.join(' ')}",
                                 "NDP_EFFECTIVE_MODULES=${profileCoverageForShell}",
                                 "VPC_PAIR_RUNS=${vpcPairRunsForShell}",
                                 "NETWORK_FABRIC_NAME=${networkFabricName}",
                                 "ND_REPORT_TARGET_CONTEXTS=${reportContextsForShell}",
                                 "TEST_RUN_MARKER=${testRunMarker}",
                                 "ND_REPORT_DEBUG_ENABLED=${params.DEBUG == true}",
                                 "ND_REPORT_DEBUG_MODULES=${params.DEBUG_MODULES ?: ''}",
                                 "FABRIC_NAME=${ndfcConfig.fabric_name}",
                                 "SECONDARY_FABRIC_NAME=${secondaryFabricName}",
                                 "VERSION_ID=${ndfcConfig.versionId}",
                                 "INVENTORY_FILE=${inventory_file}",
                                 "INVENTORY_VARS_FILE=${inventoryVarsFile}",
                                 "WORKSPACE=${pwd()}"]) {
                            sh '''#!/bin/bash
                                # Keep running independent module/playbook pipelines after
                                # one Ansible failure; explicit prerequisite checks still exit.
                                set -e

                                if [ "${ND_PREREQUISITE_ONLY_EFFECTIVE:-false}" = "true" ]; then
                                    echo "🔎 Prerequisite-only audit: skipping standalone and smoke playbooks"
                                    STANDALONE_INTEGRATION_LIST=""
                                    PLAYBOOK_LIST=""
                                fi

                                # Clear every exact output expected from this run before any
                                # prerequisite can fail. The run marker below is the second
                                # fail-closed guard against parsing output from an older build.
                                for target in ${INTEGRATION_LIST} ${STANDALONE_INTEGRATION_LIST} ${PLAYBOOK_LIST}; do
                                    EXPECTED_OUTPUT="${COLLECTIONS_DIRECTORY}/test_output_${FABRIC_NAME}_${VERSION_ID}_${target}.txt"
                                    if [ -e "${EXPECTED_OUTPUT}" ] || [ -L "${EXPECTED_OUTPUT}" ]; then
                                        rm -f -- "${EXPECTED_OUTPUT}"
                                    fi
                                    rm -f -- "${EXPECTED_OUTPUT}.execution.json" "${EXPECTED_OUTPUT}.phases.json" "${EXPECTED_OUTPUT}.summary.json" "${EXPECTED_OUTPUT}.activity.json"
                                done

                                cd \${COLLECTIONS_DIRECTORY}
                                source \$HOME/ansible/venv/bin/activate

                                mkdir -p .nd_reporting_callbacks
                                cp nd_report.py .nd_reporting_callbacks/nd_report.py
                                run_reported_playbook() {
                                    local result_module="$1" result_log="$2" result_phase="$3"
                                    shift 3
                                    export ND_RESULT_MODULE="${result_module}" ND_RESULT_LOG="${PWD}/${result_log}"
                                    export ND_RESULT_PHASE="${result_phase}"
                                    export ANSIBLE_CALLBACK_PLUGINS="${PWD}/.nd_reporting_callbacks"
                                    export ANSIBLE_STDOUT_CALLBACK=nd_report ANSIBLE_NOCOLOR=1
                                    export ND_REPORT_DEBUG=false ANSIBLE_VERBOSITY=0
                                    if [ "${ND_REPORT_DEBUG_ENABLED}" = true ]; then
                                        case ",${ND_REPORT_DEBUG_MODULES// /}," in
                                            ,,|*,"${result_module}",*) export ND_REPORT_DEBUG=true ANSIBLE_VERBOSITY=4 ;;
                                        esac
                                    fi
                                    local result_start result_end result_status
                                    result_start=$(date +%s)
                                    if "$@"; then result_status=0; else result_status=$?; fi
                                    result_end=$(date +%s)
                                    python "${COLLECTIONS_DIRECTORY}/nd_result_summary.py" record \\
                                        --log "${result_log}" --module "${result_module}" --run-id "${TEST_RUN_MARKER}" \\
                                        --started "${result_start}" --ended "${result_end}" --exit-code "${result_status}" \\
                                        --prerequisite-seconds "$((result_start - PREREQUISITE_START))" || return 125
                                    return "${result_status}"
                                }

                                PROFILE_VALIDATOR="${COLLECTIONS_DIRECTORY}/validate_nd_prerequisites.py"
                                PROFILE_REGISTRY="${COLLECTIONS_DIRECTORY}/nd_prerequisite_profiles.yaml"
                                for required_file in "${PROFILE_VALIDATOR}" "${PROFILE_REGISTRY}"; do
                                    if [ ! -f "${required_file}" ] || [ -L "${required_file}" ] || [ ! -s "${required_file}" ]; then
                                        echo "❌ Jenkins profile coverage gate input is missing or unsafe: ${required_file}"
                                        exit 1
                                    fi
                                done
                                echo "🔎 Checking prerequisite-profile coverage for effective Jenkins modules"
                                python "${PROFILE_VALIDATOR}" coverage \
                                    --registry "${PROFILE_REGISTRY}" \
                                    --modules "${NDP_EFFECTIVE_MODULES}"
                                echo "✅ Jenkins prerequisite-profile coverage gate passed"

                                if ! command -v ansible-playbook &> /dev/null; then
                                    echo 'Error: ansible-playbook is not installed or not in PATH. Exiting.'
                                    exit 1
                                fi
                                # Verify inventory file exists
                                if [ ! -f "${INVENTORY_FILE}" ] || [ -L "${INVENTORY_FILE}" ] || [ ! -s "${INVENTORY_FILE}" ]; then
                                    echo "⚠️ Inventory file not found: ${INVENTORY_FILE}"
                                    echo "📂 Available inventory files in \${COLLECTIONS_DIRECTORY}:"
                                    ls -l \${COLLECTIONS_DIRECTORY}/inventory*.yaml || echo "No inventory files found"
                                    exit 1
                                fi
                                echo "✅ Using inventory file: ${INVENTORY_FILE}"

                                INVENTORY_VARS_TMP="${INVENTORY_VARS_FILE}.tmp"
                                cleanup_inventory_vars() {
                                    rm -f -- "${INVENTORY_VARS_TMP}" "${INVENTORY_VARS_FILE}"
                                }
                                trap cleanup_inventory_vars EXIT
                                umask 077
                                ansible-inventory -i "${INVENTORY_FILE}" --host nd_controller > "${INVENTORY_VARS_TMP}"
                                [ -s "${INVENTORY_VARS_TMP}" ] || {
                                    echo "❌ Failed to resolve runtime variables from ${INVENTORY_FILE}" >&2
                                    exit 1
                                }
                                mv -- "${INVENTORY_VARS_TMP}" "${INVENTORY_VARS_FILE}"
                                chmod 600 "${INVENTORY_VARS_FILE}"
                                echo "✅ Resolved protected runtime variables from dynamic inventory"
                                RUN_FAILURE=0
                                # Cap each module/playbook run so a hung ND call can't wedge the build for hours.
                                MODULE_TIMEOUT="${MODULE_TIMEOUT:-2400}"
                                # GreenField switch bring-up (nd_manage_switches) legitimately needs
                                # longer than lightweight modules; #16 was killed at 2400s mid switch-prep.
                                SWITCHES_MODULE_TIMEOUT="${SWITCHES_MODULE_TIMEOUT:-5400}"
                                TIMEOUT_CMD="$(command -v timeout >/dev/null 2>&1 && echo "timeout -k 60 ${MODULE_TIMEOUT}" || true)"

                                # Clean up old timestamped test output files from previous runs
                                echo "🧹 Cleaning up old test output files..."
                                OLD_FILES=$(find . -maxdepth 1 -name "test_output_${FABRIC_NAME}_${VERSION_ID}_*_[0-9]*.txt" 2>/dev/null || true)
                                if [ -n "$OLD_FILES" ]; then
                                    echo "$OLD_FILES" | while read file; do
                                        if [ -f "$file" ]; then
                                            echo "  🗑️  Removing: $file"
                                            rm -f "$file"
                                        fi
                                    done
                                    echo "✅ Cleanup completed"
                                else
                                    echo "  ℹ️  No old test output files found"
                                fi

                                echo ""
                                echo "📂 Directory contents after cleanup:"
                                ls -lh test_output*.txt 2>/dev/null || echo "  ℹ️  No test_output files in directory"
                                echo ""

                                # --- Per-module switch-availability guard -------------------------
                                # Confirm the canonical 6+2 switches are present before EVERY module and
                                # re-add any a prior destructive module (e.g. nd_manage_switches) removed,
                                # then recalculate & deploy, so a module never runs on a fabric that is
                                # missing a switch ("ND Error 400: Switch id <serial> not found"). Enforced
                                # add (apply=true) except during a prerequisite-only audit. Bounded by
                                # ND_SWITCH_GUARD_TIMEOUT (default 1800s) so greenfield reloads have time to finish.
                                # The enforced pre-flight already gates the suite start and
                                # the post-suite restore re-confirms at the end; this is the mid-suite heal.
                                # Fail closed: if the canonical roster cannot be confirmed/restored,
                                # do not run the module against a partial or stale fabric. The caller's
                                # `set -e` stops the shared-topology run before it can cascade failures.
                                SWITCH_GUARD_PLAYBOOK="${COLLECTIONS_DIRECTORY}/nd_ensure_switches.yaml"
                                SWITCH_GUARD_ROSTER="${COLLECTIONS_DIRECTORY}/integration_config.yml"
                                SWITCH_GUARD_TIMEOUT="${ND_SWITCH_GUARD_TIMEOUT:-1800}"
                                SWITCH_GUARD_APPLY="true"
                                if [ "${ND_PREREQUISITE_ONLY_EFFECTIVE:-false}" = "true" ]; then
                                    SWITCH_GUARD_APPLY="false"
                                fi
                                ensure_switches_ready() {
                                    local _label="$1"
                                    if [ "${ND_SWITCH_PREFLIGHT_READY:-false}" != "true" ]; then
                                        echo "❌ [switch-guard] canonical switch pre-flight is unavailable; refusing to run ${_label}" >&2
                                        return 1
                                    fi
                                    if [ ! -f "${SWITCH_GUARD_PLAYBOOK}" ] || [ -L "${SWITCH_GUARD_PLAYBOOK}" ] || [ ! -s "${SWITCH_GUARD_PLAYBOOK}" ]; then
                                        echo "❌ [switch-guard] playbook missing/unsafe; refusing to run ${_label}" >&2
                                        return 1
                                    fi
                                    local _gt
                                    _gt="$(command -v timeout >/dev/null 2>&1 && echo "timeout -k 30 ${SWITCH_GUARD_TIMEOUT}" || true)"
                                    echo "🔎 [switch-guard] Confirming canonical 6+2 switches before ${_label} (apply=${SWITCH_GUARD_APPLY}, timeout=${SWITCH_GUARD_TIMEOUT}s)"
                                    if ${_gt} ansible-playbook -i "${INVENTORY_FILE}" "${SWITCH_GUARD_PLAYBOOK}" \
                                            -e "nd_switch_roster_file=${SWITCH_GUARD_ROSTER}" \
                                            -e "nd_switch_apply=${SWITCH_GUARD_APPLY}" \
                                            -e "nd_switch_deploy=true" \
                                            -e "nd_switch_settle_seconds=${ND_SWITCH_SETTLE_SECONDS:-45}" \
                                            -e "nd_switch_onboard_retries=${ND_SWITCH_ONBOARD_RETRIES:-10}" \
                                            -e "nd_switch_onboard_delay=${ND_SWITCH_ONBOARD_DELAY:-120}" \
                                            -e "nd_switch_onboard_initial_wait=${ND_SWITCH_ONBOARD_INITIAL_WAIT:-480}" \
                                            -e "nd_switch_preserve_config=${ND_SWITCH_PRESERVE_CONFIG:-true}" \
                                            -e "nd_switch_require_full_roster=true" \
                                            -e "nd_switch_fail_on_missing=false"; then
                                        echo "✅ [switch-guard] Canonical switches confirmed before ${_label}"
                                    else
                                        echo "❌ [switch-guard] Could not confirm/restore the full canonical topology before ${_label}; refusing to run the module. Grep NDP_SWITCH_PREFLIGHT_MISSING / NDP_SWITCH_CONFIRM_FAIL and check device power/reachability." >&2
                                        return 1
                                    fi
                                }

                                # Stronger guard for the DESTRUCTIVE nd_manage_switches module only: its setup
                                # wipes then re-adds fabric inventory, so a single confirm/re-add can race a
                                # just-reset switch that is still reloading. Before that module's sanity runs,
                                # confirm the canonical roster; if any switch is still missing, wait
                                # ND_SWITCHES_READD_WAIT (default 600s = 10 min) for the greenfield reload to
                                # settle and re-add again, up to ND_SWITCHES_READD_ATTEMPTS (default 3) total.
                                # Fail closed if the roster never returns so the sanity never runs on a
                                # partial fabric.
                                SWITCHES_READD_ATTEMPTS="${ND_SWITCHES_READD_ATTEMPTS:-3}"
                                SWITCHES_READD_WAIT="${ND_SWITCHES_READD_WAIT:-600}"
                                ensure_switches_ready_persistent() {
                                    local _label="$1"
                                    local _attempt=1
                                    while [ "${_attempt}" -le "${SWITCHES_READD_ATTEMPTS}" ]; do
                                        if ensure_switches_ready "${_label} (switch re-add attempt ${_attempt}/${SWITCHES_READD_ATTEMPTS})"; then
                                            return 0
                                        fi
                                        if [ "${_attempt}" -lt "${SWITCHES_READD_ATTEMPTS}" ]; then
                                            echo "⏳ [switch-guard] Canonical switches still not available before ${_label}; waiting ${SWITCHES_READD_WAIT}s for the greenfield re-add to settle, then retrying (next attempt $((_attempt + 1))/${SWITCHES_READD_ATTEMPTS})" >&2
                                            sleep "${SWITCHES_READD_WAIT}"
                                        fi
                                        _attempt=$((_attempt + 1))
                                    done
                                    echo "❌ [switch-guard] Canonical switches never became available after ${SWITCHES_READD_ATTEMPTS} re-add attempts (${SWITCHES_READD_WAIT}s apart) before ${_label}; refusing to run the switches sanity on a partial fabric." >&2
                                    return 1
                                }

                                # nd_vpc_pair runs once per fixed lab pair (VPC_PAIR_RUNS rows: id|fabric|type|switch1|switch2)
                                # immediately after nd_manage_policy_group, before destructive fabric-inventory targets.
                                # It is a complete playbook rather than a role, so execute it directly instead of using
                                # run_integration_module.yaml. A pair needs a cabled physical peer-link (virtual peering is
                                # unsupported on the N9K-C9300v lab switches); the module always runs, and the probe below only
                                # waits for ND to report that cable and logs NDP_VPC_PEERLINK_ABSENT when it never does.
                                run_standalone_integration() {
                                    local m="$1"
                                    local PEERLINK_PROBE="${INVENTORY_VARS_FILE}.peerlink-probe.yaml"
                                    echo "==========Running Standalone Integration Modules============="
                                    echo "🚀 Starting standalone integration test for $m"
                                    VPC_MODULE="${m%%.*}"
                                    VPC_RUN_ID="${m#*.}"
                                    VPC_ROW=""
                                    for row in ${VPC_PAIR_RUNS}; do
                                        case "${row}" in
                                            "${VPC_RUN_ID}|"*) VPC_ROW="${row}" ;;
                                        esac
                                    done
                                    if [ -z "${VPC_ROW}" ]; then
                                        echo "❌ No vPC pair definition for standalone target ${m}" >&2
                                        exit 1
                                    fi
                                    IFS='|' read -r _ VPC_FABRIC VPC_TYPE VPC_SW1 VPC_SW2 <<< "${VPC_ROW}"
                                    PREREQUISITE_START=$(date +%s)
                                    ensure_switches_ready "standalone module $m"
                                    TARGET_PLAYBOOK="${COLLECTIONS_DIRECTORY}/tests/integration/targets/${VPC_MODULE}/tasks/main.yaml"
                                    OUTPUT_FILE="test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt"

                                    if [ ! -f "${TARGET_PLAYBOOK}" ] || [ -L "${TARGET_PLAYBOOK}" ] || [ ! -s "${TARGET_PLAYBOOK}" ]; then
                                        echo "❌ Required standalone integration playbook is missing, empty, or unsafe: ${TARGET_PLAYBOOK}" >&2
                                        exit 1
                                    fi

                                    if [ -f "${OUTPUT_FILE}" ]; then
                                        echo "🗑️  Deleting existing test output file: ${OUTPUT_FILE}"
                                        rm -f "${OUTPUT_FILE}"
                                    fi

                                    echo "[MODULE: $m] Starting execution..." | tee -a "${OUTPUT_FILE}"
                                    echo "[RUN_MARKER: ${TEST_RUN_MARKER}]" | tee -a "${OUTPUT_FILE}"
                                    START_TIME=$(date +%s)
                                    echo "[TIMESTAMP_START: ${START_TIME}]" | tee -a "${OUTPUT_FILE}"

                                                                        # Only the primary fabric's pair has a verified physical peer-link allocation.
                                    cat > "${PEERLINK_PROBE}" <<'PEERLINK_PROBE_EOF'
- name: vPC peer-link probe
  hosts: nd_controller
  gather_facts: false
  tasks:
    - name: Prepare the canonical leaf peer-link ports
      ansible.builtin.include_tasks: "{{ playbook_dir }}/nd_prerequisite/admin_up_interface.yaml"
      loop:
        - fabric: "{{ probe_fabric }}"
          serial: "{{ probe_s1 }}"
          ifname: Ethernet1/2
          label: vxlan_leaf_1/Ethernet1/2
        - fabric: "{{ probe_fabric }}"
          serial: "{{ probe_s2 }}"
          ifname: Ethernet1/1
          label: vxlan_leaf_2/Ethernet1/1
      loop_control:
        loop_var: _auif
      when: probe_prepare_peerlink | default(false) | bool
    - name: Read the links of the fabric
      cisco.nd.nd_rest:
        path: "/api/v1/manage/links?fabricName={{ probe_fabric }}"
        method: get
      register: _probe_links
    - name: Validate the link API response
      ansible.builtin.assert:
        that:
          - _probe_links.status | default(0) | int == 200
          - _probe_links.current | default(none) is mapping
          - _probe_links.current.links | default(none) is sequence
          - _probe_links.current.links | default(none) is not string
          - _probe_links.current.links | default(none) is not mapping
        fail_msg: NDP_VPC_PEERLINK_PROBE_FAILED - invalid link API response
    - name: Report whether the two switches are linked
      ansible.builtin.debug:
        msg: "{{ 'NDP_VPC_PEERLINK_PRESENT' if (_probe_links.current.links | selectattr('srcSwitchId', 'in', [probe_s1, probe_s2]) | selectattr('dstSwitchId', 'in', [probe_s1, probe_s2]) | selectattr('linkPresent', 'defined') | selectattr('linkPresent', 'equalto', true) | list | length > 0) else 'NDP_VPC_PEERLINK_ABSENT' }}"
PEERLINK_PROBE_EOF
                                                                        local PREPARE_PEERLINK=false
                                                                        if [ "${VPC_RUN_ID}" = "advanced" ] && [ "${VPC_FABRIC}" = "${FABRIC_NAME}" ]; then
                                                                                PREPARE_PEERLINK=true
                                                                        fi
                                                                        local PROBE_TIMEOUT_CMD
                                                                        PROBE_TIMEOUT_CMD="$(command -v timeout >/dev/null 2>&1 && echo "timeout -k 30 ${VPC_PEERLINK_TIMEOUT:-180}" || true)"
                                    PEERLINK_TRY=0
                                    while :; do
                                                                                local PEERLINK_STATUS=0
                                                                                PEERLINK_RESULT="$(${PROBE_TIMEOUT_CMD} ansible-playbook -i "${INVENTORY_FILE}" "${PEERLINK_PROBE}" \
                                            -e "@${INVENTORY_VARS_FILE}" -e "probe_fabric=${VPC_FABRIC}" \
                                                                                        -e "probe_s1=${VPC_SW1}" -e "probe_s2=${VPC_SW2}" \
                                                                                        -e "probe_prepare_peerlink=${PREPARE_PEERLINK}" 2>&1)" || PEERLINK_STATUS=$?
                                                                                PREPARE_PEERLINK=false
                                                                                if [ "${PEERLINK_STATUS}" -ne 0 ] || ! printf '%s\n' "${PEERLINK_RESULT}" | grep -Eq 'NDP_VPC_PEERLINK_(PRESENT|ABSENT)'; then
                                                                                        printf '%s\n' "${PEERLINK_RESULT}" | tee -a "${OUTPUT_FILE}"
                                                                                        echo "NDP_VPC_PEERLINK_PROBE_FAILED [${m}] exit=${PEERLINK_STATUS}; running the module anyway, but recording the prerequisite error" | tee -a "${OUTPUT_FILE}"
                                                                                        RUN_FAILURE=1
                                                                                        break
                                                                                fi
                                                                                printf '%s\n' "${PEERLINK_RESULT}" | grep -q 'NDP_VPC_PEERLINK_PRESENT' && break
                                        PEERLINK_TRY=$((PEERLINK_TRY + 1))
                                        if [ "${PEERLINK_TRY}" -ge "${VPC_PEERLINK_ATTEMPTS:-6}" ]; then
                                                                                        echo "NDP_VPC_PEERLINK_ABSENT [integration.${m}]: ND reports no active physical peer-link between ${VPC_SW1} and ${VPC_SW2} in ${VPC_FABRIC}; running the module anyway (verify peer-link cabling and interface admin state)" | tee -a "${OUTPUT_FILE}"
                                            break
                                        fi
                                        sleep "${VPC_PEERLINK_WAIT_SECONDS:-20}"
                                    done
                                    rm -f -- "${PEERLINK_PROBE}"
                                    # A prior aborted run of this exact standalone target can leave a
                                    # half-created vPC pair for THIS (VPC_SW1, VPC_SW2) pairing: the suite's
                                    # own TC1 setup creates it with state:merged (no save/deploy) before its
                                    # own gather+validate self-check, and never reaches its own teardown if
                                    # that self-check fails (e.g. "Validation failed. Missing pairs: [...]").
                                    # Best-effort clear any such pair first so every run starts from a known
                                    # clean slate; "nothing to delete" is expected and harmless.
                                                                        VPC_PRECLEAN_PLAYBOOK="${COLLECTIONS_DIRECTORY}/nd_vpc_pair_preclean.yaml"
                                    ansible-playbook -i "${INVENTORY_FILE}" "${VPC_PRECLEAN_PLAYBOOK}" \
                                        -e "@${INVENTORY_VARS_FILE}" -e "preclean_fabric=${VPC_FABRIC}" \
                                        -e "preclean_s1=${VPC_SW1}" -e "preclean_s2=${VPC_SW2}" \
                                        2>&1 | tee -a "${OUTPUT_FILE}" || true
                                    run_reported_playbook "$m" "${OUTPUT_FILE}" execution ${TIMEOUT_CMD} ansible-playbook -i "${INVENTORY_FILE}" "${TARGET_PLAYBOOK}" \
                                        -e "@${INVENTORY_VARS_FILE}" \
                                        -e "fabric_name=${VPC_FABRIC}" \
                                        -e "switch1_serial=${VPC_SW1}" \
                                        -e "switch2_serial=${VPC_SW2}" \
                                        -e "fabric_type=${VPC_TYPE}" \
                                        2>&1 | tee -a "${OUTPUT_FILE}"
                                    ANSIBLE_STATUS=${PIPESTATUS[0]}
                                    echo "[ANSIBLE_EXIT_STATUS: ${ANSIBLE_STATUS}]" | tee -a "${OUTPUT_FILE}"
                                    if [ "${ANSIBLE_STATUS}" -ne 0 ]; then
                                        RUN_FAILURE=1
                                    fi
                                    END_TIME=$(date +%s)
                                    DURATION=$((END_TIME - START_TIME))
                                    echo "[TIMESTAMP_END: ${END_TIME}]" | tee -a "${OUTPUT_FILE}"
                                    echo "[DURATION_SECONDS: ${DURATION}]" | tee -a "${OUTPUT_FILE}"
                                    echo "[MODULE: $m] Execution completed." | tee -a "${OUTPUT_FILE}"
                                }

                                echo "==========Running Integration Modules============="

                                # Run each integration module as its OWN playbook so each
                                # gets its own PLAY RECAP (passed/failed/skipped) + duration.
                                for m in ${ORDERED_INTEGRATION_LIST}; do
                                    case "${m}" in
                                        nd_vpc_pair.*)
                                            run_standalone_integration "${m}"
                                            continue
                                            ;;
                                    esac
                                    echo "🚀 Starting integ test for $m module"
                                    echo "========================================"
                                    echo "Running integration module: $m, pwd: $(pwd)"
                                    echo "========================================"
                                    PREREQUISITE_START=$(date +%s)
                                    # Switches sanity is destructive (wipe + re-add); give the roster a
                                    # 10-min-spaced re-add retry before this module only. Every other module
                                    # keeps the single pre-module confirm/re-add.
                                    if [ "${m}" = "nd_manage_switches" ]; then
                                        ensure_switches_ready_persistent "integration module $m"
                                    else
                                        ensure_switches_ready "integration module $m"
                                    fi
                                    if [ -f "${COLLECTIONS_DIRECTORY}/run_integration_module.yaml" ] && \
                                       [ ! -L "${COLLECTIONS_DIRECTORY}/run_integration_module.yaml" ] && \
                                       [ -s "${COLLECTIONS_DIRECTORY}/run_integration_module.yaml" ]; then
                                        if [ -f "test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt" ]; then
                                            echo "🗑️  Deleting existing test output file: test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt"
                                            rm -f "test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt"
                                        fi
                                        echo "[MODULE: $m] Starting execution..." | tee -a test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt
                                        echo "[RUN_MARKER: ${TEST_RUN_MARKER}]" | tee -a test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt
                                        START_TIME=$(date +%s)
                                        echo "[TIMESTAMP_START: ${START_TIME}]" | tee -a test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt
                                        NETWORK_EXTRA_VARS=""
                                        if [ "${m}" = "nd_manage_networks" ]; then
                                            NETWORK_EXTRA_VARS="-e ansible_it_fabric=${NETWORK_FABRIC_NAME} -e nd_network_standalone_fabric=${NETWORK_FABRIC_NAME}"
                                        fi
                                        MODULE_TOPOLOGY_VARS=""
                                        if [ "${m}" = "nd_manage_switches" ]; then
                                            # The upstream switch target rebuilds exactly leaf/spine/border.
                                            MODULE_TOPOLOGY_VARS="-e ansible_switch1=192.0.2.195 -e ansible_switch1_serial=SERIAL00001 -e ansible_switch2=192.0.2.194 -e ansible_switch2_serial=SERIAL00003 -e ansible_switch3=192.0.2.88 -e ansible_switch3_serial=SERIAL00004"
                                        elif [ "${m}" = "nd_manage_l3out" ]; then
                                            # L3Out switch1 = vxlan_border_1 (SERIAL00004 / .88, role border): now cabled
                                            # to external_edge_1 (border_1 Eth1/1 routed <-> edge_1 Eth1/3, probe-confirmed
                                            # up/up) for the ext_l3_dci_link. border_1's baseline role is 'border', so the
                                            # verify-only l3out needs no role change. switch2 stays external_edge_1 (.89) on
                                            # Eth1/3. (Was leaf_1 while border_1 was uncabled; build #26 proved a leaf is
                                            # rejected "not a supported role for BGP L3Out".)
                                            MODULE_TOPOLOGY_VARS="-e nd_test_switch1_id=SERIAL00004 -e nd_test_switch1_mgmt_ip=192.0.2.88 -e nd_test_switch2_id=SERIAL00005 -e nd_test_switch2_mgmt_ip=192.0.2.89 -e nd_test_switch2_interface=Ethernet1/3"
                                        fi
                                        # ND 4.2 interface targets use their own nd_test_* vars (not the nd_manage_*
                                        # fabric/serial vars), so point them at THIS run's fabric + a real switch and
                                        # add the parent/member overrides each one needs. Both vars default to empty
                                        # for non-interface modules, so the command line stays unchanged for them.
                                        INTERFACE_TEST_VARS=""
                                        case "${m}" in
                                            nd_interface_*)
                                                # The typed interface profiles are bound to vxlan_leaf_1 (192.0.2.195).
                                                INTERFACE_TEST_VARS="-e nd_test_fabric_name=${FABRIC_NAME} -e nd_test_switch_ip=192.0.2.195"
                                                ;;
                                        esac
                                        case "${m}" in
                                            nd_interface_subinterface_managed|nd_interface_subinterface_unmanaged)
                                                # PARENT MUST NEVER BE A FABRIC UNDERLAY UPLINK. On leaf_1 (.195)
                                                # Eth1/3 is the intra-fabric underlay to spine_1 Eth1/1 (and Eth1/2 the
                                                # leaf_1<->leaf_2 link); the subinterface test strips p2p/OSPF config,
                                                # which ND then refuses to rebuild ("Required [p2p]/OSPF configuration not
                                                # found") and holds the WHOLE VXLAN_EVPN_Fabric (spine_1/leaf_1/leaf_2/
                                                # border_1) in migration mode -- every later module then 207s "switches in
                                                # read-only mode" (live-proven configSave 500, build #27, 2026-09-16).
                                                # The parent is the EXISTING inter-fabric cable leaf_1 Eth1/1 <-> external_edge_1
                                                # Eth1/1 (up/up, ND-default intent, used by no other target). The registry
                                                # profile (Consul) publishes it and the runner refuses any other parent. The
                                                # typed prerequisite gate proves the cable exists (module is SKIP otherwise) and
                                                # carries no underlay link, temporarily creates routedHost intent plus a
                                                # memberless L3 Port-channel10, and restores the journaled pre-test state after
                                                # target cleanup (including failures).
                                                INTERFACE_TEST_VARS="${INTERFACE_TEST_VARS} -e nd_test_port_channel_parent=Port-channel10"
                                                ;;
                                            nd_interface_port_channel_access)
                                                # De-conflicted member pools: one target's stuck member cannot starve another's free-interface gate.
                                                INTERFACE_TEST_VARS="${INTERFACE_TEST_VARS} -e nd_test_pc_member_a=Ethernet1/10 -e nd_test_pc_member_b=Ethernet1/11 -e nd_test_pc_member_c=Ethernet1/12 -e nd_test_pc_member_d=Ethernet1/13"
                                                ;;
                                            nd_interface_port_channel_trunk_host)
                                                INTERFACE_TEST_VARS="${INTERFACE_TEST_VARS} -e nd_test_pc_member_a=Ethernet1/14 -e nd_test_pc_member_b=Ethernet1/15 -e nd_test_pc_member_c=Ethernet1/16 -e nd_test_pc_member_d=Ethernet1/17"
                                                ;;
                                            nd_interface_port_channel_routed)
                                                INTERFACE_TEST_VARS="${INTERFACE_TEST_VARS} -e nd_test_pc_member_a=Ethernet1/18 -e nd_test_pc_member_b=Ethernet1/19 -e nd_test_pc_member_c=Ethernet1/20 -e nd_test_pc_member_d=Ethernet1/21"
                                                ;;
                                        esac
                                        # Switch prep gets a longer cap than lightweight modules (see #16).
                                        if [ "${m}" = "nd_manage_switches" ]; then
                                            MOD_TIMEOUT="${SWITCHES_MODULE_TIMEOUT}"
                                        else
                                            MOD_TIMEOUT="${MODULE_TIMEOUT}"
                                        fi
                                        MOD_TIMEOUT_CMD="$(command -v timeout >/dev/null 2>&1 && echo "timeout -k 60 ${MOD_TIMEOUT}" || true)"
                                        run_reported_playbook "$m" "test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt" prerequisites ${MOD_TIMEOUT_CMD} ansible-playbook -i "${INVENTORY_FILE}" "${COLLECTIONS_DIRECTORY}/run_integration_module.yaml" \
                                            -e "@${INVENTORY_VARS_FILE}" \
                                            -e "test_module=$m" \
                                            -e "fabric_name=${FABRIC_NAME}" \
                                            -e "nd_test_fabric2_name=${SECONDARY_FABRIC_NAME}" \
                                            -e "nd_prerequisite_enable=${ND_PREREQUISITE_ENABLE_EFFECTIVE}" \
                                            -e "nd_prerequisite_apply=${ND_PREREQUISITE_APPLY_EFFECTIVE}" \
                                            -e "nd_prerequisite_repair_baseline=true" \
                                            -e "nd_prerequisite_only=${ND_PREREQUISITE_ONLY_EFFECTIVE}" \
                                            -e "nd_prerequisite_mode=live" \
                                            -e "nd_prerequisite_run_id=${TEST_RUN_MARKER}_${m}" \
                                            ${NETWORK_EXTRA_VARS} ${MODULE_TOPOLOGY_VARS} ${INTERFACE_TEST_VARS} 2>&1 | tee -a test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt
                                        ANSIBLE_STATUS=${PIPESTATUS[0]}
                                        echo "[ANSIBLE_EXIT_STATUS: ${ANSIBLE_STATUS}]" | tee -a test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt
                                        if [ "${ANSIBLE_STATUS}" -ne 0 ]; then
                                            RUN_FAILURE=1
                                        fi
                                        END_TIME=$(date +%s)
                                        DURATION=$((END_TIME - START_TIME))
                                        echo "[TIMESTAMP_END: ${END_TIME}]" | tee -a test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt
                                        echo "[DURATION_SECONDS: ${DURATION}]" | tee -a test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt
                                        echo "[MODULE: $m] Execution completed." | tee -a test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt
                                    else
                                        echo "❌ Required Consul runner is missing, empty, or unsafe: run_integration_module.yaml" >&2
                                        exit 1
                                    fi
                                done

                                echo "==========Running Smoke Playbooks============="

                                # Run each smoke playbook if present
                                for pb in ${PLAYBOOK_LIST}; do
                                    ls -lrt

                                    echo "========================================"
                                    echo "Running playbook: \$pb, pwd: $(pwd)"
                                    echo "========================================"
                                    PREREQUISITE_START=$(date +%s)
                                    ensure_switches_ready "smoke playbook $pb"
                                    if [ -f "\${COLLECTIONS_DIRECTORY}/\$pb" ] && \
                                       [ ! -L "\${COLLECTIONS_DIRECTORY}/\$pb" ] && \
                                       [ -s "\${COLLECTIONS_DIRECTORY}/\$pb" ]; then
                                        # Check and delete existing test output file (without timestamp) before running
                                        if [ -f "test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt" ]; then
                                            echo "🗑️  Deleting existing test output file: test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt"
                                            rm -f "test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt"
                                            echo "✅ Deleted old test output file"
                                        fi

                                        echo "[PLAYBOOK: \$pb] Starting execution..." | tee -a test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt
                                        echo "[RUN_MARKER: ${TEST_RUN_MARKER}]" | tee -a test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt
                                        START_TIME=$(date +%s)
                                        echo "[TIMESTAMP_START: ${START_TIME}]" | tee -a test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt
                                        echo "=============="
                                        echo "\$pb: ${pb}"
                                        echo "INVENTORY_FILE: ${INVENTORY_FILE}"
                                        run_reported_playbook "$pb" "test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt" execution ${TIMEOUT_CMD} ansible-playbook -i "${INVENTORY_FILE}" "${COLLECTIONS_DIRECTORY}/${pb}" \
                                            -e "@${INVENTORY_VARS_FILE}" \
                                            2>&1 | tee -a test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt
                                        ANSIBLE_STATUS=${PIPESTATUS[0]}
                                        echo "[ANSIBLE_EXIT_STATUS: ${ANSIBLE_STATUS}]" | tee -a test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt
                                        if [ "${ANSIBLE_STATUS}" -ne 0 ]; then
                                            RUN_FAILURE=1
                                        fi
                                        END_TIME=$(date +%s)
                                        DURATION=$((END_TIME - START_TIME))
                                        echo "=============="
                                        echo "[TIMESTAMP_END: ${END_TIME}]" | tee -a test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt
                                        echo "[DURATION_SECONDS: ${DURATION}]" | tee -a test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt
                                        echo "[PLAYBOOK: \$pb] Execution completed." | tee -a test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt
                                    else
                                        echo "❌ Required Consul playbook is missing, empty, or unsafe: \$pb" >&2
                                        exit 1
                                    fi
                                done

                                # Build an ordered per-module execution report. The
                                # previous report only emitted fully skipped tasks, so
                                # an owner could not tell how far a module progressed
                                # or which task stopped it. Keep this artifact plain
                                # text and deterministic because it is consumed from
                                # Jenkins/Webex as well as downloaded by engineers.
                                echo "======== BUILDING MODULE TEST-PROGRESS REPORT ========"
                                SKIP_SUMMARY="skipped_tests_${FABRIC_NAME}_${VERSION_ID}.txt"
                                {
                                    echo "ND NIGHTLY MODULE TEST-PROGRESS REPORT"
                                    echo "Build: ${BUILD_NUMBER:-unknown}"
                                    echo "Primary fabric: ${FABRIC_NAME} (actual fabric/type is shown for each module below)"
                                    echo "ND/NDFC version: ${VERSION_ID}"
                                    echo "Generated: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
                                    echo ""
                                    echo "Meaning:"
                                    echo "  DIAGNOSTIC ANSIBLE TASK ACTIVITY ONLY - not module test-case totals."
                                    echo "  COMPLETED = task/test had at least one executed result (ok/changed/failed)."
                                    echo "  EXPECTED-FAILURE = fatal result was ignored by the playbook."
                                    echo "  FAILED = non-ignored fatal/failed result, or non-zero Ansible exit status."
                                    echo "  PENDING/SKIPPED = task/test was observed only as skipped."
                                    echo "  Tests that never produced a TASK line cannot be reconstructed from this log."
                                    echo ""
                                } > "${SKIP_SUMMARY}"
                                for sm in ${ORDERED_INTEGRATION_LIST} ${PLAYBOOK_LIST}; do
                                    smlog="test_output_${FABRIC_NAME}_${VERSION_ID}_${sm}.txt"
                                    [ -f "${smlog}" ] || continue
                                    report_fabric="Unknown"
                                    report_scope="Unknown"
                                    while IFS='|' read -r report_module candidate_scope candidate_fabric; do
                                        if [ "${report_module}" = "${sm}" ]; then
                                            report_fabric="${candidate_fabric}"
                                            report_scope="${candidate_scope}"
                                            break
                                        fi
                                    done <<< "${ND_REPORT_TARGET_CONTEXTS}"
                                    awk -v module="${sm}" -v logfile="${smlog}" \
                                        -v actual_fabric="${report_fabric}" -v fabric_type="${report_scope}" '
                                        function trim(value) {
                                            sub(/^[[:space:]]+/, "", value)
                                            sub(/[[:space:]]+$/, "", value)
                                            return value
                                        }
                                        function flush() {
                                            if (task == "") return
                                            if (failed_seen && !ignored) {
                                                failed_count++
                                                failed_names[failed_count] = task
                                            } else if (skipped > 0 && executed == 0) {
                                                skipped_count++
                                                skipped_names[skipped_count] = task
                                            } else if (executed > 0) {
                                                completed_count++
                                                if (failed_seen && ignored) {
                                                    completed_names[completed_count] = "[EXPECTED-FAILURE/IGNORED] " task
                                                } else {
                                                    completed_names[completed_count] = task
                                                }
                                            }
                                            task = ""
                                            skipped = 0
                                            executed = 0
                                            failed_seen = 0
                                            ignored = 0
                                        }
                                        BEGIN {
                                            task = ""
                                            skipped = 0
                                            executed = 0
                                            failed_seen = 0
                                            ignored = 0
                                            completed_count = 0
                                            failed_count = 0
                                            skipped_count = 0
                                            exit_status = "not recorded"
                                        }
                                        index($0, "TASK [") == 1 {
                                            flush()
                                            task = substr($0, 7)
                                            sub(/[[:space:]]+\\*+$/, "", task)
                                            task = trim(task)
                                            next
                                        }
                                        index($0, "skipping: [") == 1 { skipped++; next }
                                        index($0, "ok: [") == 1 ||
                                        index($0, "changed: [") == 1 ||
                                        index($0, "rescued: [") == 1 { executed++; next }
                                        index($0, "failed: [") == 1 ||
                                        index($0, "fatal: [") == 1 {
                                            executed++
                                            failed_seen = 1
                                            next
                                        }
                                        index($0, "...ignoring") > 0 { ignored = 1; next }
                                        index($0, "[ANSIBLE_EXIT_STATUS:") == 1 {
                                            exit_status = $0
                                            sub(/^.*[[]ANSIBLE_EXIT_STATUS:[[:space:]]*/, "", exit_status)
                                            sub(/].*$/, "", exit_status)
                                            exit_status = trim(exit_status)
                                            next
                                        }
                                        index($0, "PLAY RECAP") == 1 { flush(); next }
                                        END {
                                            flush()
                                            result = "PASSED"
                                            if (failed_count > 0 || (exit_status != "not recorded" && exit_status != "0")) result = "FAILED"
                                            print "============================================================"
                                            print "MODULE: " module
                                            print "FABRIC: " actual_fabric
                                            print "FABRIC TYPE: " fabric_type
                                            print "SOURCE LOG: " logfile
                                            print "RESULT: " result
                                            print "ANSIBLE EXIT STATUS: " exit_status
                                            print "COMPLETED / OBSERVED TESTS: " completed_count
                                            if (completed_count == 0) print "  (none observed)"
                                            for (i = 1; i <= completed_count; i++) print "  " i ". " completed_names[i]
                                            if (completed_count > 0) print "LAST COMPLETED / OBSERVED: " completed_names[completed_count]
                                            print "FAILED TESTS: " failed_count
                                            if (failed_count == 0) print "  (none detected)"
                                            for (i = 1; i <= failed_count; i++) print "  " i ". " failed_names[i]
                                            print "PENDING / FULLY SKIPPED TESTS: " skipped_count
                                            if (skipped_count == 0) print "  (none observed)"
                                            for (i = 1; i <= skipped_count; i++) print "  " i ". " skipped_names[i]
                                            print "NOT OBSERVED / NOT REACHED TESTS: cannot be determined from this execution log"
                                            print ""
                                        }' "${smlog}" >> "${SKIP_SUMMARY}"
                                done
                                echo "======== MODULE TEST-PROGRESS REPORT -> ${SKIP_SUMMARY} ========"
                                cat "${SKIP_SUMMARY}"

                                if [ "${RUN_FAILURE}" -ne 0 ]; then
                                    echo "❌ One or more Ansible runs failed; all independent runs were attempted" >&2
                                    exit "${RUN_FAILURE}"
                                fi
                            '''
                        }
                        echo "🚀 End of function - ${ndfcConfig.fabric_name}"
                        //parseDeploymentResults(ndfcConfig, failureFlagName)
                    }
                }

                stage("Test ${ndfcConfig.fabric_name}") {
                    // echo timestamp when stage starts
                    echo "⏱ Stage 'Test ${ndfcConfig.fabric_name}' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
                    // Parse results: integration modules first (each has its own PLAY
                    // RECAP + duration), then smoke playbooks.
                    def resultTargets = []
                    // Use the exact gated list passed to the shell. Disabled physical
                    // targets therefore do not create false missing-output failures.
                    def effectiveIntegrationModulesForResults = orderedIntegrationTargets
                    effectiveIntegrationModulesForResults.each { m -> resultTargets.add([m, 'integration']) }
                    if (env.ND_PREREQUISITE_ONLY_EFFECTIVE != 'true') {
                        PLAYBOOK_FILES.each { pb -> resultTargets.add([pb, 'smoke']) }
                    }
                    resultTargets.each { t ->
                        def token = t[0]
                        def testType = t[1]
                        def reportContext = resultContextForTarget(ndfcConfig, token, networkFabricName, vpcPairRows)
                        def testOutputFile = "${COLLECTIONS_DIRECTORY}/test_output_${ndfcConfig.fabric_name}_${ndfcConfig.versionId}_${token}.txt"
                        echo "🔍 Checking for test output file: ${testOutputFile}"
                        if (fileExists(testOutputFile)) {
                            captureModuleActivity(ndfcConfig, token, testType, testRunMarker, reportContext, testOutputFile)
                            echo "📊 Parsing ${testType} results for: ${token}"
                            try {
                                parseTestResults(ndfcConfig, failureFlagName, token, testType, testRunMarker, reportContext)
                            } catch (Exception e) {
                                // Log the error but continue processing the other targets
                                echo "⚠️ Error parsing results for ${token}: ${e.getMessage()}"
                                echo "🔄 Continuing with next target..."
                            }

                            // Archive test output and retain its exact timestamped
                            // filename for the Webex row link.
                            def archivedArtifact = archiveTestOutput(ndfcConfig, token, testRunMarker)
                            if (archivedArtifact) {
                                def artifactLabel = ((testType == 'smoke') ? "${token} (smoke)" : token) + (ndfcConfig.round_tag ?: '')
                                TEST_RESULT_ARTIFACTS_BUF += "\n${artifactLabel} (${reportContext.scope})|${archivedArtifact}"
                            }
                        } else {
                            setFailureFlag(failureFlagName, true)
                            // Preserve the report and skip-list archive even when an
                            // earlier fail-closed guard prevented this target from
                            // starting.  The owner must see NOT_RUN/PENDING instead
                            // of losing every later module from the Webex summary.
                            def missingLabel = ((testType == 'smoke') ? "${token} (smoke)" : token) + (ndfcConfig.round_tag ?: '')
                            TEST_RESULT_SUMMARY_BUF += "\nNOT_RUN|${missingLabel}|${reportContext.fabric}|${ndfcConfig.version}|-|-|-|not reached|output file missing|${reportContext.scope}"
                            def missingActivity = MODULE_ACTIVITY_RESULTS[activityResultKey(ndfcConfig, token, testRunMarker)]
                            missingActivity.result = 'NOT_RUN'
                            missingActivity.failure = 'not reached; current-run output file missing'
                            echo "⚠️ Required test output file not found; recording ${missingLabel} as NOT_RUN: ${testOutputFile}"
                        }
                    }
                    // Archive the module-wise skipped-tests summary and record its link.
                    archiveSkipList(ndfcConfig)
                    echo "\nINTERNAL MODULE TEST RESULTS (CASE COUNTS)\n" +
                        formatResultsTable(moduleCaseSummaryRows(), 'module test cases')
                }
            } catch (Exception e) {
                setFailureFlag(failureFlagName, true)
                echo "❌ ${ndfcConfig.fabric_name} failed on ND ${ndfcConfig.version}: ${e.getMessage()}"
                throw e
            }
        }
    }
}


def generateDynamicInventory(ndfcConfig) {
    env.CURRENT_NDFC_INVENTORY = ''
    def inventoryFileName = "inventory_${ndfcConfig.versionId}.yaml"
    def inventoryDestination = "${COLLECTIONS_DIRECTORY}/${inventoryFileName}"
    def switchesByName = ndfcConfig.switches.collectEntries { [(it.name): it] }
    ['vxlan_leaf_1', 'vxlan_leaf_2', 'vxlan_spine_1', 'vxlan_border_1', 'vxlan_leaf_3', 'vxlan_leaf_4', 'external_edge_1', 'external_edge_2'].each { switchName ->
        if (!switchesByName[switchName]?.ip || !switchesByName[switchName]?.serial ||
            !switchesByName[switchName]?.fabric || !switchesByName[switchName]?.role) {
            error("Incomplete switch topology for ${switchName} in ND ${ndfcConfig.version}")
        }
    }
    // pipeline-utility-steps (writeJSON) is not installed and groovy.json.JsonOutput
    // is blocked by the Groovy script-security sandbox (RejectedAccessException),
    // so build the JSON with sandbox-whitelisted collect/join. Each switch map has a
    // fixed {name, ip, serial, fabric, role} shape of plain-string lab constants, so
    // simple concatenation yields valid JSON (verified to parse identically).
    def switchesJson = '[' + ndfcConfig.switches.collect { s ->
        '{"name":"' + s.name + '","ip":"' + s.ip + '","serial":"' + s.serial +
        '","fabric":"' + s.fabric + '","role":"' + s.role + '"}'
    }.join(',') + ']'
        withEnv(["INVENTORY_FILE_NAME=${inventoryFileName}",
                         "INVENTORY_HOST=${env.ANSIBLE_HOST}",
                         "INVENTORY_PRIMARY_FABRIC=${ndfcConfig.fabric_name}",
                         "INVENTORY_SECONDARY_FABRIC=${ndfcConfig.fabric_name_2}",
                         "INVENTORY_SWITCHES_JSON=${switchesJson}"]) {
                sh '''#!/bin/bash
                        set -euo pipefail
                        umask 077
                        python - <<'PY'
import json
import os

import yaml

switches = json.loads(os.environ["INVENTORY_SWITCHES_JSON"])
by_name = {switch["name"]: switch for switch in switches}
primary_fabric = os.environ["INVENTORY_PRIMARY_FABRIC"]
secondary_fabric = os.environ["INVENTORY_SECONDARY_FABRIC"]

inventory = {
    "all": {
        "vars": {
            "ansible_user": os.environ["NDFC_USER"],
            "ansible_password": os.environ["NDFC_PASSWORD"],
            "ansible_python_interpreter": "python",
            "ansible_httpapi_validate_certs": False,
            "ansible_httpapi_use_ssl": True,
            "ansible_httpapi_login_domain": "local",
            "fabric_name": primary_fabric,
            "ansible_it_fabric": primary_fabric,
            "acl_test_fabric": primary_fabric,
            "nd_test_fabric_name": primary_fabric,
            "nd_test_fabric1_name": primary_fabric,
            "nd_test_fabric2_name": secondary_fabric,
            "nd_fabric_names": [primary_fabric, secondary_fabric],
            "nd_switches": switches,
            "ansible_switch1": by_name["vxlan_leaf_1"]["ip"],
            "ansible_switch2": by_name["vxlan_leaf_2"]["ip"],
            "ansible_sno_1": by_name["vxlan_leaf_1"]["serial"],
            "ansible_sno_2": by_name["vxlan_leaf_2"]["serial"],
            "switch_serial_1": by_name["vxlan_leaf_1"]["serial"],
            "switch_serial_2": by_name["vxlan_leaf_2"]["serial"],
            "switch_serial_3": by_name["vxlan_spine_1"]["serial"],
            "nd_test_switch1_id": by_name["vxlan_border_1"]["serial"],
            "nd_test_switch2_id": by_name["external_edge_1"]["serial"],
            "nd_test_switch1_mgmt_ip": by_name["vxlan_border_1"]["ip"],
            "nd_test_switch2_mgmt_ip": by_name["external_edge_1"]["ip"],
            "nd_test_vpc_pair2_peer1_ip": by_name["vxlan_leaf_3"]["ip"],
            "nd_test_vpc_pair2_peer2_ip": by_name["vxlan_leaf_4"]["ip"],
            "intf_1_2": "Ethernet1/2",
            "intf_1_3": "Ethernet1/3",
            "intf_1_10": "Ethernet1/10",
            "ansible_network_interface1": "Ethernet1/4",
            "nd_test_switch1_interface": "Ethernet1/1",
            "nd_test_switch2_interface": "Ethernet1/3",
            "nd_test_switch1_subif": "Ethernet1/2",
            "nd_test_switch2_subif": "Ethernet1/2",
            "test_groups": ["standalone"],
            "nd_network_test_topology": "standalone",
            "nd_vrf_test_topology": "standalone",
            "ansible_msd_parent_fabric": "",
            "ansible_msd_child_fabric": "",
            "ansible_msd_switch1": "",
            "ansible_mcfg_parent_fabric": "",
            "ansible_mcfg_child_fabric": "",
            "ansible_mcfg_switch1": "",
            "save": True,
            "deploy": True,
            "config_actions_type": "switch",
        },
        "children": {
            "nd": {
                "vars": {
                    "ansible_connection": "ansible.netcommon.httpapi",
                    "ansible_network_os": "cisco.nd.nd",
                },
                "hosts": {
                    "nd_controller": {
                        "ansible_host": os.environ["INVENTORY_HOST"],
                    }
                },
            }
        },
    }
}

with open(os.environ["INVENTORY_FILE_NAME"], "w", encoding="utf-8") as inventory_file:
    yaml.safe_dump(inventory, inventory_file, sort_keys=False)
PY
                '''
        }
    echo "✅ Generated dynamic inventory for NDFC ${ndfcConfig.version} -> ${inventoryFileName}"
    sh """#!/bin/bash
        set -euo pipefail
        [ -f '${inventoryFileName}' ] && [ ! -L '${inventoryFileName}' ] || {
            echo 'Required dynamic inventory is missing or unsafe' >&2
            exit 1
        }
        chmod 600 '${inventoryFileName}'
        [ -s '${inventoryFileName}' ] || {
            echo 'Required dynamic inventory is empty' >&2
            exit 1
        }
        [ ! -d '${inventoryDestination}' ] || {
            echo 'Dynamic inventory destination is unexpectedly a directory' >&2
            exit 1
        }
        mv -- '${inventoryFileName}' '${inventoryDestination}'
        [ -f '${inventoryDestination}' ] && [ ! -L '${inventoryDestination}' ] && [ -s '${inventoryDestination}' ] || {
            echo 'Dynamic inventory installation verification failed' >&2
            exit 1
        }
        chmod 600 '${inventoryDestination}'
    """
    env.CURRENT_NDFC_INVENTORY = inventoryDestination
    echo "Set CURRENT_NDFC_INVENTORY to ${env.CURRENT_NDFC_INVENTORY}"
    sh "ls -l ${env.CURRENT_NDFC_INVENTORY}"
}
