                    if (artifactLinks) {
                        message += "${artifactLinks}\n"
                    } else {
                        message += "- No per-module artifacts were captured\n"
                    }

                    if (lintSummary) {
                        message += "\n─────────\n"
                        message += "🧹 **Ansible-lint Results:**\n${lintSummary}\n"
                    }
                    if (skippedTestLinks) {
                        message += "${skippedTestLinks}\n"
                    }
                    if ((env.LOG_BUNDLE_FILE ?: '').trim()) {
                        message += "📦 [All logs (zip)](${JOB_URL}${BUILD_NUMBER}/artifact/${env.LOG_BUNDLE_FILE})\n"
                    }
                    if ((env.MODULE_ACTIVITY_REPORT_FILE ?: '').trim()) {
                        message += "📋 [Module test activity table](${JOB_URL}${BUILD_NUMBER}/artifact/${env.MODULE_ACTIVITY_REPORT_FILE})\n"
                    }
                    message += "⏱️ **Total run duration:** ${runDuration}"

                    // Build once and split the complete report; retain every link.
                    final int WEBEX_SAFE_MESSAGE_LIMIT = 7000
                    def fullMessageLength = message.length()
                    echo "NDP_WEBEX_REPORT_SIZE: characters=${fullMessageLength} part_limit=${WEBEX_SAFE_MESSAGE_LIMIT}"
                    echo "📨 Webex notification before delivery (${fullMessageLength} characters):\n${message}"

                    def continuationHeader = "${notificationTitle} - Build ${BUILD_NUMBER}\n" +
                        "🌿 ansible-nd branch: ${selectedBranch}\n" +
                        "🔖 ansible-nd commit: ${selectedCommit}\n\n"
                    def notificationMessages = splitWebexMessage(message, continuationHeader, WEBEX_SAFE_MESSAGE_LIMIT)
                    sendWebexNotificationMessages(notificationMessages)
                } catch (Exception e) {
                    rethrowIfInterrupt(e)
                    echo "NDP_DETAILED_NOTIFICATION_FAILED: ${e.getClass().getName()}; revision=${ND_REPORTING_REVISION}; attempting a minimal build notification"
                    try {
                        sendWebexNotificationMessages([minimalBuildNotification(e.getClass().getName())])
                    } catch (Exception fallbackError) {
                        rethrowIfInterrupt(fallbackError)
                        echo "NDP_WEBEX_NOTIFICATION_FAILED: ${fallbackError.getClass().getName()}; see this build console"
                    }
                } finally {
                    // No FilePath is needed here; cleanup may already have removed it.
                    try {
                        echo "\nFINAL MODULE TEST ACTIVITY TABLE\n" +
                            formatModuleActivityTable(MODULE_ACTIVITY_RESULTS.values().toList(), BUILD_NUMBER)
                    } catch (Exception activityError) {
                        rethrowIfInterrupt(activityError)
                        echo "NDP_FINAL_ACTIVITY_TABLE_UNAVAILABLE: ${activityError.getClass().getName()}; original artifacts remain authoritative"
                    }
                }
            }
        }
        cleanup {
            script {
                // Also runs after early fail-closed Consul errors, when the normal
                // end-of-stage cleanup is bypassed. This prevents partially
                // downloaded inventories or other required files from persisting.
                // cleanWs() needs a workspace/FilePath; under the Docker agent that
                // context is gone in post{}, so keep it best-effort.
                try {
                    echo "🧹 Final workspace cleanup (including partial Consul downloads)"
                    cleanWs()
                } catch (Exception e) {
                    rethrowIfInterrupt(e)
                    echo "⚠️ Final cleanup skipped (no workspace context in post): ${e.getMessage()}"
                }
            }
        }
    }
}

// Keep delivery independent from detailed tables, timings and case aggregation.
// This helper performs no shell work and remains usable after workspace cleanup.
def sendWebexNotificationMessages(messages) {
    def webexRoomId = (env.WEBEX_ROOM_ID ?: '').toString().trim()
    if (!webexRoomId || webexRoomId.toLowerCase() in ['null', 'undefined'] ||
        webexRoomId.contains('${') || webexRoomId.contains('{{')) {
        error('NDP_WEBEX_ROOM_INVALID: WEBEX_ROOM_ID did not resolve to a room. Check the declared WEBEX_ROOM_ID_PUBLIC / WEBEX_ROOM_ID_PRIVATE names and the selected environment line.')
    }
    for (int messageIndex = 0; messageIndex < messages.size(); messageIndex++) {
        def notificationMessage = messages[messageIndex]
        // ASCII-only JSON also preserves emoji when the HTTP client uses a legacy charset.
        def payload = writeReportingJson([roomId: webexRoomId,
            markdown: notificationMessage.toString()])
        withCredentials([string(credentialsId: 'ANSIBLE_WEBEX_TOKEN', variable: 'WEBEX_TOKEN')]) {
            def authorizationHeader = 'Bearer ' + env.WEBEX_TOKEN
            def resp = httpRequest(
                url: 'https://webexapis.com/v1/messages',
                httpMode: 'POST', contentType: 'APPLICATION_JSON_UTF8',
                customHeaders: [[name: 'Authorization', value: authorizationHeader, maskValue: true]],
                requestBody: payload, validResponseCodes: '100:599', timeout: 45
            )
            if (resp.status == 200) {
                echo "NDP_WEBEX_NOTIFICATION_SENT: part ${messageIndex + 1}/${messages.size()} (HTTP ${resp.status})"
            } else if (resp.status == 404) {
                error('NDP_WEBEX_ROOM_UNAVAILABLE: Webex returned HTTP 404. Check the selected room constant and that the Webex bot belongs to that room.')
            } else {
                error("Webex notification returned HTTP ${resp.status}")
            }
        }
    }
}

def minimalBuildNotification(exceptionClass = 'unavailable') {
    def versions = (env.ACTIVE_DCNM_VERSIONS ?: '4.3').toString().trim().take(80)
    def rounds = (env.ACTIVE_FABRIC_ROUNDS ?: '').toString().trim().take(80)
    def roundsSuffix = rounds ? " (${rounds})" : ''
    def customNote = (params.WEBEX_CUSTOM_MESSAGE ?: '').toString().trim().take(1200).replaceAll('[\\uD800-\\uDBFF]$', '')
    def branch = ((env.ND_GIT_SELECTION ?: env.ND_GIT_BRANCH ?: params.ND_GIT_BRANCH ?: 'develop').toString().trim() ?: 'develop').take(200)
    def commit = (env.ND_GIT_COMMIT ?: 'unavailable').toString().trim().take(80)
    // Accept only a bounded Java class name, never an exception body or token.
    def failureClass = (exceptionClass ?: 'unavailable').toString().take(200)
    if (!(failureClass ==~ /[A-Za-z0-9_.$]+/)) { failureClass = 'unavailable' }
    "ND ${versions}${roundsSuffix} NIGHTLY NOTIFICATION - Build ${BUILD_NUMBER}\n" +
        (customNote ? "${customNote}\n\n" : '') +
        "Branch: ${branch}\nCommit: ${commit}\n" +
        "Build result: ${currentBuild.currentResult}\n" +
        "Reporting revision: ${ND_REPORTING_REVISION}\n" +
        "Detailed reporting error class: ${failureClass}\n" +
        'Detailed reporting was unavailable. Test-case counts are unknown in this fallback.\n' +
        "Console: ${JOB_URL}${BUILD_NUMBER}/console\n" +
        "Artifacts: ${JOB_URL}${BUILD_NUMBER}/artifact/"
}

/**
 * Runs ansible-lint with production profile and reports results
 */
def runLintCheck() {
    stage('Run Lint Check') {
            echo "⏱ Running lint check..."
            withCleanupPreservingFailure({
            sh '''#!/bin/bash
            set -euo pipefail
            printf '%s\n' 'Lint did not complete; see the build console.' > "${BASE_DIRECTORY}/lint_summary.txt"
            [ -n "${ND_GIT_COMMIT:-}" ] || { echo 'Pinned collection commit is required' >&2; exit 1; }
            # A reused checkout contains operational files from earlier builds.
            # Use a separate index to export exactly the pinned commit, without
            # modifying the real index or honoring export-ignore attributes.
            lint_root=$(mktemp -d "${WORKSPACE}/nd_lint.XXXXXX")
            trap 'rm -rf -- "$lint_root"' EXIT
            lint_source="${lint_root}/ansible_collections/cisco/nd"
            mkdir -p "$lint_source"
            GIT_INDEX_FILE="${lint_root}/index" git -C "$COLLECTIONS_DIRECTORY" read-tree "$ND_GIT_COMMIT"
            GIT_INDEX_FILE="${lint_root}/index" git -C "$COLLECTIONS_DIRECTORY" checkout-index --all --prefix="${lint_source}/"
            cd "$lint_source"
            unset ANSIBLE_CONFIG
            export ANSIBLE_COLLECTIONS_PATH="$lint_root"
            
            # Activate venv
            source $HOME/ansible/venv/bin/activate
            
            # Run ansible-lint with production profile and capture output
            echo "🔍 Running ansible-lint with production profile..."
            LINT_STATUS=0
            LINT_OUTPUT=$(ansible-lint -c "$lint_source/.ansible-lint" --project-dir "$lint_source" --profile=production 2>&1) || LINT_STATUS=$?
            printf '%s\n' "$LINT_OUTPUT" > "${WORKSPACE}/ansible_lint_build_${BUILD_NUMBER}.txt"
            
            # Process the output to extract and format the summary
            if [ "$LINT_STATUS" -ne 0 ]; then
                # Full rule-violation table -> keep in the console log for debugging.
                SUMMARY_BLOCK=$(echo "$LINT_OUTPUT" | awk '/^# Rule Violation Summary/{f=1;next} /^Failed:/{print;exit} f')
                echo "# Rule Violation Summary"
                echo "$SUMMARY_BLOCK"

                # Single totals line, without the trailing "Profile ... required." text.
                FAILED_LINE=$(echo "$LINT_OUTPUT" | grep '^Failed:' | head -1 | sed 's/ Profile.*$//')
                FAILURE_COUNT=$(echo "$LINT_OUTPUT" | grep '^Failed:' | awk '{print $2}')
                echo ""
                echo "❌ Lint check failed with $FAILURE_COUNT violations"

                # Notification gets ONLY the single totals line (kept minimal); the full
                # rule table stays in the console log above for debugging.
                echo "$FAILED_LINE" > "${BASE_DIRECTORY}/lint_summary.txt"
                exit 1
            else
                echo "✅ ansible-lint check passed with no violations"
                echo "✅ ansible-lint check passed with no violations" > "${BASE_DIRECTORY}/lint_summary.txt"
            fi
            '''
            }, {
                // Capture the lint summary (pass OR fail) in Pipeline state so the post{} Webex
                // notification can include it; the Docker-agent workspace is gone by
                // post time, so it cannot be read from a file there.
                try {
                    def lintFilePath = "${BASE_DIRECTORY}/lint_summary.txt"
                    if (fileExists(lintFilePath)) {
                        LINT_SUMMARY_BUF = readFile(lintFilePath).trim().take(2000)
                    }
                } catch (Exception e) {
                    rethrowIfInterrupt(e)
                    echo "⚠️ Could not capture lint summary: ${e.getMessage()}"
                }
                try {
                    archiveArtifacts artifacts: "ansible_lint_build_${BUILD_NUMBER}.txt", allowEmptyArchive: true
                } catch (Exception e) {
                    rethrowIfInterrupt(e)
                    env.PIPELINE_FAILED = 'true'
                    echo "NDP_LINT_ARCHIVE_FAILED: ${e.getClass().getName()}"
                }
            })
    }
}

/**
 * Sets a failure flag in the Jenkins environment.
 * @param flagName The name of the failure flag.
 * @param value Boolean indicating failure (true) or success (false).
 */
def setFailureFlag(flagName, value) {
    // Use Jenkins environment variables to track failure flags
    env."${flagName}" = value.toString()
}

/**
 * Checks if a failure flag is set in the Jenkins environment.
 * @param flagName The name of the failure flag.
 * @return true if failure flag is set to 'true', false otherwise.
 */
def isFailureFlagSet(flagName) {
    return env."${flagName}"?.toBoolean() ?: false
}

/**
 * Re-throw pipeline aborts/timeouts (build timeout or user abort) so a broad
 * catch (Exception e) can never swallow an interrupt and let a wedged build run on.
 */
def rethrowIfInterrupt(e) {
    if (e instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException ||
        e instanceof InterruptedException) {
        throw e
    }
}

// Keep a primary failure while cleanup still runs; a later interrupt takes
// precedence over an ordinary failure. This is CPS code and may call steps.
def withCleanupPreservingFailure(Closure work, Closure cleanup) {
    def primaryFailure = null
    try {
        return work.call()
    } catch (Exception e) {
        primaryFailure = e
        throw e
    } finally {
        try {
            cleanup.call()
        } catch (Exception secondaryFailure) {
            if (primaryFailure != null) {
                rethrowIfInterrupt(primaryFailure)
                rethrowIfInterrupt(secondaryFailure)
                throw primaryFailure
            }
            throw secondaryFailure
        }
    }
}

/**
 * Verifies that an inventory file exists and provides helpful error messages if not.
 * @param inventoryPath The full path to the inventory file to verify.
 * @return true if file exists, throws error if not found.
 */
def verifyInventoryFile(inventoryPath) {
    def fileExists = sh(
        script: """
            if [ -f "${inventoryPath}" ]; then
                echo "✅ Inventory file verified: ${inventoryPath}"
                exit 0
            else
                echo "⚠️ Inventory file not found: ${inventoryPath}"
                echo "📂 Available inventory files in ${COLLECTIONS_DIRECTORY}:"
                ls -l ${COLLECTIONS_DIRECTORY}/inventory*.yaml 2>/dev/null || echo "No inventory files found"
                exit 1
            fi
        """,
        returnStatus: true
    )

    if (fileExists != 0) {
        error("Inventory file not found: ${inventoryPath}")
    }
    return true
}

/**
 * Archives test output file with timestamp and cleans up workspace.
 * @param ndfcConfig The NDFC configuration object.
 * @param playbookName The name of the playbook (e.g., 'dcnm_policy.yaml').
 */
// Bounded reporting JSON only. Uses plain maps/lists and ordinary sandbox
// methods; no JSON plugin, reflective evaluation, or custom class is required.
// NonCPS avoids a Pipeline checkpoint for each character. Sandbox checks still
// apply. Never call Pipeline steps from these helpers.
@com.cloudbees.groovy.cps.NonCPS
def parseReportingJson(input) {
    if (!(input instanceof String) || input.length() > 8388608 ||
        input.getBytes('UTF-8').length > 8388608) {
        throw new Exception('Reporting JSON must be a string of at most 8 MiB')
    }
    def state = [text: input, pos: 0, tokens: 0]
    def result = reportingJsonReadValue(state, 0)
    reportingJsonWhitespace(state)
    if (state.pos != input.length()) {
        throw new Exception('Reporting JSON contains trailing data at offset ' + state.pos)
    }
    return result
}

@com.cloudbees.groovy.cps.NonCPS
def reportingJsonWhitespace(state) {
    while (state.pos < state.text.length()) {
        int code = (int) state.text.charAt(state.pos)
        if (code != 32 && code != 9 && code != 10 && code != 13) { break }
        state.pos++
    }
}

@com.cloudbees.groovy.cps.NonCPS
def reportingJsonCount(state, depth) {
    state.tokens++
    if (depth > 48 || state.tokens > 200000) {
        throw new Exception('Reporting JSON exceeds its nesting or token limit')
    }
}

@com.cloudbees.groovy.cps.NonCPS
def reportingJsonReadValue(state, depth) {
    reportingJsonCount(state, depth)
    reportingJsonWhitespace(state)
    if (state.pos >= state.text.length()) {
        throw new Exception('Reporting JSON ends before a value')
    }
    int code = (int) state.text.charAt(state.pos)
    if (code == 34) { return reportingJsonReadString(state) }
    if (code == 123) {
        state.pos++
        def result = [:]
        reportingJsonWhitespace(state)
        if (state.pos < state.text.length() && state.text.charAt(state.pos) == (char) 125) {
            state.pos++
            return result
        }
        while (true) {
            reportingJsonWhitespace(state)
            if (state.pos >= state.text.length() || state.text.charAt(state.pos) != (char) 34) {
                throw new Exception('Reporting JSON object requires a quoted key at offset ' + state.pos)
            }
            reportingJsonCount(state, depth)
            def key = reportingJsonReadString(state)
            if (result.containsKey(key)) { throw new Exception('Reporting JSON contains a duplicate key') }
            reportingJsonWhitespace(state)
            if (state.pos >= state.text.length() || state.text.charAt(state.pos) != (char) 58) {
                throw new Exception('Reporting JSON object requires a colon at offset ' + state.pos)
            }
            state.pos++
            result[key] = reportingJsonReadValue(state, depth + 1)
            reportingJsonWhitespace(state)
            if (state.pos >= state.text.length()) { throw new Exception('Reporting JSON object is incomplete') }
            int separator = (int) state.text.charAt(state.pos)
            state.pos++
            if (separator == 125) { return result }
            if (separator != 44) { throw new Exception('Reporting JSON object requires a comma') }
        }
    }
    if (code == 91) {
        state.pos++
        def result = []
        reportingJsonWhitespace(state)
        if (state.pos < state.text.length() && state.text.charAt(state.pos) == (char) 93) {
            state.pos++
            return result
        }
        while (true) {
            result.add(reportingJsonReadValue(state, depth + 1))
            reportingJsonWhitespace(state)
            if (state.pos >= state.text.length()) { throw new Exception('Reporting JSON array is incomplete') }
            int separator = (int) state.text.charAt(state.pos)
            state.pos++
            if (separator == 93) { return result }
            if (separator != 44) { throw new Exception('Reporting JSON array requires a comma') }
        }
    }
    if (state.text.startsWith('true', state.pos)) { state.pos += 4; return true }
    if (state.text.startsWith('false', state.pos)) { state.pos += 5; return false }
    if (state.text.startsWith('null', state.pos)) { state.pos += 4; return null }
    if (code == 45 || (code >= 48 && code <= 57)) { return reportingJsonReadNumber(state) }
    throw new Exception('Reporting JSON contains an invalid value at offset ' + state.pos)
}

@com.cloudbees.groovy.cps.NonCPS
def reportingJsonHexUnit(state) {
    if (state.pos + 4 > state.text.length()) { throw new Exception('Reporting JSON unicode escape is incomplete') }
    int value = 0
    def digits = '0123456789abcdef'
    for (int i = 0; i < 4; i++) {
        def digit = state.text.substring(state.pos, state.pos + 1).toLowerCase()
        int index = digits.indexOf(digit)
        if (index < 0) { throw new Exception('Reporting JSON unicode escape is invalid') }
        value = value * 16 + index
        state.pos++
    }
    return value
}

@com.cloudbees.groovy.cps.NonCPS
def reportingJsonReadString(state) {
    state.pos++
    def result = new StringBuilder()
    while (state.pos < state.text.length()) {
        int code = (int) state.text.charAt(state.pos)
        state.pos++
        if (code == 34) { return result.toString() }
        if (code == 92) {
            if (state.pos >= state.text.length()) { throw new Exception('Reporting JSON escape is incomplete') }
            int escaped = (int) state.text.charAt(state.pos)
            state.pos++
            if (escaped == 34 || escaped == 92 || escaped == 47) { code = escaped }
            else if (escaped == 98) { code = 8 }
            else if (escaped == 102) { code = 12 }
            else if (escaped == 110) { code = 10 }
            else if (escaped == 114) { code = 13 }
            else if (escaped == 116) { code = 9 }
            else if (escaped == 117) {
                code = reportingJsonHexUnit(state)
                if (code >= 55296 && code <= 56319) {
                    if (state.pos + 2 > state.text.length() ||
                        !state.text.startsWith('\\u', state.pos)) {
                        throw new Exception('Reporting JSON high surrogate requires a low surrogate')
                    }
                    state.pos += 2
                    int low = reportingJsonHexUnit(state)
                    if (low < 56320 || low > 57343) { throw new Exception('Reporting JSON low surrogate is invalid') }
                    result.append((char) code)
                    result.append((char) low)
                    continue
                }
                if (code >= 56320 && code <= 57343) {
                    throw new Exception('Reporting JSON contains an unpaired low surrogate')
                }
            } else { throw new Exception('Reporting JSON escape is invalid') }
        } else {
            if (code < 32) { throw new Exception('Reporting JSON string contains an unescaped control character') }
            if (code >= 55296 && code <= 56319) {
                if (state.pos >= state.text.length()) {
                    throw new Exception('Reporting JSON string contains an unpaired high surrogate')
                }
                int low = (int) state.text.charAt(state.pos)
                if (low < 56320 || low > 57343) { throw new Exception('Reporting JSON string contains an unpaired high surrogate') }
                state.pos++
                result.append((char) code)
                result.append((char) low)
                continue
            }
            if (code >= 56320 && code <= 57343) {
                throw new Exception('Reporting JSON string contains an unpaired low surrogate')
            }
        }
        result.append((char) code)
    }
    throw new Exception('Reporting JSON string is incomplete')
}

@com.cloudbees.groovy.cps.NonCPS
def reportingJsonReadNumber(state) {
    int start = state.pos
    while (state.pos < state.text.length()) {
        int code = (int) state.text.charAt(state.pos)
        if ((code >= 48 && code <= 57) || code == 45 || code == 43 ||
            code == 46 || code == 69 || code == 101) { state.pos++ }
        else { break }
        if (state.pos - start > 256) { throw new Exception('Reporting JSON numeric token exceeds its limit') }
    }
    def token = state.text.substring(start, state.pos)
    if (!(token ==~ /-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?/)) {
        throw new Exception('Reporting JSON numeric token is invalid')
    }
    if (!token.contains('.') && !token.contains('e') && !token.contains('E')) {
        try { return token.toLong() }
        catch (Exception ignored) { throw new Exception('Reporting JSON integer is outside the supported 64-bit range') }
    }
    def number = token.toDouble()
    if (number.toString() in ['NaN', 'Infinity', '-Infinity']) {
        throw new Exception('Reporting JSON number must be finite')
    }
    return number
}

@com.cloudbees.groovy.cps.NonCPS
def writeReportingJson(value) {
    def state = [tokens: 0, out: new StringBuilder()]
    reportingJsonWriteValue(value, state, 0)
    return state.out.toString()
}

@com.cloudbees.groovy.cps.NonCPS
def reportingJsonAppend(state, text) {
    if (state.out.length() + text.length() > 8388608) {
        throw new Exception('Reporting JSON output exceeds 8 MiB')
    }
    state.out.append(text)
}

@com.cloudbees.groovy.cps.NonCPS
def reportingJsonWriteString(text, state) {
    // Output is ASCII JSON, so the character limit is also a byte limit.
    reportingJsonAppend(state, '"')
    def digits = '0123456789abcdef'
    for (int i = 0; i < text.length(); i++) {
        int code = (int) text.charAt(i)
        if (code == 34) { reportingJsonAppend(state, '\\"') }
        else if (code == 92) { reportingJsonAppend(state, '\\\\') }
        else if (code < 32 || code > 126) {
            if (code >= 55296 && code <= 56319) {
                if (i + 1 >= text.length()) { throw new Exception('Reporting JSON input contains an unpaired high surrogate') }
                int low = (int) text.charAt(i + 1)
                if (low < 56320 || low > 57343) { throw new Exception('Reporting JSON input contains an unpaired high surrogate') }
            } else if (code >= 56320 && code <= 57343) {
                if (i == 0) { throw new Exception('Reporting JSON input contains an unpaired low surrogate') }
                int high = (int) text.charAt(i - 1)
                if (high < 55296 || high > 56319) { throw new Exception('Reporting JSON input contains an unpaired low surrogate') }
            }
            def escaped = new StringBuilder('\\u')
            escaped.append(digits.charAt((code >> 12) & 15))
            escaped.append(digits.charAt((code >> 8) & 15))
            escaped.append(digits.charAt((code >> 4) & 15))
            escaped.append(digits.charAt(code & 15))
            reportingJsonAppend(state, escaped.toString())
        } else { reportingJsonAppend(state, text.substring(i, i + 1)) }
    }
    reportingJsonAppend(state, '"')
}

@com.cloudbees.groovy.cps.NonCPS
def reportingJsonWriteValue(value, state, depth) {
    reportingJsonCount(state, depth)
    if (value == null) { reportingJsonAppend(state, 'null') }
    else if (value instanceof Boolean) { reportingJsonAppend(state, value ? 'true' : 'false') }
    else if (value instanceof String || value instanceof GString) {
        reportingJsonWriteString(value.toString(), state)
    } else if (value instanceof Number) {
        def token = value.toString()
        if (token.length() > 256 ||
            !(token ==~ /-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?/)) {
            throw new Exception('Reporting JSON requires a finite number')
        }
        reportingJsonAppend(state, token)
    } else if (value instanceof Map) {
        reportingJsonAppend(state, '{')
        boolean first = true
        def seen = [:]
        for (def entry : value.entrySet()) {
            def key = entry.key
            if (!(key instanceof String) && !(key instanceof GString)) {
                throw new Exception('Reporting JSON object keys must be strings')
            }
            key = key.toString()
            if (seen.containsKey(key)) { throw new Exception('Reporting JSON contains a duplicate encoded key') }
            seen[key] = true
            reportingJsonCount(state, depth)
            if (!first) { reportingJsonAppend(state, ',') }
            first = false
            reportingJsonWriteString(key, state)
            reportingJsonAppend(state, ':')
            reportingJsonWriteValue(entry.value, state, depth + 1)
        }
        reportingJsonAppend(state, '}')
    } else if (value instanceof List) {
        reportingJsonAppend(state, '[')
        boolean first = true
        for (def item : value) {
            if (!first) { reportingJsonAppend(state, ',') }
            first = false
            reportingJsonWriteValue(item, state, depth + 1)
        }
        reportingJsonAppend(state, ']')
    } else { throw new Exception('Reporting JSON contains an unsupported value type') }
}

// Reporting owns files and receipts while execution owns every fabric mutation.
// Aggregate Groovy state only after both branches have terminated.
def prepareStructuredReporting() {
    echo "NDP_REPORTING_REVISION: ${ND_REPORTING_REVISION}"
    def buildToken = (env.BUILD_TAG ?: "nd-${BUILD_NUMBER}").replaceAll(/[^A-Za-z0-9_.-]/, '_')
    // Isolate Python bytecode reads and writes from workspace caches.
    env.PYTHONPYCACHEPREFIX = "/tmp/nd-python-cache-${buildToken}"
    env.ND_REPORTING_RELATIVE_ROOT = "nd_reporting_${buildToken}"
    env.ND_REPORTING_ROOT = "${env.WORKSPACE}/${env.ND_REPORTING_RELATIVE_ROOT}"
    env.ND_REPORTING_TOOLS = "${env.ND_REPORTING_ROOT}/tools"
    env.ND_REPORTING_BUILD_RUN = buildToken
    env.ND_RUNTIME_INPUTS = "${env.ND_REPORTING_ROOT}/runtime-inputs"
    env.ND_RUNTIME_INPUTS_READY = 'false'
    sh '''#!/bin/bash
        set -euo pipefail
        mkdir -p -- "$ND_REPORTING_TOOLS"
    '''
    // Load the embedded, hash-verified helper set. No reporting-helper Consul
    // keys are needed; both rounds and the publisher keep one immutable version.
    ['nd_report.py', 'nd_result_summary.py', 'nd_test_activity.py', 'nd_reporting_pipeline.py'].each { name ->
        downloadFromConsul(name, "${env.ND_REPORTING_RELATIVE_ROOT}/tools/${name}")
    }
    sh '''#!/bin/bash
        set -euo pipefail
        "$HOME/ansible/venv/bin/python" "$ND_REPORTING_TOOLS/nd_reporting_pipeline.py" init \\
            --root "$ND_REPORTING_ROOT" --workspace "$WORKSPACE" \\
            --build "$BUILD_NUMBER" --run-id "$ND_REPORTING_BUILD_RUN"
    '''
}

// Fetch canonical inputs once; each round receives a fresh copy before rendering.
def prepareRuntimeInputs() {
    def files = (CONSUL_CONFIG_FILES + PLAYBOOK_FILES + CONSUL_RUNNER_FILES +
        CONSUL_PREREQUISITE_FILES + CONSUL_PREREQUISITE_SUPPORT_FILES + CONSUL_PREFLIGHT_FILES).unique()
    files.each { name ->
        // Publish the guard and its action together without changing older jobs' guard.
        def sourceKey = CONSUL_PREFLIGHT_FILES.contains(name) ? "${SWITCH_LIFECYCLE_CONSUL_PREFIX}/${name}" : name
        downloadFromConsul(sourceKey, "${env.ND_REPORTING_RELATIVE_ROOT}/runtime-inputs/${name}")
    }
    env.ND_RUNTIME_INPUTS_READY = 'true'
}

def registerStructuredExecutions(ndfcConfig, targets, runId, networkFabricName, pairRows) {
    def plan = [build: BUILD_NUMBER.toString(), run_id: runId, version: ndfcConfig.version,
        version_id: ndfcConfig.versionId, round_label: ndfcConfig.round_label,
        fabric_name: ndfcConfig.fabric_name,
        targets: targets.collect { target ->
            def context = resultContextForTarget(ndfcConfig, target[0], networkFabricName, pairRows)
            [module: target[0], test_type: target[1], scope: context.scope, fabric: context.fabric]
        }]
    def planFile = "${env.ND_REPORTING_RELATIVE_ROOT}/plan_${ndfcConfig.versionId}.json"
    // Jenkins writeFile runs as the host agent account. Stage in the writable
    // workspace root; only the container shell writes the root-owned report tree.
    def stagedPlanFile = "nd_reporting_plan_${ndfcConfig.versionId}.json"
    def registration = withEnv(["ND_REPORT_PLAN=${env.WORKSPACE}/${planFile}",
                                "ND_REPORT_STAGED_PLAN=${env.WORKSPACE}/${stagedPlanFile}"]) {
        withCleanupPreservingFailure({
            writeFile file: stagedPlanFile, text: writeReportingJson(plan)
            return sh(script: '''#!/bin/bash
                set -euo pipefail
                "$HOME/ansible/venv/bin/python" - <<'PY'
import os
from pathlib import Path

workspace = Path(os.environ['WORKSPACE']).resolve()
root = Path(os.environ['ND_REPORTING_ROOT'])
staged = Path(os.environ['ND_REPORT_STAGED_PLAN'])
target = Path(os.environ['ND_REPORT_PLAN'])
if staged.parent.resolve() != workspace or staged.is_symlink() or not staged.is_file():
    raise ValueError('Reporting plan staging file is missing or unsafe')
if (root.is_symlink() or not root.resolve().is_relative_to(workspace)
        or target.parent != root or target.is_symlink() or target.is_dir()):
    raise ValueError('Reporting plan destination is unsafe')
os.replace(staged, target)
PY
                "$HOME/ansible/venv/bin/python" "$ND_REPORTING_TOOLS/nd_reporting_pipeline.py" register \\
                    --root "$ND_REPORTING_ROOT" --plan "$ND_REPORT_PLAN" \\
                    --collection-root "$COLLECTIONS_DIRECTORY"
            ''', returnStdout: true).trim()
        }, {
            // Also remove a staged plan when installation or registration fails.
            def cleanupStatus = sh(script: '''#!/bin/bash
                rm -f -- "$ND_REPORT_STAGED_PLAN"
            ''', returnStatus: true)
            if (cleanupStatus != 0) {
                echo 'NDP_REPORT_PLAN_STAGE_CLEANUP_FAILED: see the build console'
                env.PIPELINE_FAILED = 'true'
            }
        })
    }
    def registered = parseReportingJson(registration)
    if (!registered.log_dir || !registered.log_dir.toString().startsWith("${env.ND_REPORTING_ROOT}/executions/")) {
        error('Structured reporting returned an unsafe execution directory')
    }
    registered.log_dir.toString()
}

def finishStructuredExecution(status) {
    def recovery = (env.ND_HOME_RECOVERY_STATUS ?: 'unverified').toString()
    if (!(recovery in ['confirmed', 'failed', 'not_required', 'unverified'])) { recovery = 'unverified' }
    echo "NDP_EXECUTION_BRANCH_FINISHED: status_scope=execution_branch execution_status=${status} home_recovery_status=${recovery}"
    withEnv(["ND_REPORT_PRODUCER_STATUS=${status}", "ND_REPORT_HOME_RECOVERY_STATUS=${recovery}"]) {
        sh '''#!/bin/bash
            set -euo pipefail
            "$HOME/ansible/venv/bin/python" "$ND_REPORTING_TOOLS/nd_reporting_pipeline.py" finish \\
                --root "$ND_REPORTING_ROOT" --status "$ND_REPORT_PRODUCER_STATUS" \\
                --home-recovery-status "$ND_REPORT_HOME_RECOVERY_STATUS"
        '''
    }
}

def publishStructuredArtifacts() {
    try {
        while (true) {
            // The wait happens on the agent in a durable foreground step. It
            // returns only bounded metadata, never an entire execution log.
            def nextJson = sh(script: '''#!/bin/bash
                set -euo pipefail
                "$HOME/ansible/venv/bin/python" "$ND_REPORTING_TOOLS/nd_reporting_pipeline.py" next \\
                    --root "$ND_REPORTING_ROOT" --wait --timeout 36000 \\
                    --parse-timeout 600 --drain-timeout 1800
            ''', returnStdout: true).trim()
            def next = parseReportingJson(nextJson)
            if (next.done) { break }
            if (!next.execution) { continue }
            def execution = next.execution
            def files = execution.files ?: []
            // Publish only the single readable module log; queue evidence stays internal.
            if (!execution.id || files.size() != 1 || files.any { name ->
                !(name.toString() ==~ /^test_output_[A-Za-z0-9_.-]+[.]txt$/)
            }) {
                error('Refusing an invalid structured artifact descriptor')
            }
            def started = System.currentTimeMillis()
            def status = 'failed'
            withCleanupPreservingFailure({
                try {
                    timeout(time: 15, unit: 'MINUTES') {
                        retry(2) {
                            archiveArtifacts artifacts: files.join(','), allowEmptyArchive: false, fingerprint: true
                        }
                    }
                    status = 'success'
                    echo "NDP_MODULE_ARTIFACT_PUBLISHED: ${execution.id}"
                } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException interruption) {
                    // Local and enclosing timeout causes share this exception type.
                    // Preserve every interruption; failFast:false keeps fabric recovery
                    // independent and final reconciliation records pending artifacts.
                    echo "NDP_MODULE_ARTIFACT_INTERRUPTED: ${execution.id}; see Jenkins interruption cause"
                    throw interruption
                } catch (Exception uploadError) {
                    rethrowIfInterrupt(uploadError)
                    echo "NDP_MODULE_ARTIFACT_FAILED: ${execution.id}; ${uploadError.getClass().getName()}"
                }
            }, {
                def seconds = (System.currentTimeMillis() - started) / 1000.0
                withEnv(["ND_REPORT_EXECUTION_ID=${execution.id}", "ND_REPORT_ARCHIVE_STATUS=${status}",
                         "ND_REPORT_ARCHIVE_SECONDS=${seconds}", "ND_REPORT_ARCHIVE_ATTEMPT=${execution.attempt}"]) {
                    sh '''#!/bin/bash
                        set -euo pipefail
                        "$HOME/ansible/venv/bin/python" "$ND_REPORTING_TOOLS/nd_reporting_pipeline.py" ack \\
                            --root "$ND_REPORTING_ROOT" --id "$ND_REPORT_EXECUTION_ID" \\
                            --status "$ND_REPORT_ARCHIVE_STATUS" --seconds "$ND_REPORT_ARCHIVE_SECONDS" --attempt "$ND_REPORT_ARCHIVE_ATTEMPT"
                    '''
                }
            })
        }
    } catch (Exception reporterError) {
        try {
            sh '''#!/bin/bash
                "$HOME/ansible/venv/bin/python" "$ND_REPORTING_TOOLS/nd_reporting_pipeline.py" reporter-failed \\
                    --root "$ND_REPORTING_ROOT"
            '''
        } catch (Exception ignored) {
            rethrowIfInterrupt(reporterError)
            rethrowIfInterrupt(ignored)
            echo 'NDP_REPORTER_TERMINAL_WRITE_FAILED: final reconciliation will detect missing archive receipts'
        }
        rethrowIfInterrupt(reporterError)
        // failFast:false keeps the complete execution/recovery lifecycle alive.
        echo "NDP_REPORTER_FAILED: ${reporterError.getClass().getName()}; final reconciliation is required"
    }
}

def foldStructuredResults() {
    sh '''#!/bin/bash
        set -euo pipefail
        "$HOME/ansible/venv/bin/python" "$ND_REPORTING_TOOLS/nd_reporting_pipeline.py" aggregate \\
            --root "$ND_REPORTING_ROOT" --output "$ND_REPORTING_ROOT/aggregate.json"
    '''
    def report = parseReportingJson(
        readFile(file: "${env.ND_REPORTING_RELATIVE_ROOT}/aggregate.json"))
    TEST_RESULT_ARTIFACTS_BUF = ''
    SKIPLIST_FILES_BUF = ''
    SKIPLIST_DETAILS_BUF = ''
    // Keep bounded round setup failures recorded before any module could register.
    (report.rows ?: []).each { row ->
        def key = "${row.version_id}|${row.module}|${row.run_id}".toString()
        MODULE_ACTIVITY_RESULTS[key] = row
        PHASE_TIMING_RESULTS[key] = row.phase_seconds ?: [:]
        if (row.artifact && row.archive_status == 'success') {
            TEST_RESULT_ARTIFACTS_BUF += "\n${row.module} (${row.scope}; ${row.round_label} round)|${row.artifact}"
        }
        if (row.failure && (row.result in ['FAIL', 'ERR', 'UNKNOWN', 'REPORT_ERROR'] || row.reporting_status == 'ERROR')) {
            BUILD_FAILURE_REASON_BUF += "\n${row.module} (${row.scope}): ${row.failure}"
        }
    }
    def skiplistFile = "skipped_tests_build_${BUILD_NUMBER}.txt".toString()
    if (report.skiplist_file?.toString() == skiplistFile) {
        SKIPLIST_FILES_BUF = "Module skips and cases not reached|${skiplistFile}"
        archiveArtifacts artifacts: skiplistFile, allowEmptyArchive: false, fingerprint: true
    } else {
        env.PIPELINE_FAILED = 'true'
        echo 'NDP_SKIPLIST_UNAVAILABLE: the consolidated module skip list was not produced'
    }
    (report.reporting_errors ?: []).each { issue ->
        def reason = (issue.reason ?: 'reporting reconciliation failed').toString()
        if (!BUILD_FAILURE_REASON_BUF.contains(reason)) {
            BUILD_FAILURE_REASON_BUF += "\nReporting: ${reason}"
        }
    }
    def finalizedKeys = (report.rows ?: []).collect { row ->
        "${row.version_id}|${row.module}|${row.run_id}".toString()
    } as Set
    MODULE_ACTIVITY_RESULTS.each { key, row ->
        if (!finalizedKeys.contains(key) && row.result == 'UNKNOWN' &&
            (row.failure ?: '').startsWith('result not collected;')) {
            row.result = 'NOT_RUN'
            row.failure = 'not reached; execution registration or round setup stopped'
            env.PIPELINE_FAILED = 'true'
        }
    }
    TEST_RESULT_SUMMARY_BUF = moduleCaseSummaryRows()
    def totals = moduleCaseTotals(MODULE_ACTIVITY_RESULTS.values().toList())
    env.TOTAL_PASSED_COUNT = totals.passed.toString()
    env.TOTAL_FAILED_COUNT = totals.failed.toString()
    if (report.failed || report.reporting_errors) { env.PIPELINE_FAILED = 'true' }
    // Aggregate and producer/reporter receipts are internal processing state.
    echo "\nINTERNAL MODULE TEST RESULTS (CASE COUNTS)\n" +
        formatResultsTable(moduleCaseSummaryRows(), 'module test cases')
}


// Compatibility helper; the structured execution/publisher flow does not call this entry point.
def archiveTestOutput(ndfcConfig, playbookName, expectedRunMarker = '') {
    def timingKey = "${ndfcConfig.fabric_name}|${ndfcConfig.versionId}|${playbookName}|${expectedRunMarker}".toString()
    PHASE_TIMING_RESULTS[timingKey] = [:]
    def archiveStarted = System.currentTimeMillis()
    def archiveSucceeded = false
    def timestamp = new Date().format('yyyyMMdd_HHmmss')
    def baseFileName = "test_output_${ndfcConfig.fabric_name}_${ndfcConfig.versionId}_${playbookName}"
    def archivedFileName = "${baseFileName}_${timestamp}.txt"

    echo "📦 Archiving test output: ${archivedFileName}"

    try {
        sh """
            cd ${COLLECTIONS_DIRECTORY}
            if [ -f "${baseFileName}.txt" ]; then
                # Rename with timestamp
                mv "${baseFileName}.txt" "${archivedFileName}"
                echo "✅ Renamed to ${archivedFileName}"

                # Copy to workspace for archiving, then make it world-readable.
                # The container writes as root with a restrictive umask, so the
                # non-root Jenkins controller cannot read it in archiveArtifacts
                # and the archive fails with AccessDeniedException (build #14: 11/11).
                cp "${archivedFileName}" "${env.WORKSPACE}/${archivedFileName}"
                chmod 0644 "${env.WORKSPACE}/${archivedFileName}"
                echo "📋 Copied to workspace for archiving"
            else
                echo "⚠️ Base file not found: ${baseFileName}.txt"
                exit 1
            fi
        """

        // Archive the file from workspace
        archiveArtifacts artifacts: "${archivedFileName}", allowEmptyArchive: false, fingerprint: true
        archiveSucceeded = true
        echo "✅ Archived: ${archivedFileName}"

        // Clean up workspace copy after archiving
        sh "rm -f ${env.WORKSPACE}/${archivedFileName}"
        echo "🧹 Cleaned up workspace copy"
        return archivedFileName
    } catch (Exception e) {
        echo "⚠️ Failed to archive ${baseFileName}: ${e.getMessage()}"
        return ''
    } finally {
        def archiveSeconds = (System.currentTimeMillis() - archiveStarted) / 1000.0
        try {
            withEnv(["ND_REPORT_LOG=${COLLECTIONS_DIRECTORY}/${baseFileName}.txt",
                     "ND_REPORT_MODULE=${playbookName}", "ND_REPORT_RUN=${expectedRunMarker}",
                     "ND_REPORT_ARCHIVE_SECONDS=${archiveSeconds}",
                     "ND_REPORT_ARCHIVE_STATUS=${archiveSucceeded ? 'success' : 'failed'}",
                     "ND_REPORT_ARTIFACT=${archivedFileName}"]) {
                sh '''#!/bin/bash
                    set -e
                    "$HOME/ansible/venv/bin/python" "$COLLECTIONS_DIRECTORY/nd_result_summary.py" archive \\
                        --log "$ND_REPORT_LOG" --module "$ND_REPORT_MODULE" --run-id "$ND_REPORT_RUN" \\
                        --archive-seconds "$ND_REPORT_ARCHIVE_SECONDS" --archive-status "$ND_REPORT_ARCHIVE_STATUS"
                    for kind in execution phases summary activity; do
                        if [ -f "$ND_REPORT_LOG.$kind.json" ]; then
                            cp "$ND_REPORT_LOG.$kind.json" "$WORKSPACE/$ND_REPORT_ARTIFACT.$kind.json"
                            chmod 0644 "$WORKSPACE/$ND_REPORT_ARTIFACT.$kind.json"
                        fi
                    done
                '''
                def timingSummary = parseReportingJson(
                    readFile(file: "${archivedFileName}.summary.json"))
                if (timingSummary.module != playbookName || timingSummary.run_id != expectedRunMarker) {
                    error('Timing summary belongs to another run or module')
                }
                PHASE_TIMING_RESULTS[timingKey] = timingSummary.phase_seconds ?: [:]
                // Compatibility summaries remain internal; only the raw TXT is archived.
                sh '''#!/bin/bash
                    rm -f -- "$WORKSPACE/$ND_REPORT_ARTIFACT.execution.json" "$WORKSPACE/$ND_REPORT_ARTIFACT.phases.json" "$WORKSPACE/$ND_REPORT_ARTIFACT.summary.json" "$WORKSPACE/$ND_REPORT_ARTIFACT.activity.json"
                '''
            }
        } catch (Exception metadataError) {
            echo "Failed to archive result metadata for ${playbookName}: ${metadataError.getMessage() ?: metadataError.getClass().getName()}"
            env.PIPELINE_FAILED = 'true'
        }
    }
}

/**
 * Archives the module-wise skipped-tests summary for a fabric/version and records
 * its artifact filename so the post{} Webex block can link it. Best-effort.
 */
def archiveSkipList(ndfcConfig) {
    def skipFileName = "skipped_tests_${ndfcConfig.fabric_name}_${ndfcConfig.versionId}.txt"
    try {
        def alreadyRecorded = (SKIPLIST_FILES_BUF ?: '').split('\n').findAll { it.trim() }.contains(skipFileName)
        if (alreadyRecorded) {
            return
        }
        // The summary is written into COLLECTIONS_DIRECTORY by the test-run shell.
        def present = sh(script: "cd ${COLLECTIONS_DIRECTORY} && [ -s '${skipFileName}' ]", returnStatus: true) == 0
        if (!present) {
            echo "ℹ️ No skipped-tests summary to archive: ${skipFileName}"
            return
        }
        sh """
            cd ${COLLECTIONS_DIRECTORY}
            cp "${skipFileName}" "${env.WORKSPACE}/${skipFileName}"
            chmod 0644 "${env.WORKSPACE}/${skipFileName}"
        """
        archiveArtifacts artifacts: "${skipFileName}", allowEmptyArchive: true, fingerprint: true
        def report = readFile(file: skipFileName).trim()
        if (report) {
            def compact = []
            def includeNumbered = false
            report.readLines().each { line ->
                def trimmed = line.trim()
                def keep = trimmed.startsWith('MODULE:') ||
                    trimmed.startsWith('RESULT:') ||
                    trimmed.startsWith('ANSIBLE EXIT STATUS:') ||
                    trimmed.startsWith('COMPLETED / OBSERVED TESTS:') ||
                    trimmed.startsWith('LAST COMPLETED / OBSERVED:') ||
                    trimmed.startsWith('FAILED TESTS:') ||
                    trimmed.startsWith('PENDING / FULLY SKIPPED TESTS:') ||
                    trimmed.startsWith('NOT OBSERVED / NOT REACHED TESTS:')
                if (trimmed ==~ /^\d+\..*/) {
                    keep = includeNumbered
                }
                if (trimmed.startsWith('FAILED TESTS:') || trimmed.startsWith('PENDING / FULLY SKIPPED TESTS:')) {
                    includeNumbered = true
                } else if (trimmed.startsWith('NOT OBSERVED / NOT REACHED TESTS:') ||
                           trimmed.startsWith('MODULE:') || trimmed.startsWith('====')) {
                    includeNumbered = false
                }
                if (keep) {
                    compact << line
                }
            }
            def details = (["### ${skipFileName}"] + compact).join('\n')
            SKIPLIST_DETAILS_BUF = (SKIPLIST_DETAILS_BUF ?: '').trim() ?
                "${SKIPLIST_DETAILS_BUF}\n\n${details}" : details
        }
        sh "rm -f ${env.WORKSPACE}/${skipFileName}"
        // Accumulate one filename per fabric/version for the Webex link.
        SKIPLIST_FILES_BUF = (SKIPLIST_FILES_BUF ?: '').trim() ? "${SKIPLIST_FILES_BUF}\n${skipFileName}" : skipFileName
        echo "📦 Archived skipped-tests summary: ${skipFileName}"
    } catch (Exception e) {
        echo "⚠️ Failed to archive skipped-tests summary ${skipFileName}: ${e.getMessage()}"
    }
}

/**
 * Renders the accumulated per-module rows in TEST_RESULT_SUMMARY_BUF.
 * Rows are stored pipe-delimited as
 * "status|playbook|fabric|nd|passed|failed|skipped|duration|note".
 *
 * Webex does not document support for GitHub-style pipe tables, but it does
 * support fenced code blocks. Render a compact fixed-width table inside a
 * Markdown code block so columns remain aligned. Fabric scope is displayed per module; the ND column is shown when multiple
 * versions are present. Missing iBGP/eBGP counterpart rows are display-only.
 */
def formatPhaseDuration(seconds) {
    if (!(seconds instanceof Number)) { return 'N/A' }
    // Avoid Double.isNaN/isInfinite: build 120's sandbox rejects these calls.
    if (seconds.toString() in ['NaN', 'Infinity', '-Infinity'] ||
        seconds < 0 || seconds > 9223372036854775L) {
        return 'N/A'
    }
    long milliseconds = (long) (seconds * 1000 + 0.5)
    long hours = (long) (milliseconds / 3600000)
    long minutes = (long) ((milliseconds % 3600000) / 60000)
    long wholeSeconds = (long) ((milliseconds % 60000) / 1000)
    return hours.toString().padLeft(2, '0') + 'h ' +
        minutes.toString().padLeft(2, '0') + 'm ' +
        wholeSeconds.toString().padLeft(2, '0') + '.' +
        (milliseconds % 1000).toString().padLeft(3, '0') + 's'
}

def formatPhaseTimingTable(results, elapsedSeconds) {
    def phases = [prerequisites: 'Prerequisite setup', execution: 'Test execution',
                  cleanup: 'Cleanup', parsing: 'Result parsing', archiving: 'Log archiving']
    def rows = [['Activity', 'Duration', 'Measured / attempts']]
    double measuredTotal = 0
    int measurements = 0
    phases.each { phase, label ->
        def values = results.collect { it[phase] }.findAll { formatPhaseDuration(it) != 'N/A' }
        def seconds = null
        values.each { value -> seconds = seconds == null ? value : seconds + value }
        if (seconds != null) {
            measuredTotal += seconds.doubleValue()
            measurements += values.size()
        }
        rows << [label, formatPhaseDuration(seconds), "${values.size()} / ${results.size()}"]
    }
    rows << ['Measured phase subtotal', formatPhaseDuration(measurements ? measuredTotal : null), '-']
    rows << ['Build elapsed (to report)', formatPhaseDuration(elapsedSeconds), '-']
    def lines = rows.collect { row ->
        row[0].padRight(27) + ' | ' + row[1].padLeft(18) + ' | ' + row[2]
    }
    lines.add(1, '-' * 72)
    return '\nFINAL TIME BREAKDOWN\n' + lines.join('\n') +
        '\nN/A = no measurement. Counts cover module attempts reaching reporting; interrupted timings may be partial.' +
        '\nPhase subtotal is not build wall time; reporting overlaps later module execution.' +
        '\nTarget-internal setup/cleanup is part of execution. Parsing is agent extraction only.' +
        '\nArchiving includes per-execution evidence upload; the combined log bundle is separate.'
}

def fabricScopeLabel(value) {
    def text = (value ?: '').toString().trim()
    if (text in ['iBGP', 'eBGP', 'External', 'Mixed', 'Logical', 'Controller', 'Unknown']) {
        return text
    }
    if (text in ['iBGP+External', 'eBGP+External']) {
        return text
    }
    def lower = text.toLowerCase()
    if (lower.contains('ebgp')) { return 'eBGP' }
    if (lower.contains('external')) { return 'External' }
    if (lower.contains('ibgp') || text == 'VXLAN_EVPN_Fabric') { return 'iBGP' }
    return 'Unknown'
}

def resultContextForTarget(ndfcConfig, token, networkFabricName = '', vpcPairRows = []) {
    def module = token.toString().replaceFirst(/\.yaml$/, '')
    def primary = (ndfcConfig.fabric_name ?: '').toString()
    def scope = fabricScopeLabel(ndfcConfig.fabric_type ?: primary)
    if (scope == 'Unknown') {
        scope = fabricScopeLabel(ndfcConfig.vpc_pair_fabric_type)
    }
    def fabric = primary
    if (module == 'nd_manage_networks') {
        fabric = (networkFabricName ?: primary).toString()
        scope = fabricScopeLabel(fabric)
    } else if (module.startsWith('nd_vpc_pair.')) {
        def pairId = module.substring('nd_vpc_pair.'.length())
        def pair = vpcPairRows.find { it.id.toString() == pairId }
        fabric = pair ? pair.fabric.toString() : primary
        scope = pair ? fabricScopeLabel(pair.type ?: pair.fabric) : 'Unknown'
    } else if (module == 'nd_local_user') {
        fabric = 'controller'
        scope = 'Controller'
    } else if (module == 'nd_manage_fabric') {
        fabric = 'disposable fabric matrix'
        scope = 'Mixed'
    } else if (module in ['nd_manage_fabric_group_vxlan', 'nd_manage_fabric_group_members']) {
        fabric = 'logical fabric groups'
        scope = 'Logical'
    } else if (module in ['nd_manage_l3out', 'nd_manage_links']) {
        fabric = primary + ', ' + (ndfcConfig.fabric_name_2 ?: 'External_Connectivity_Fabric')
        scope = scope + '+External'
    }
    [fabric: fabric, scope: scope]
}

def tableColumnWidths(headers, rows) {
    def widths = []
    for (int column = 0; column < headers.size(); column++) {
        int width = headers[column].length()
        for (def row : rows) {
            int cellWidth = row[column].length()
            if (cellWidth > width) { width = cellWidth }
        }
        widths.add(width)
    }
    widths
}

def formatResultsTable(rawSummary, countUnit = 'Ansible tasks') {
    def lines = (rawSummary ?: '').split('\n').findAll { it.trim() }
    if (lines.isEmpty()) {
        return '(no per-module results captured)'
    }
    def cleanCell = { value ->
        (value ?: '').toString().replace('\r', ' ').replace('\n', ' ').replace('\t', ' ')
    }
    def records = lines.collect { line ->
        def fields = line.split('\\|', -1)
        def cell = { int index -> index < fields.size() ? cleanCell(fields[index]).trim() : '' }
        [status: cell(0), module: cell(1), fabric: cell(2), nd: cell(3),
         passed: cell(4), failed: cell(5), skipped: cell(6), duration: cell(7), note: cell(8),
         scope: cell(9) ?: fabricScopeLabel(cell(2))]
    }
    def groups = [:]
    records.each { record ->
        def key = record.module + '|' + record.nd
        if (!groups.containsKey(key)) { groups[key] = [] }
        groups[key].add(record)
    }
    def displayRecords = []
    groups.values().each { group ->
        // Missing counterpart rows are presentation only: never add them to task totals.
        if (group.any { it.scope in ['iBGP', 'eBGP'] }) {
            ['iBGP', 'eBGP'].each { scope ->
                def matching = group.findAll { it.scope == scope }
                if (matching) {
                    displayRecords.addAll(matching)
                } else {
                    displayRecords.add([status: 'NOT_RUN', module: group[0].module,
                        nd: group[0].nd, scope: scope, passed: '-', failed: '-', skipped: '-',
                        duration: 'not scheduled', note: ''])
                }
            }
            displayRecords.addAll(group.findAll { !(it.scope in ['iBGP', 'eBGP']) })
        } else {
            // Combined/shared/controller results cannot be divided into per-fabric counts.
            displayRecords.addAll(group)
        }
    }
    def showNd = records.collect { it.nd }.unique().size() > 1
    def headers = ['Status', 'Module', 'Fabric']
    if (showNd) { headers.add('ND') }
    headers.addAll(['Passed', 'Failed', 'Skipped', 'Duration'])
    def rows = displayRecords.collect { record ->
        def row = [record.status, record.module, record.scope]
        if (showNd) { row.add(record.nd) }
        def noExecution = record.status == 'NOT_RUN'
        row.addAll([noExecution ? '-' : record.passed, noExecution ? '-' : record.failed,
                    noExecution ? '-' : record.skipped, record.duration])
        row.collect { cleanCell(it) }
    }
    def widths = tableColumnWidths(headers, rows)
    def renderRow = { cells ->
        (0..<cells.size()).collect { int index ->
            def value = cells[index].toString()
            def padding = ' ' * (widths[index] - value.length())
            index < (showNd ? 4 : 3) ? value + padding : padding + value
        }.join('  ')
    }
    def separator = widths.collect { int width -> '-' * width }
    def skipNotes = records.findAll { it.status == 'SKIP' && it.note }
        .collect { "  ${it.module} (${it.scope}): ${it.note}" }
    def skipBlock = skipNotes ? "\n\nSKIPPED - lab substrate unavailable:\n${skipNotes.join('\n')}" : ''
    def caseNotes = records.findAll { it.status != 'SKIP' && it.note }
        .collect { "  ${it.module} (${it.scope}): ${it.note}" }
    def caseBlock = caseNotes ? "\n\nCASE COVERAGE / APPLICABILITY NOTES:\n${caseNotes.join('\n')}" : ''
    "```\n${renderRow(headers)}\n${renderRow(separator)}\n${rows.collect { renderRow(it) }.join('\n')}${skipBlock}${caseBlock}\n```" +
        "\nPassed/Failed/Skipped = ${countUnit}. NOT_RUN = no execution for that fabric." +
        '\nMixed/shared rows contain one combined result; counts are included once.' +
        (countUnit == 'module test cases' ? '\n? = case count unavailable or incomplete; setup and cleanup are excluded.' : '')
}

def splitWebexMessage(message, continuationHeader = '', maxLength = 7000) {
    def text = (message ?: '').toString()
    if (text.length() <= maxLength) { return [text] }
    // Reserve enough room for a numbered part marker after all parts are known.
    int contentLimit = maxLength - 80
    def parts = []
    def current = new StringBuilder()
    boolean inFence = false
    def tableHeader = []
    def startContinuation = {
        current = new StringBuilder(continuationHeader.toString())
        if (inFence) {
            current.append('```\n')
            tableHeader.each { current.append(it).append('\n') }
        }
        if (current.length() + 8 >= contentLimit) {
            throw new IllegalArgumentException('Webex continuation header exceeds message capacity')
        }
    }
    def flushPart = {
        if (inFence) { current.append('```\n') }
        parts.add(current.toString().trim())
        startContinuation()
    }
    text.split('\n', -1).each { originalLine ->
        def line = originalLine.toString()
        boolean fenceLine = line.trim().startsWith('```')
        int reserve = inFence ? 4 : 0
        if (current.length() + line.length() + 1 + reserve > contentLimit && current.length() > 0) {
            flushPart()
        }
        // Preserve even an unusually long diagnostic line instead of truncating content.
        while (current.length() + line.length() + 1 + (inFence ? 4 : 0) > contentLimit) {
            int available = contentLimit - current.length() - 1 - (inFence ? 4 : 0)
            if (available <= 0) { throw new IllegalArgumentException('Webex message capacity exhausted') }
            // A UTF-16 boundary must not separate an emoji's surrogate pair.
            int boundary = available
            if (boundary > 0 && boundary < line.length()) {
                int high = (int) line.charAt(boundary - 1)
                int low = (int) line.charAt(boundary)
                if (high >= 55296 && high <= 56319 && low >= 56320 && low <= 57343) { boundary-- }
            }
            if (boundary <= 0) { throw new IllegalArgumentException('Webex message capacity exhausted') }
            current.append(line.substring(0, boundary)).append('\n')
            line = line.substring(boundary)
            flushPart()
        }
        current.append(line).append('\n')
        if (fenceLine) {
            inFence = !inFence
            if (inFence) { tableHeader = [] }
        } else if (inFence && tableHeader.size() < 2) {
            tableHeader.add(line)
        }
    }
    if (inFence) { current.append('```\n') }
    if (current.toString().trim()) { parts.add(current.toString().trim()) }
    def renderedParts = []
    for (int index = 0; index < parts.size(); index++) {
        def rendered = "📄 Report part ${index + 1}/${parts.size()}\n" + parts[index]
        if (rendered.length() > maxLength) {
            throw new IllegalArgumentException('Webex report part exceeds message limit')
        }
        renderedParts.add(rendered)
    }
    renderedParts
}


/**
 * Escapes text that is shown in a Webex Markdown link label.
 */
def escapeWebexMarkdown(value) {
    (value ?: '').toString()
        .replace('\\', '\\\\')
        .replace('|', '\\|')
        .replace('_', '\\_')
        .replace('*', '\\*')
        .replace('[', '\\[')
        .replace(']', '\\]')
        .replace('\r', ' ')
        .replace('\n', ' ')
}

/**
 * Renders one module-specific artifact link per line after the result table.
 */
def formatArtifactLinks(rawArtifacts) {
    def lines = (rawArtifacts ?: '').split('\n').findAll { it.trim() }
    def links = []
    lines.each { line ->
        def parts = line.split('\\|', 2)
        if (parts.size() == 2 && parts[0].trim() && parts[1].trim()) {
            def label = escapeWebexMarkdown(parts[0].trim())
            links << "- [${label} logs](${JOB_URL}${BUILD_NUMBER}/artifact/${parts[1].trim()})"
        }
    }
    links.join('\n')
}

/**
 * Renders the archived skipped-test summaries. A multi-version run can create
 * more than one file, so each gets its own unambiguous label.
 */
def formatSkippedTestLinks(rawSkipFiles) {
    def files = (rawSkipFiles ?: '').split('\n').findAll { it.trim() }
    def links = []
    files.eachWithIndex { fileName, index ->
        def parts = fileName.split('\\|', 2)
        def artifactPath = parts.size() == 2 ? parts[1].trim() : fileName.trim()
        def defaultLabel = files.size() == 1 ? 'Skipped tests' : "Skipped tests ${index + 1}"
        def label = escapeWebexMarkdown(parts.size() == 2 && parts[0].trim() ? parts[0].trim() : defaultLabel)
        if (artifactPath) {
            links << "📋 [${label}](${JOB_URL}${BUILD_NUMBER}/artifact/${artifactPath})"
        }
    }
    links.join('\n')
}

/**
 * Calculates wall-clock build duration from the Jenkins build start through the
 * time the post-build notification is assembled.
 */
def calculateRunDuration(long startTimeMillis, long endTimeMillis) {
    long elapsedMillis = endTimeMillis - startTimeMillis
    if (elapsedMillis < 0L) {
        elapsedMillis = 0L
    }
    long totalSeconds = elapsedMillis.intdiv(1000L)
    long hours = totalSeconds.intdiv(3600L)
    long minutes = (totalSeconds % 3600L).intdiv(60L)
    long seconds = totalSeconds % 60L
    hours > 0L ? "${hours}h ${minutes}m ${seconds}s" : "${minutes}m ${seconds}s"
}

/**
 * Bundles every log this build produced — per-module test/console output, the
 * module-wise skip summaries, the ansible-lint result and a consolidated run
 * summary — into ONE build-numbered zip, archives it (so it shows in the build's
 * artifact/file list) and records its name for the post{} Webex link. Runs on the
 * agent (COLLECTIONS_DIRECTORY + workspace exist here) and never fails the build.
 */
def activityResultKey(ndfcConfig, module, runId) {
    "${ndfcConfig.versionId}|${module}|${runId}".toString()
}

def activityCount(value) {
    value instanceof Number && value >= 0 ? value.toString() : '?'
}

def activityCountSum(rows, getter) {
    long known = 0
    boolean unknown = rows.isEmpty()
    rows.findAll { it.result != 'NOT_RUN' }.each { row ->
        def value = getter(row)
        if (value instanceof Number && value >= 0) { known += value.longValue() }
        else { unknown = true }
    }
    unknown ? (known ? "${known} + ?" : '?') : known.toString()
}

def caseOutcomeCount(rows, name) {
    long known = 0
    boolean unknown = rows.isEmpty()
    rows.findAll { it.result != 'NOT_RUN' }.each { row ->
        def value = row.case_totals?.get(name)
        if (!(value instanceof Number) || value < 0) {
            value = row.identified_testcase_totals?.get(name)
            unknown = true
        }
        if (value instanceof Number && value >= 0) { known += value.longValue() }
        else { unknown = true }
        if ((row.case_totals?.incomplete instanceof Number && row.case_totals.incomplete > 0) ||
            row.coverage in ['PARTIAL', 'INCOMPLETE', 'UNKNOWN']) { unknown = true }
    }
    unknown ? (known ? "${known} + ?" : '?') : known.toString()
}

def moduleCaseTotals(rows) {
    ['passed', 'failed', 'skipped'].collectEntries { name ->
        [(name): caseOutcomeCount(rows, name)]
    }
}

def moduleCaseSummaryRows() {
    MODULE_ACTIVITY_RESULTS.values().collect { row ->
        def status = row.result == 'PASS' ? 'OK' : row.result
        def notes = []
        def noExecution = row.result == 'NOT_RUN'
        if (noExecution) {
            def reason = (row.failure ?: '').toString().toLowerCase()
            def blocked = (reason.contains('preflight') || reason.contains('pre-flight')) ? 'preflight blocked' : 'earlier execution stopped'
            notes.add('Not executed—' + blocked + '. Case coverage: N/A')
        } else {
            if (row.coverage != 'COMPLETE') { notes.add('case coverage ' + (row.coverage ?: 'UNKNOWN')) }
            if (activityStageLabel(row.base).toLowerCase().contains('failed')) { notes.add('Setup/Base failed; case outcomes are separate') }
            if (activityStageLabel(row.cleanup).toLowerCase().contains('failed')) { notes.add('Cleanup failed; earlier case results are retained') }
            def caseFailures = row.case_totals?.failed
            if (!(caseFailures instanceof Number)) { caseFailures = row.identified_testcase_totals?.failed }
            if (caseFailures instanceof Number && caseFailures > 0) { notes.add("${caseFailures} authored test case(s) failed") }
        }
        def incomplete = row.case_totals?.incomplete
        if (!(incomplete instanceof Number)) { incomplete = row.identified_testcase_totals?.incomplete }
        if (incomplete instanceof Number && incomplete > 0) { notes.add("${incomplete} incomplete case(s)") }
        (row.skipped_case_notes ?: []).each { notes.add(it.toString()) }
        if (row.skipped_case_notes_truncated) { notes.add('additional skip reasons are in the activity artifact') }
        if (row.result == 'SKIP') {
            notes.add((row.skip_reason ?: row.failure ?: 'declared lab substrate unavailable').toString())
        } else if (row.failure) {
            notes.add('Failure / reason: ' + row.failure.toString())
        }
        def note = notes.join('; ')
        // Shared/controller/external targets can execute in both rounds while
        // retaining their own scope. Name the round so those rows are traceable.
        def label = row.module
        if (row.round_label && !(row.scope in ['iBGP', 'eBGP'])) {
            label += " (${row.round_label} round)"
        }
        [status, label, row.fabric, row.nd, noExecution ? '-' : caseOutcomeCount([row], 'passed'),
         noExecution ? '-' : caseOutcomeCount([row], 'failed'), noExecution ? '-' : caseOutcomeCount([row], 'skipped'),
         row.duration ?: '-', note, row.scope].collect {
             (it ?: '').toString().replace('|', '/').replace('\n', ' ').replace('\r', ' ')
         }.join('|')
    }.join('\n')
}

def activityStageLabel(stage) {
    if (stage instanceof String) { return stage }
    if (!(stage instanceof Map)) { return 'Not observed' }
    if (stage.failed) { return 'Failed' }
    if (stage.successful || stage.observed) { return 'Yes' }
    if (stage.skipped) { return 'Skipped' }
    'Not observed'
}

// Readable module-case report shared by the activity artifact and notification fallback.
def formatModuleActivityTable(results, buildNumber) {
    results = results ?: []
    def states = ['merged', 'replaced', 'overridden', 'deleted', 'gathered']
    def headers = ['S.No.', 'Build', 'Module', 'Fabric type', 'Merged', 'Replaced',
                   'Overridden', 'Delete', 'Gather', 'Base', 'Cleanup', 'Skipped', 'Result / failure']
    def clean = { value -> (value == null ? '' : value.toString()).replace('|', '/').replace('\r', ' ').replace('\n', ' ').replace('\t', ' ') }
    def round = { row -> row.round_label ?: (row.scope in ['iBGP', 'eBGP'] ? row.scope : 'Unknown round') }
    def fabricLabel = { row ->
        def scope = row.scope ?: 'Unknown'
        scope == round(row) ? scope : "${scope} (${round(row)})".toString()
    }
    def compactCount = { rows, name -> caseOutcomeCount(rows, name).replace(' ', '') }
    def shorten = { value, limit -> def text = clean(value); text.size() <= limit ? text : text.take(limit - 3) + '...' }
    def stage = { value ->
        def label = activityStageLabel(value)
        label.contains('runner failed') || label == 'Runner failed' ? 'R.Fail' :
            label in ['Ran', 'Yes'] ? 'Ran' : label == 'Runner observed' ? 'Runner' :
            label in ['Failed', 'Skipped'] ? label : label == 'Not observed' ? 'Unseen' : shorten(label, 7)
    }
    def wrap = { value ->
        def text = clean(value)
        if (text.startsWith('Raw log artifact: ')) { return '  Raw log artifact:\n  ' + text.substring(18) }
        def lines = [], line = '  '
        text.tokenize(' ').each { word ->
            if (line.size() > 2 && line.size() + word.size() + 1 > 110) { lines.add(line); line = '  ' }
            while (word.size() > 108) { lines.add('  ' + word.take(108)); word = word.substring(108) }
            line += (line.size() > 2 ? ' ' : '') + word
        }
        if (line.size() > 2) { lines.add(line) }
        lines.join('\n')
    }
    def rows = [], details = [], summaries = [], groups = [:]
    results.each { record ->
        def key = record.module + '|' + record.nd
        if (!groups.containsKey(key)) { groups[key] = [] }
        groups[key].add(record)
    }
    int sequence = 0
    groups.values().each { group ->
        sequence++
        def display = []
        if (group.any { it.scope in ['iBGP', 'eBGP'] }) {
            ['iBGP', 'eBGP'].each { scope ->
                def matching = group.findAll { it.scope == scope }
                if (matching) { display.addAll(matching) }
                else { display.add([module: group[0].module, nd: group[0].nd, scope: scope, round_label: scope,
                    result: 'NOT_RUN', display_only: true, failure: 'not scheduled']) }
            }
            display.addAll(group.findAll { !(it.scope in ['iBGP', 'eBGP']) })
        } else {
            ['iBGP', 'eBGP'].each { phase -> display.addAll(group.findAll { round(it) == phase }) }
            display.addAll(group.findAll { !(round(it) in ['iBGP', 'eBGP']) })
        }
        display.eachWithIndex { record, index ->
            def noExecution = record.result == 'NOT_RUN'
            def cells = [index == 0 ? sequence.toString() : '', buildNumber.toString(),
                         index == 0 ? shorten(record.module, 40) : '', shorten(fabricLabel(record), 28)]
            states.each { state -> cells.add(noExecution ? '-' : activityCount(record.counts?.get(state)?.started)) }
            cells.add(record.display_only ? '-' : noExecution ? 'NoRun' : stage(record.base))
            cells.add(record.display_only ? '-' : noExecution ? 'NoRun' : stage(record.cleanup))
            cells.add(noExecution ? '-' : caseOutcomeCount([record], 'skipped'))
            def notes = []
            if (record.failure) { notes.add('Failure / reason: ' + record.failure) }
            if (record.skip_reason && record.skip_reason != record.failure) { notes.add('Skip reason: ' + record.skip_reason) }
            if (!noExecution) {
                notes.add("Base: ${activityStageLabel(record.base)}; Cleanup: ${activityStageLabel(record.cleanup)}.")
                notes.add("Observed outcomes: cases passed ${caseOutcomeCount([record], 'passed')}, failed ${caseOutcomeCount([record], 'failed')}, skipped ${caseOutcomeCount([record], 'skipped')}.")
                def incomplete = record.case_totals?.incomplete
                if (!(incomplete instanceof Number)) { incomplete = record.identified_testcase_totals?.incomplete }
                if (incomplete instanceof Number && incomplete > 0) { notes.add("WARNING: ${incomplete} incomplete case(s); required verification was not fully observed.") }
                if (record.coverage != 'COMPLETE') { notes.add('WARNING: case coverage ' + (record.coverage ?: 'UNKNOWN') + '; complete module totals are not established.') }
                if (record.counts?.other?.started instanceof Number && record.counts.other.started > 0) { notes.add("Other started cases: ${record.counts.other.started}; included in outcomes, outside the five state columns.") }
                if (record.catalog_case_count instanceof Number) { notes.add("Source catalog: ${record.catalog_case_count} authored cases; this is inventory, not execution or pass evidence.") }
                if (record.coverage == 'PARTIAL' && record.identified_testcase_totals) { notes.add("Identified observed subset, not full module totals: passed ${activityCount(record.identified_testcase_totals.passed)}, failed ${activityCount(record.identified_testcase_totals.failed)}, skipped ${activityCount(record.identified_testcase_totals.skipped)}, incomplete ${activityCount(record.identified_testcase_totals.incomplete)}.") }
                (record.skipped_case_notes ?: []).each { notes.add('Skipped: ' + it.toString()) }
                if (record.skipped_case_notes_truncated) { notes.add("Additional skip details are in skipped_tests_build_${buildNumber}.txt.") }
                def skipped = record.case_totals?.skipped
                if (!(skipped instanceof Number)) { skipped = record.identified_testcase_totals?.skipped }
                if (!(record.skipped_case_notes) && (record.result == 'SKIP' || (skipped instanceof Number && skipped > 0))) {
                    notes.add('Individual skipped-case reasons unavailable in this summary; see the raw log.')
                }
                (record.source_notes ?: []).each { notes.add('Evidence note: ' + it.toString()) }
                if (record.artifact) { notes.add('Raw log artifact: ' + record.artifact) }
                else { notes.add('Raw log artifact unavailable or not archived.') }
            }
            int reference = details.size() + 1
            details.add(wrap("[${reference}] ${record.module}; ND ${record.nd ?: '?'}; ${fabricLabel(record)}; fabric ${record.fabric ?: 'unknown'}") + '\n' +
                        notes.collect { wrap(it) }.join('\n'))
            def status = record.result ?: 'UNKNOWN'
            def warning = !noExecution && (record.coverage != 'COMPLETE' ||
                (record.case_totals?.incomplete instanceof Number && record.case_totals.incomplete > 0) ||
                (record.identified_testcase_totals?.incomplete instanceof Number && record.identified_testcase_totals.incomplete > 0)) ? ' !' : ''
            cells.add(shorten("${status}${warning} [${reference}]", 24))
            rows.add(cells)
        }
    }
    def addTotal = { label, scope, records ->
        def executed = records.findAll { it.result != 'NOT_RUN' }
        def cells = ['', buildNumber.toString(), label, shorten(scope, 28)]
        states.each { state -> cells.add(executed ? activityCountSum(records, { row -> row.counts?.get(state)?.started }) : '-') }
        cells.addAll(['-', '-', executed ? caseOutcomeCount(records, 'skipped') : '-'])
        def totals = moduleCaseTotals(records)
        def outcomes = "P${compactCount(records, 'passed')} F${compactCount(records, 'failed')}"
        cells.add(executed ? (outcomes.size() <= 24 ? outcomes : 'See totals') : 'NOT_RUN')
        rows.add(cells)
        summaries.add("${label} ${scope}: ${records.count { it.validated == true }} validated executions / ${records.size()} selected; " +
                      (executed ? "cases passed ${totals.passed}, failed ${totals.failed}, skipped ${totals.skipped}." : 'no module execution; case counts not applicable.'))
    }
    def totalGroups = [:]
    results.each { record ->
        def key = "${record.nd}|${round(record)}|${record.scope ?: 'Unknown'}".toString()
        if (!totalGroups.containsKey(key)) { totalGroups[key] = [] }
        totalGroups[key].add(record)
    }
    totalGroups.values().each { records -> addTotal('Subtotal', fabricLabel(records[0]), records) }
    addTotal('MAIN TOTAL', 'All rounds/scopes', results)
    rows = rows.collect { row -> row.collect { clean(it) } }
    def widths = tableColumnWidths(headers, rows)
    def render = { cells -> '| ' + (0..<cells.size()).collect { int index ->
        cells[index].toString().padRight(widths[index])
    }.join(' | ') + ' |' }
    def table = ([render(headers), render(widths.collect { '-' * it })] + rows.collect { render(it) }).join('\n')
    "ND MODULE TEST ACTIVITY - Build ${buildNumber}\n\n${table}\n\n" +
        'P/F in totals = observed passed/failed module cases; ! = incomplete or unavailable case coverage.\n' +
        'State columns count distinct authored module cases observed starting, not passes, source inventory, pipeline tasks or API calls.\n' +
        'Each case has one primary tested state; verification gathers do not add Gather cases.\n' +
        'Base/Cleanup are observed-stage indicators and contribute no test cases.\n' +
        'Base/Cleanup labels: Unseen = not observed; NoRun = not reached; Runner = runner observed; R.Fail = runner failed.\n' +
        'Skipped counts fully skipped authored cases; NOT_RUN is not skipped. - = no execution; ? = unknown; N + ? = known subset with unknown contributions.\n' +
        'Only synthetic missing counterpart rows are excluded from totals; actual selected NOT_RUN rows remain in selected execution totals.\n' +
        'Each actual selected execution is counted once. Full labels, failures, outcome counts and raw log artifacts are in the details below.\n' +
        'Shared/External rows retain their scheduling round in parentheses. Validated executions confirm run identity, not that every case passed.\n\n' +
        'EXECUTION TOTALS\n' + summaries.collect { clean(it) }.join('\n') + '\n\n' +
        'DETAILS AND RAW LOG ARTIFACTS\n' + details.join('\n\n') + '\n'
}

// Compatibility helper; the structured execution/publisher flow does not call this entry point.
def captureModuleActivity(ndfcConfig, module, testType, runId, context, logFile) {
    def key = activityResultKey(ndfcConfig, module, runId)
    def row = MODULE_ACTIVITY_RESULTS[key]
    try {
        withEnv(["ND_ACTIVITY_LOG=${logFile}", "ND_ACTIVITY_MODULE=${module}",
                 "ND_ACTIVITY_RUN=${runId}", "ND_ACTIVITY_FABRIC=${context.scope}",
                 "ND_ACTIVITY_TEST_TYPE=${testType}"]) {
            sh '''#!/bin/bash
                set -euo pipefail
                "$HOME/ansible/venv/bin/python" "$COLLECTIONS_DIRECTORY/nd_test_activity.py" summarize \\
                    --log "$ND_ACTIVITY_LOG" --module "$ND_ACTIVITY_MODULE" --run-id "$ND_ACTIVITY_RUN" \\
                    --build "$BUILD_NUMBER" --fabric "$ND_ACTIVITY_FABRIC" \\
                    --collection-root "$COLLECTIONS_DIRECTORY" --test-type "$ND_ACTIVITY_TEST_TYPE" \\
                    --output "$ND_ACTIVITY_LOG.activity.json"
            '''
        }
        def activity = parseReportingJson(readFile(file: "${logFile}.activity.json"))
        if (activity.module != module || activity.run_id != runId ||
            activity.build.toString() != BUILD_NUMBER.toString() || activity.fabric != context.scope || !activity.validated) {
            error('Module activity summary belongs to another execution')
        }
        row.putAll(activity)
        row.counts = activity.counts.collectEntries { state, count -> [(state): [started: count]] }
        row.counts.other = [started: activity.other_cases]
        row.case_totals = activity.testcase_totals ?: [:]
        row.failure = (activity.failure ?: []).join('; ')
        row.fabric = context.fabric
        row.scope = context.scope
        row.nd = ndfcConfig.version
        row.duration = '-'
    } catch (Exception e) {
        rethrowIfInterrupt(e)
        row.result = 'UNKNOWN'
        row.failure = 'module case report unavailable; see console'
        row.coverage = 'UNKNOWN'
        env.PIPELINE_FAILED = 'true'
        echo "⚠️ Module case report unavailable for ${module} (${context.scope}); Ansible result parsing will continue"
    }
}

def publishModuleActivityReport() {
    try {
        def reportFile = "module_test_activity_build_${BUILD_NUMBER}.txt"
        writeFile file: reportFile, text: formatModuleActivityTable(MODULE_ACTIVITY_RESULTS.values().toList(), BUILD_NUMBER)
        archiveArtifacts artifacts: reportFile, allowEmptyArchive: false, fingerprint: true
        env.MODULE_ACTIVITY_REPORT_FILE = reportFile
        echo "📋 Archived module-only test activity table: ${reportFile}"
    } catch (Exception e) {
        rethrowIfInterrupt(e)
        env.PIPELINE_FAILED = 'true'
        echo "⚠️ Could not archive module activity table: ${e.getMessage() ?: e.getClass().getName()}"
    }
}

def bundleAllLogs() {
    def zipName = "nd_nightly_logs_build_${BUILD_NUMBER}.zip"
    try {
        def summary = """ND NIGHTLY RUN - Build ${BUILD_NUMBER}
Console: ${JOB_URL}${BUILD_NUMBER}/console
Branch: ${(env.ND_GIT_SELECTION ?: env.ND_GIT_BRANCH ?: params.ND_GIT_BRANCH ?: 'develop').toString().trim() ?: 'develop'}
Commit: ${env.ND_GIT_COMMIT ?: 'unavailable'}

Test cases passed: ${moduleCaseTotals(MODULE_ACTIVITY_RESULTS.values().toList()).passed}
Test cases failed: ${moduleCaseTotals(MODULE_ACTIVITY_RESULTS.values().toList()).failed}

DETAILED TEST RESULTS:
${formatResultsTable(moduleCaseSummaryRows(), 'module test cases')}

MODULE FAILURE REASONS:
${BUILD_FAILURE_REASON_BUF}
"""
        if (LINT_SUMMARY_BUF.trim()) {
            summary += "\nANSIBLE-LINT RESULTS:\n${LINT_SUMMARY_BUF}\n"
        }
        writeFile file: "pipeline_summary_build_${BUILD_NUMBER}.txt", text: summary
        withEnv(["LOG_ZIP=${zipName}"]) {
            sh '''#!/bin/bash
                set -euo pipefail
                console_file="$WORKSPACE/console_build_${BUILD_NUMBER}.log"
                if [ -n "${BUILD_URL:-}" ] && curl -fsS --max-time 30 "${BUILD_URL}consoleText" -o "$console_file" 2>/dev/null; then
                    :
                else
                    rm -f -- "$console_file"
                    printf 'Full live console (Jenkins login required): %sconsoleText\n' "$BUILD_URL" > "$WORKSPACE/console_build_${BUILD_NUMBER}.README.txt"
                fi
                # Read retained files directly. No second tree of giant log copies.
                "$HOME/ansible/venv/bin/python" - <<'PY'
import json
import os
from pathlib import Path
import re
import zipfile

workspace = Path(os.environ['WORKSPACE']).resolve()
report_root = Path(os.environ['ND_REPORTING_ROOT'])
if report_root.is_symlink() or not report_root.resolve().is_relative_to(workspace):
    raise ValueError('reporting root is outside the build workspace')
output = workspace / os.environ['LOG_ZIP']
paths = set()
aggregate = report_root / 'aggregate.json'
if aggregate.is_symlink():
    raise ValueError('refusing a symlink reporting aggregate')
if aggregate.is_file():
    if aggregate.stat().st_size > 16 * 1024 * 1024:
        raise ValueError('reporting aggregate exceeds its size bound')
    report = json.loads(aggregate.read_text(encoding='utf-8'))
    for row in report.get('rows', []):
        name = row.get('artifact', '')
        if not name:
            continue
        if not re.fullmatch(r'test_output_[A-Za-z0-9_.-]+[.]txt', name):
            raise ValueError('refusing an invalid public module log name')
        path = workspace / name
        if path.is_symlink() or not path.is_file():
            raise ValueError('published module log is missing or unsafe')
        paths.add(path)
for name in ('pipeline_summary_build_' + os.environ['BUILD_NUMBER'] + '.txt',
             'module_test_activity_build_' + os.environ['BUILD_NUMBER'] + '.txt',
             'skipped_tests_build_' + os.environ['BUILD_NUMBER'] + '.txt',
             'ansible_lint_build_' + os.environ['BUILD_NUMBER'] + '.txt',
             'console_build_' + os.environ['BUILD_NUMBER'] + '.log',
             'console_build_' + os.environ['BUILD_NUMBER'] + '.README.txt'):
    path = workspace / name
    if path.is_file() and not path.is_symlink():
        paths.add(path)
with zipfile.ZipFile(output, 'w', compression=zipfile.ZIP_DEFLATED, allowZip64=True) as bundle:
    for path in sorted(paths):
        resolved = path.resolve()
        if not resolved.is_relative_to(workspace):
            raise ValueError('refusing a bundle input outside the build workspace')
        bundle.write(resolved, resolved.relative_to(workspace).as_posix())
os.chmod(output, 0o644)
print('NDP_LOG_BUNDLE_READY: readable_files=' + str(len(paths)))
PY
            '''
        }
        timeout(time: 15, unit: 'MINUTES') {
            archiveArtifacts artifacts: zipName, allowEmptyArchive: false, fingerprint: true
        }
        env.LOG_BUNDLE_FILE = zipName
    } catch (Exception e) {
        rethrowIfInterrupt(e)
        env.PIPELINE_FAILED = 'true'
        echo "NDP_LOG_BUNDLE_FAILED: ${e.getClass().getName()}"
    }
}

// Install the four reporting helpers embedded in this pipeline.
// The same function serves the frozen tools directory and collection copies.
def installEmbeddedReportingHelper(fileName, targetFileName) {
    def helper = EMBEDDED_REPORTING_HELPERS[fileName.toString()]
    if (!helper) { error("No embedded reporting helper: ${fileName}") }
    def encodedFile = "nd_embedded_${fileName}.gzip.b64"
    writeFile file: encodedFile, text: helper.gzipBase64.toString()
    withEnv(["ND_EMBEDDED_PAYLOAD=${encodedFile}", "ND_EMBEDDED_TARGET=${targetFileName}",
             "ND_EMBEDDED_SHA256=${helper.sha256}", "ND_EMBEDDED_BYTES=${helper.bytes}"]) {
        sh '''#!/bin/bash
            set -euo pipefail
            "$HOME/ansible/venv/bin/python" - <<'PY'
import ast
import base64
import gzip
import hashlib
import os
from pathlib import Path
import tempfile

workspace = Path(os.environ['WORKSPACE']).resolve()
encoded = workspace / os.environ['ND_EMBEDDED_PAYLOAD']
temporary = None
try:
    relative = Path(os.environ['ND_EMBEDDED_TARGET'])
    if relative.is_absolute() or not relative.parts or any(part in ('..', '.') for part in relative.parts):
        raise ValueError('embedded helper destination must be a relative workspace file')
    destination = workspace / relative
    if not destination.resolve().is_relative_to(workspace):
        raise ValueError('embedded helper destination leaves the workspace')
    if destination.is_symlink() or destination.is_dir():
        raise ValueError('embedded helper destination is not a safe regular file')
    for parent in destination.parents:
        if parent == workspace:
            break
        if parent.is_symlink():
            raise ValueError('embedded helper destination has a symlink parent')
    raw = gzip.decompress(base64.b64decode(encoded.read_bytes(), validate=True))
    expected_bytes = int(os.environ['ND_EMBEDDED_BYTES'])
    if expected_bytes < 1 or expected_bytes > 2 * 1024 * 1024 or len(raw) != expected_bytes:
        raise ValueError('embedded helper size mismatch')
    if hashlib.sha256(raw).hexdigest() != os.environ['ND_EMBEDDED_SHA256']:
        raise ValueError('embedded helper SHA256 mismatch')
    ast.parse(raw.decode('utf-8'), filename=str(relative))
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(prefix=destination.name + '.', suffix='.install',
                                     dir=destination.parent, delete=False) as stream:
        temporary = Path(stream.name)
        stream.write(raw)
    os.chmod(temporary, 0o644)
    os.replace(temporary, destination)
    temporary = None
finally:
    if temporary is not None:
        temporary.unlink(missing_ok=True)
    encoded.unlink(missing_ok=True)
PY
        '''
    }
    echo "NDP_EMBEDDED_REPORTING_READY: ${fileName}; sha256=${helper.sha256}"
    return true
}

def downloadFromConsul(fileName, localFileName = null) {
    def targetFileName = localFileName ?: fileName
    if (EMBEDDED_REPORTING_HELPERS.containsKey(fileName.toString())) {
        try {
            return installEmbeddedReportingHelper(fileName, targetFileName)
        } catch (Exception embeddedError) {
            rethrowIfInterrupt(embeddedError)
            env.CONSUL_SYNC_FAILED = 'true'
            BUILD_FAILURE_REASON_BUF += "\nEmbedded reporting helper could not be installed: ${fileName}"
            error("Required embedded reporting helper failed for ${fileName}: ${embeddedError.getMessage()}")
        }
    }
    try {
        echo "📥 Downloading ${fileName} from Consul..."
        def response = httpRequest(
            url: "${CONSUL_URL}/v1/kv/ansible-nd/${fileName}?raw",
            validResponseCodes: '200'
        )
        if (response.content == null || response.content.isEmpty()) {
            error("Required Consul key returned empty content: ${fileName}")
        }
        def lastSeparator = targetFileName.lastIndexOf('/')
        def stagingFileName = "${targetFileName.replace('/', '_')}.consul-download"
        writeFile file: stagingFileName, text: response.content
        if (lastSeparator > 0) {
            def parentDirectory = targetFileName.substring(0, lastSeparator)
            sh "mkdir -p -- '${parentDirectory}'"
        }
        sh "mv -- '${stagingFileName}' '${targetFileName}'"
        echo "✅ Downloaded: ${fileName}"
        return true
    } catch (Exception e) {
        rethrowIfInterrupt(e)
        env.CONSUL_SYNC_FAILED = 'true'
        error("Required Consul download failed for ${fileName}: ${e.getMessage()}")
    }
}

/**
 * Parses deployment results from the deployment output.
 * Sets failure flag if deployment errors are detected.
 * @param ndfcConfig The NDFC configuration object.
 * @param failureFlagName The failure flag to set on failure.
 * Yet to be used
 */
def parseDeploymentResults(ndfcConfig, failureFlagName) {
    // Example: parse deploy_output_<fabric>_<versionId>.txt for errors
    def deployOutputFile = "deploy_output_${ndfcConfig.fabric_name}_${ndfcConfig.versionId}.txt"
    def deployOutput
    try {
        deployOutput = readFile(deployOutputFile)
    } catch (Exception e) {
        echo "⚠️  Deployment output file not found: ${deployOutputFile} -> marking ${failureFlagName} = true"
        // If no output file is present, treat as a failure to surface the issue
        setFailureFlag(failureFlagName, true)
        return
    }

    if (deployOutput.contains("FAILED") || deployOutput.contains("ERROR") || !deployOutput.contains("failed=0")) {
        echo "❌ Deployment errors detected in ${deployOutputFile}"
        setFailureFlag(failureFlagName, true)
    } else {
        setFailureFlag(failureFlagName, false)
    }
}

/**
 * Parses test results from the test output.
 * Sets failure flag if test failures are detected.
 * @param ndfcConfig The NDFC configuration object.
 * @param failureFlagName The failure flag to set on failure.
 */
// Compatibility helper; the structured execution/publisher flow does not call this entry point.
def parseTestResults(ndfcConfig, failureFlagName, pb, testType = 'smoke', expectedRunMarker = '', reportContext = [:]) {
    def reportingFabric = reportContext.fabric ?: ndfcConfig.fabric_name
    def reportingScope = reportContext.scope ?: fabricScopeLabel(ndfcConfig.fabric_name)
    echo "⏱ Function 'parseTestResults' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"

    // DEBUG: Used for sample test. def testOutputFileResponse = httpRequest(url: "http://198.51.100.155:8500/v1/kv/ansible-nd/sample_output.txt?raw")
    // def testOutputFileName = "sample_output.txt"
    def testOutputFileName = "${env.COLLECTIONS_DIRECTORY}/test_output_${ndfcConfig.fabric_name}_${ndfcConfig.versionId}_${pb}.txt"
    def totalFailedCount = 0

    try {
        def testOutput = withEnv(["ND_REPORT_LOG=${testOutputFileName}", "ND_REPORT_MODULE=${pb}", "ND_REPORT_RUN=${expectedRunMarker}"]) {
            sh(script: '''#!/bin/bash
                set -e
                "$HOME/ansible/venv/bin/python" "$COLLECTIONS_DIRECTORY/nd_result_summary.py" summarize \\
                    --log "$ND_REPORT_LOG" --module "$ND_REPORT_MODULE" --run-id "$ND_REPORT_RUN" \\
                    --require-execution --format recap
            ''', returnStdout: true).trim()
        }
        echo "📊 Parsing test results from: ${testOutputFileName}"

        // A previous build's successful recap must never satisfy this run. Every
        // execution writes the marker before Ansible starts, and parsing fails
        // closed unless the output contains this run's exact marker.
        if (!expectedRunMarker || !testOutput.contains("[RUN_MARKER: ${expectedRunMarker}]")) {
            setFailureFlag(failureFlagName, true)
            error("Test stage failed: output for ${pb} is missing the current-run marker")
        }

        // The shell records a nonzero ansible-playbook exit after tee completes.
        // Parse it independently of PLAY RECAP so unreachable/parser failures
        // cannot be mistaken for success merely because failed=0.
        def ansibleExitStatus = 0
        def exitStatusMarker = '[ANSIBLE_EXIT_STATUS:'
        if (testOutput.contains(exitStatusMarker)) {
            def outputLines = testOutput.split('\n')
            for (int i = 0; i < outputLines.size(); i++) {
                def line = outputLines[i]
                def markerIdx = line.indexOf(exitStatusMarker)
                if (markerIdx >= 0) {
                    def afterMarker = line.substring(markerIdx + exitStatusMarker.length())
                    def endIdx = afterMarker.indexOf(']')
                    if (endIdx > 0) {
                        def statusValue = afterMarker.substring(0, endIdx).trim().replaceAll('[^0-9]', '')
                        if (statusValue.length() > 0) {
                            def parsedStatus = statusValue as Integer
                            if (parsedStatus > ansibleExitStatus) {
                                ansibleExitStatus = parsedStatus
                            }
                        }
                    }
                }
            }
            echo "📍 Recorded ansible-playbook exit status: ${ansibleExitStatus}"
        }

        // Extract duration from test output
        def durationSeconds = 0
        def durationStr = "N/A"
        if (testOutput.contains('[DURATION_SECONDS:')) {
            def durationIdx = testOutput.indexOf('[DURATION_SECONDS:')
            if (durationIdx >= 0) {
                def afterDuration = testOutput.substring(durationIdx + 19) // "[DURATION_SECONDS: ".length() = 19
                def endIdx = afterDuration.indexOf(']')
                if (endIdx > 0) {
                    def durationValue = afterDuration.substring(0, endIdx).trim()
                    try {
                        durationSeconds = durationValue as Integer
                        def minutes = durationSeconds / 60
                        def seconds = durationSeconds % 60
                        durationStr = String.format("%dm %ds", minutes as Integer, seconds as Integer)
                        echo "⏱️ Test duration: ${durationStr} (${durationSeconds}s)"
                    } catch (Exception e) {
                        echo "⚠️ Could not parse duration: ${durationValue}"
                        durationStr = "N/A"
                    }
                }
            }
        }

        def activityKey = activityResultKey(ndfcConfig, pb, expectedRunMarker)
        if (MODULE_ACTIVITY_RESULTS.containsKey(activityKey)) {
            MODULE_ACTIVITY_RESULTS[activityKey].duration = durationStr
        }

        // Pattern 1: Check for Ansible PLAY RECAP failures using simple string operations
        // Example: "leaf1 : ok=5 changed=3 unreachable=0 failed=2 skipped=1"
        def failedCount = 0
        def okCount = 0
        def skippedCount = 0
        def hasRecap = testOutput.contains('PLAY RECAP')
        
        if (hasRecap) {
            echo "✅ Found PLAY RECAP in output"
            // Use simple string matching instead of regex to avoid CPS issues
            def lines = testOutput.split('\n')
            for (int i = 0; i < lines.size(); i++) {
                def line = lines[i]
                // Look for "failed=" pattern
                if (line.contains('failed=')) {
                    // Extract the number after "failed="
                    def failedIdx = line.indexOf('failed=')
                    if (failedIdx >= 0) {
                        def afterFailed = line.substring(failedIdx + 7) // "failed=".length() = 7
                        // Find the next space or end of string
                        def endIdx = afterFailed.indexOf(' ')
                        def failedStr = (endIdx > 0) ? afterFailed.substring(0, endIdx) : afterFailed
                        // Remove any non-digit characters
                        failedStr = failedStr.replaceAll('[^0-9]', '')
                        if (failedStr.length() > 0) {
                            def failed = failedStr as Integer
                            failedCount += failed
                            echo " Found failed=${failed} in line: ${line.trim()}"
                        }
                    }
                }
                // Look for "ok=" pattern
                if (line.contains('ok=')) {
                    // Extract the number after "ok="
                    def okIdx = line.indexOf('ok=')
                    if (okIdx >= 0) {
                        def afterOk = line.substring(okIdx + 3) // "ok=".length() = 3
                        // Find the next space or end of string
                        def endIdx = afterOk.indexOf(' ')
                        def okStr = (endIdx > 0) ? afterOk.substring(0, endIdx) : afterOk
                        // Remove any non-digit characters
                        okStr = okStr.replaceAll('[^0-9]', '')
                        if (okStr.length() > 0) {
                            def ok = okStr as Integer
                            okCount += ok
                            echo " Found ok=${ok} in line: ${line.trim()}"
                        }
                    }
                }
                // Look for "skipped=" pattern
                if (line.contains('skipped=')) {
                    def skipIdx = line.indexOf('skipped=')
                    if (skipIdx >= 0) {
                        def afterSkip = line.substring(skipIdx + 8) // "skipped=".length() = 8
                        def endIdx = afterSkip.indexOf(' ')
                        def skipStr = (endIdx > 0) ? afterSkip.substring(0, endIdx) : afterSkip
                        skipStr = skipStr.replaceAll('[^0-9]', '')
                        if (skipStr.length() > 0) {
                            def skipped = skipStr as Integer
                            skippedCount += skipped
                            echo " Found skipped=${skipped} in line: ${line.trim()}"
                        }
                    }
                }
            }

            // A module whose declared lab substrate (port/link/vPC) is unavailable ends cleanly after the
            // planner emits NDP_MODULE_SKIPPED. Report it as SKIP with the reason rather than a misleading OK.
            def moduleSkipped = false
            def skipNote = ''
            def skipMarkerIdx = testOutput.indexOf('NDP_MODULE_SKIPPED')
            if (skipMarkerIdx >= 0 && failedCount == 0 && ansibleExitStatus == 0) {
                moduleSkipped = true
                def skipTail = testOutput.substring(skipMarkerIdx, Math.min(testOutput.length(), skipMarkerIdx + 420))
                skipTail = skipTail.replace('\r', ' ').replace('\n', ' ').replaceAll('\\s+', ' ')
                def cutAt = skipTail.length()
                ['\'', ' Read `', ' TASK [', ' PLAY ['].each { token ->
                    def tokenIdx = skipTail.indexOf(token, 20)
                    if (tokenIdx > 0 && tokenIdx < cutAt) {
                        cutAt = tokenIdx
                    }
                }
                skipNote = skipTail.substring(0, cutAt).replace('|', '/').trim()
                if (skipNote.length() > 200) {
                    skipNote = skipNote.substring(0, 200)
                }
            }

            // Every run gates the build and is counted in both totals (smoke included).
            totalFailedCount += failedCount
            def currentTotalFailed = env.TOTAL_FAILED_COUNT as Integer
            env.TOTAL_FAILED_COUNT = (currentTotalFailed + failedCount).toString()
            def currentTotalPassed = env.TOTAL_PASSED_COUNT as Integer
            env.TOTAL_PASSED_COUNT = (currentTotalPassed + (moduleSkipped ? 0 : okCount)).toString()

            echo "📊 Diagnostic Ansible failed-task count: ${failedCount} | Duration: ${durationStr} | Playbook: ${pb} | Fabric: ${reportingFabric} (${reportingScope})"

            // Per-module result ROW (pipe-delimited; rendered as an aligned table by
            // formatResultsTable). All runs are shown; smoke playbooks are tagged "(smoke)".
            // Fields: status|playbook|fabric|nd|passed|failed|skipped|duration|note
            def pbLabel = (testType == 'smoke') ? "${pb} (smoke)" : pb
            def rowStatus = moduleSkipped ? 'SKIP' : ((failedCount > 0 || ansibleExitStatus > 0) ? 'FAIL' : 'OK')
            if (moduleSkipped) {
                echo "Module ${pb} skipped because its declared lab substrate is unavailable: ${skipNote}"
                TEST_RESULT_SUMMARY_BUF += "\n${rowStatus}|${pbLabel}|${reportingFabric}|${ndfcConfig.version}|-|-|-|${durationStr}|${skipNote}|${reportingScope}"
            } else {
                TEST_RESULT_SUMMARY_BUF += "\n${rowStatus}|${pbLabel}|${reportingFabric}|${ndfcConfig.version}|${okCount}|${failedCount}|${skippedCount}|${durationStr}||${reportingScope}"
            }
        }
        
        // Check for failures
        if (ansibleExitStatus > 0) {
            setFailureFlag(failureFlagName, true)
            echo "❌ ${ndfcConfig.fabric_name} Ansible execution exited with status ${ansibleExitStatus}"
            error("Test stage failed: Ansible exited with status ${ansibleExitStatus}")
        } else if (hasRecap && failedCount > 0) {
            setFailureFlag(failureFlagName, true)
            //BUILD_FAILURE_REASON_BUF += "❌ ${ndfcConfig.fabric_name} tests failed on ND ${ndfcConfig.version}: ${failedCount} tasks failed (Playbook: ${pb})"
            echo "❌ ${ndfcConfig.fabric_name} test parsing: ${failedCount} tasks failed"
            error("Test stage failed: ${failedCount} tasks failed")
        } else if (hasRecap) {
            echo "✅ ${ndfcConfig.fabric_name} test parsing completed - All tasks passed (0 failed)"
        } else {
            // Pattern 2: Fallback - check for generic test pattern using string operations
            echo "⚠️ No PLAY RECAP found, checking for generic test pattern"
            if (testOutput.contains(' tests, ') && testOutput.contains(' failed, ')) {
                // Try to extract test counts using string operations
                def lines = testOutput.split('\n')
                for (int i = 0; i < lines.size(); i++) {
                    def line = lines[i]
                    if (line.contains(' tests, ') && line.contains(' passed, ') && line.contains(' failed, ')) {
                        echo "Found test summary line: ${line}"
                        // Simple parsing without regex
                        def parts = line.split(',')
                        def failedTests = 0
                        for (int j = 0; j < parts.size(); j++) {
                            if (parts[j].contains(' failed')) {
                                def failedPart = parts[j].trim().split(' ')[0]
                                failedTests = failedPart as Integer
                                break
                            }
                        }
                        
                        if (failedTests > 0) {
                            setFailureFlag(failureFlagName, true)
                            if (BUILD_FAILURE_REASON_BUF) {
                                BUILD_FAILURE_REASON_BUF += "\n"
                            }
                            BUILD_FAILURE_REASON_BUF += "❌ ${ndfcConfig.fabric_name} tests failed on ND ${ndfcConfig.version}: ${failedTests} tests failed (Playbook: ${pb})"
                            echo "❌ ${ndfcConfig.fabric_name} test parsing: ${failedTests} tests failed"
                            error("Test stage failed: ${failedTests} tests failed")
                        } else {
                            echo "✅ ${ndfcConfig.fabric_name} test parsing completed - 0 tests failed"
                        }
                        break
                    }
                }
            } else {
                echo "⚠️ Could not parse test results for ${ndfcConfig.fabric_name} - no standard pattern found"
                echo "📄 Output preview: ${testOutput.substring(0, Math.min(300, testOutput.length()))}"
                // No PLAY RECAP and no generic pattern -> the target errored before
                // any task ran (e.g. a playbook-style target run via include_role, or
                // a parse error). Surface it instead of silently dropping the module.
                def pbLabelErr = (testType == 'smoke') ? "${pb} (smoke)" : pb
                TEST_RESULT_SUMMARY_BUF += "\nERR|${pbLabelErr}|${reportingFabric}|${ndfcConfig.version}|-|-|-|-|did not run (no PLAY RECAP -- see console)|${reportingScope}"
                setFailureFlag(failureFlagName, true)
            }
        }
        
    } catch (FileNotFoundException e) {
        echo "⚠️ Test output file not found: ${testOutputFileName}"
        setFailureFlag(failureFlagName, true)
        // Keep the DETAILED table consistent: show this module as an ERROR row
        // (same shape as the pass/fail rows) instead of leaving the section empty.
        TEST_RESULT_SUMMARY_BUF += "\nERR|${pb}|${reportingFabric}|${ndfcConfig.version}|-|-|-|-|no test output (see console)|${reportingScope}"
        if (BUILD_FAILURE_REASON_BUF) {
            BUILD_FAILURE_REASON_BUF += "\n"
        }
        BUILD_FAILURE_REASON_BUF += "❌ ${ndfcConfig.fabric_name} test output file not found on ND ${ndfcConfig.version} (Playbook: ${pb})"
        error("Test output file not found: ${testOutputFileName}")
    } catch (Exception e) {
        def failureMessage = e.getMessage() ?: e.getClass().getName()
        if (failureMessage.contains("Test stage failed")) {
            // Re-throw test errors
            throw e
        } else {
            // Handle file reading or parsing errors
            echo "⚠️ Error parsing test results for ${ndfcConfig.fabric_name}: ${failureMessage}"
            setFailureFlag(failureFlagName, true)
            // Keep the DETAILED table consistent: show this module as an ERROR row
            // (same shape as the pass/fail rows) instead of leaving the section empty.
            TEST_RESULT_SUMMARY_BUF += "\nERR|${pb}|${reportingFabric}|${ndfcConfig.version}|-|-|-|-|could not parse test output (see console)|${reportingScope}"
            if (BUILD_FAILURE_REASON_BUF) {
                BUILD_FAILURE_REASON_BUF += "\n"
            }
            BUILD_FAILURE_REASON_BUF += "❌ ${ndfcConfig.fabric_name} ${pb} on ND ${ndfcConfig.version}: test output missing/unreadable"
            error("${ndfcConfig.fabric_name} test result parsing failed: ${failureMessage}")
        }
    }
}

/** Build one independent inventory, artifact namespace and failure flag per round. */
def buildRoundConfig(baseConfig, fabricRound) {
    def homeRound = FABRIC_ROUNDS[0]
    if (baseConfig.fabric_name != homeRound.fabric) {
        error("The base fabric ${baseConfig.fabric_name} must be the first round's fabric ${homeRound.fabric}")
    }
    // These values end up in shell command lines and file names, so refuse anything that is not a plain token.
    [fabricRound.fabric, fabricRound.type, fabricRound.vpcType, fabricRound.label, fabricRound.idSuffix].each { value ->
        if (value && !(value.toString() ==~ /^[A-Za-z0-9_.-]+$/)) {
            error("Unsafe fabric round value: ${value}")
        }
    }
    def roundConfig = [:]
    roundConfig.putAll(baseConfig)
    roundConfig.versionId = "${baseConfig.versionId}${fabricRound.idSuffix}".toString()
    roundConfig.fabric_name = fabricRound.fabric
    roundConfig.switches = baseConfig.switches.collect { sw ->
        [name: sw.name, ip: sw.ip, serial: sw.serial,
         fabric: (sw.fabric == baseConfig.fabric_name) ? fabricRound.fabric : sw.fabric,
         role: sw.role]
    }
    roundConfig.vpc_pair_fabric_type = fabricRound.vpcType
    roundConfig.primary_fabric_type = fabricRound.type
    roundConfig.round_label = fabricRound.label
    roundConfig.round_tag = (FABRIC_ROUNDS.size() > 1) ? " (${fabricRound.label})".toString() : ''
    // Only a round that leaves the canonical fabric needs the Consul lab files re-targeted.
    roundConfig.round_render = (fabricRound.fabric != homeRound.fabric)
    // Every fabric a VXLAN switch may be moved out of when it is re-homed into this round's fabric.
    roundConfig.rehome_fabrics = FABRIC_ROUNDS.collect { it.fabric }.unique()
    return roundConfig
}

/**
 * Re-targets the freshly installed Consul lab files (profile registry, validator, runner, reset playbook, switch
 * roster, ...) for a round whose primary fabric is not the canonical one. The validator's render-round command checks
 * the whole rendered set against the rendered validator before it replaces a single file, and keeps the untouched
 * canonical roster as integration_config.home.yml for the return to the home fabric. A failure leaves the canonical
 * files in place and fails the round.
 */
def applyFabricRound(ndfcConfig) {
    if (!ndfcConfig.round_render) {
        return
    }
    stage("NDFC ${ndfcConfig.version}${ndfcConfig.round_tag ?: ''} - Prepare ${ndfcConfig.round_label} fabric round") {
        echo "⏱ Preparing the ${ndfcConfig.round_label} round on ${ndfcConfig.fabric_name} (type ${ndfcConfig.primary_fabric_type}) at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
        withEnv(["ROUND_FABRIC=${ndfcConfig.fabric_name}",
                 "ROUND_FABRIC_TYPE=${ndfcConfig.primary_fabric_type}",
                 "ROUND_ND_HOST=${env.ANSIBLE_HOST}"]) {
            // Read-only check first, before any file is touched or any switch is moved: the round fabric must exist and
            // report the type this round is built for. The registry, the validator and nd_manage_switches all depend on
            // it (nd_manage_switches cannot onboard switches into, for example, an ND 'routed' fabric).
            def reportedType = sh(returnStdout: true, script: '''#!/bin/bash
                set -euo pipefail
                source $HOME/ansible/venv/bin/activate
                python - <<'PY'
import json
import os
import ssl
import urllib.request

host = os.environ["ROUND_ND_HOST"]
fabric = os.environ["ROUND_FABRIC"]
context = ssl._create_unverified_context()


def call(path, body=None, token=None):
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request("https://%s%s" % (host, path), data=data, method="POST" if body is not None else "GET")
    request.add_header("Content-Type", "application/json")
    if token:
        request.add_header("Authorization", "Bearer " + token)
    with urllib.request.urlopen(request, context=context, timeout=60) as response:
        return json.loads(response.read().decode())


try:
    login = {"userName": os.environ["NDFC_USER"], "userPasswd": os.environ["NDFC_PASSWORD"], "domain": "local"}
    token = call("/login", login)["jwttoken"]
    body = call("/api/v1/manage/fabrics/" + fabric, token=token)
    print((body.get("current", body).get("management") or {}).get("type", ""))
except Exception as exc:
    print("UNREADABLE: %s" % exc)
PY
            ''').trim()
            if (reportedType.startsWith('UNREADABLE')) {
                error("Cannot read ${ndfcConfig.fabric_name} from ND to verify its type (${reportedType})")
            }
            // The module supports vxlanEbgp; a generic routed fabric is not
            // sufficient evidence that this destination accepts VXLAN switches.
            if (reportedType.toLowerCase() != ndfcConfig.primary_fabric_type.toLowerCase()) {
                error("${ndfcConfig.fabric_name} reports '${reportedType}', expected '${ndfcConfig.primary_fabric_type}'; no switches were moved")
            }
            echo "NDP_FABRIC_DESTINATION_VALIDATED: ${ndfcConfig.fabric_name} (${reportedType})"
            sh '''#!/bin/bash
                set -euo pipefail
                cd ${COLLECTIONS_DIRECTORY}
                source $HOME/ansible/venv/bin/activate
                if ! grep -q 'render-round' validate_nd_prerequisites.py; then
                    echo "❌ The Consul validate_nd_prerequisites.py predates fabric-round support (no render-round command); publish the updated file to Consul before running more than one round" >&2
                    exit 1
                fi
                python validate_nd_prerequisites.py render-round \
                    --root "${COLLECTIONS_DIRECTORY}" \
                    --round-fabric "${ROUND_FABRIC}" \
                    --round-type "${ROUND_FABRIC_TYPE}"
            '''
        }
        env.HOME_ROSTER_COPY_READY = 'true'
    }
}

/** Return the movable roster to its canonical fabric on every exit path. */
def restoreHomeFabric(roundConfigs, activeRound) {
    if (env.HOME_RESTORE_REQUIRED != 'true') { return }
    env.ND_HOME_RECOVERY_STATUS = 'unverified'
    if (env.REQUIRED_FILES_READY != 'true') {
        env.ND_SWITCH_RESTORE_FAILED = 'true'
        env.PIPELINE_FAILED = 'true'
        env.ND_HOME_RECOVERY_STATUS = 'failed'
        error('NDP_SWITCH_HOME_RESTORE_FAILED: required runtime files are unavailable')
    }
    // Clear pairs/resources using the active rendered configuration before a
    // membership move; ND refuses to remove a switch that remains in a vPC pair.
    def homeConfig = roundConfigs[0]
    try {
        resetFabricBetweenVersions("${activeRound.round_tag ?: ''} - before home restore")
        def homeRoster = env.HOME_ROSTER_COPY_READY == 'true' ?
            "${COLLECTIONS_DIRECTORY}/integration_config.home.yml" : "${COLLECTIONS_DIRECTORY}/integration_config.yml"
        withCredentials([usernamePassword(credentialsId: SWITCH_CREDENTIALS_ID,
                                          usernameVariable: 'ANSIBLE_NXOS_SWITCH_USERNAME',
                                          passwordVariable: 'ANSIBLE_NXOS_SWITCH_PASSWORD')]) {
            generateDynamicInventory(homeConfig)
            runSwitchMembershipSync(homeConfig, 'home', homeRoster)
        }
    } catch (Exception e) {
        env.ND_SWITCH_RESTORE_FAILED = 'true'
        env.PIPELINE_FAILED = 'true'
        env.ND_HOME_RECOVERY_STATUS = 'unverified'
        rethrowIfInterrupt(e)
        env.ND_HOME_RECOVERY_STATUS = 'failed'
        echo "NDP_SWITCH_HOME_RESTORE_FAILED: home membership was not confirmed; ${e.getMessage()}"
        throw e
    }
    env.ND_HOME_RECOVERY_STATUS = 'confirmed'
    env.HOME_RESTORE_REQUIRED = 'false'
    echo "NDP_SWITCH_HOME_RESTORE_COMPLETE: full roster confirmed on ${homeConfig.fabric_name}"
}

/** Show modules blocked before execution without inventing test-case counts. */
def recordUnstartedRound(ndfcConfig, reason) {
    def pairRows = VPC_PAIR_EXECUTIONS.collect { run ->
        [id: run.id, fabric: run.id == 'advanced' ? ndfcConfig.fabric_name : run.fabric,
         type: run.id == 'advanced' ? ndfcConfig.vpc_pair_fabric_type : run.type]
    }
    def targets = []
    (INTEGRATION_MODULES + INTERFACE_INTEGRATION_MODULES + TRAILING_INTEGRATION_MODULES).each { module ->
        targets.add(module)
        if (module == 'nd_manage_policy_group') {
            targets.addAll(pairRows.collect { "nd_vpc_pair.${it.id}".toString() })
        }
    }
    targets.addAll(PLAYBOOK_FILES)
    targets.each { module ->
        def prefix = "${ndfcConfig.versionId}|${module}|".toString()
        if (!MODULE_ACTIVITY_RESULTS.keySet().any { it.startsWith(prefix) }) {
            def context = resultContextForTarget(ndfcConfig, module, ndfcConfig.fabric_name, pairRows)
            MODULE_ACTIVITY_RESULTS[prefix + 'not-run'] = [module: module, nd: ndfcConfig.version,
                round_label: ndfcConfig.round_label, fabric: context.fabric, scope: context.scope,
                result: 'NOT_RUN', coverage: 'UNKNOWN', counts: [:], case_totals: [:],
                failure: (reason ?: 'round not reached').toString().replace('|', '/').replace('\n', ' ').take(170)]
        }
    }
}

/** Reset the currently installed round's resources before switching membership. */
def resetFabricBetweenVersions(roundTag = '') {
    stage("Reset Fabric Between NDFC Versions${roundTag}") {
        // echo timestamp when stage starts
        echo "⏱ Stage 'Reset Fabric Between NDFC Versions' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
        try {
            // Use dynamic inventory if available, otherwise fallback to default inventory in collections dir
            def currentInventory = env.CURRENT_NDFC_INVENTORY ?: "${COLLECTIONS_DIRECTORY}/inventory.yaml"
            def resetFabricYaml = """${COLLECTIONS_DIRECTORY}/reset_fabric.yaml"""

            echo "📍 Using inventory for reset: ${currentInventory}"
            echo "📍 Using reset fabric yaml: ${resetFabricYaml}"

            // Verify inventory file exists using reusable function
            verifyInventoryFile(currentInventory)

            // List of fabrics to reset
            ['${FABRIC_NAME}'].each { fabric ->
                try {
                    echo "🔄 Resetting fabric: ${fabric}"
                    // IMPORTANT: cd into the collection dir and activate the venv in the
                    // SAME shell as ansible-playbook so the collection's ansible.cfg
                    // (collections_path/roles_path) is auto-loaded. A standalone
                    // `sh "cd ..."` runs in its own shell and has no effect, which made
                    // ansible run from the Jenkins workspace and fail to resolve
                    // cisco.nd.* modules (e.g. nd_manage_l3out).
                    // #!/bin/bash is required: the default /bin/sh (dash) has no
                    // `source` builtin, so this exited 127 and skipped the reset.
                    sh """#!/bin/bash
                        set -e
                        cd ${COLLECTIONS_DIRECTORY}
                        source \$HOME/ansible/venv/bin/activate
                        ansible-playbook -i ${currentInventory} ${resetFabricYaml}
                    """
                    echo "✅ Reset ${fabric} successfully"
                } catch (Exception e) {
                    echo "⚠️  Failed to reset ${fabric}: ${e.getMessage()}"
                    throw e
                }
            }

            echo "⏳ Waiting 3 minutes for fabric reset to complete..."
            //sleep(180) // Wait 3 minutes to ensure fabric reset completes
            echo "✅ Fabric reset completed, ready for next ND version"

        } catch (Exception e) {
            echo "⚠️  Fabric reset encountered issues: ${e.getMessage()}"
            throw e
        }
    }
}

def runNDFCVersionTests(ndfcConfig) {
    def roundTag = ndfcConfig.round_tag ?: ''
    stage("NDFC ${ndfcConfig.version}${roundTag} - Run NDFCVersion Tests") {
        // echo timestamp when stage starts
        echo "⏱ Stage 'NDFC ${ndfcConfig.version} - Run NDFCVersion Tests' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
        env.NDFC_HOST = env.NDFC_HOST_CURRENT
        script {
            if (env.ND_RUNTIME_INPUTS_READY != 'true') { prepareRuntimeInputs() }
            // Never reuse files rendered/mutated by the previous fabric round.
            sh '''#!/bin/bash
                set -euo pipefail
                [ -d "$ND_RUNTIME_INPUTS" ] && [ ! -L "$ND_RUNTIME_INPUTS" ]
                cp -R -- "$ND_RUNTIME_INPUTS/." "$WORKSPACE/"
            '''
            env.ND_SWITCH_PREFLIGHT_READY = 'true'

        }
    }

    // Install fresh runtime inputs for this round.
    stage("NDFC ${ndfcConfig.version}${roundTag} - Install runtime inputs") {
        // echo timestamp when stage starts
        echo "⏱ Stage 'NDFC ${ndfcConfig.version}${roundTag} - Install runtime inputs' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
        // Install every Consul-sourced playbook into the collection. The list is
        // derived from the active playbooks plus the required integration runner.
        def preflightInstallFiles = (env.ND_SWITCH_PREFLIGHT_READY == 'true') ? CONSUL_PREFLIGHT_FILES : []
        def moveFiles = (PLAYBOOK_FILES + CONSUL_RUNNER_FILES + CONSUL_PREREQUISITE_FILES + CONSUL_PREREQUISITE_SUPPORT_FILES + preflightInstallFiles).unique().join(' ')
        withEnv(["MOVE_FILES=${moveFiles}"]) {
            sh '''#!/bin/bash
                set -euo pipefail

                install_required_file() {
                    required_file=$1
                    destination="${COLLECTIONS_DIRECTORY}/${required_file}"
                    [ -f "${required_file}" ] && [ ! -L "${required_file}" ] || {
                        echo "❌ Required freshly downloaded file is missing or unsafe: ${required_file}" >&2
                        exit 1
                    }
                    [ -s "${required_file}" ] || {
                        echo "❌ Required freshly downloaded file is empty: ${required_file}" >&2
                        exit 1
                    }
                    mkdir -p "$(dirname "${destination}")"
                    [ ! -d "${destination}" ] || {
                        echo "❌ Required file destination is unexpectedly a directory: ${destination}" >&2
                        exit 1
                    }
                    mv -- "${required_file}" "${destination}"
                    [ -f "${destination}" ] || {
                        echo "❌ Required file was not installed: ${destination}" >&2
                        exit 1
                    }
                }

                install_required_file integration_config.yml
                install_required_file inventory.yaml
                install_required_file ansible.cfg
                install_required_file reset_fabric.yaml

                # Install every required Consul-sourced playbook.
                for p in ${MOVE_FILES}; do
                    install_required_file "$p"
                done
                cd ${COLLECTIONS_DIRECTORY}
                # Check source and helper compatibility before round setup or switch preflight.
                [ "$(git remote get-url origin)" = "$ND_GIT_REPOSITORY" ] || { echo 'NDP_SELECTED_SOURCE_ORIGIN_MISMATCH' >&2; exit 1; }
                "${BASE_DIRECTORY}/venv/bin/python" "${COLLECTIONS_DIRECTORY}/nd_verify_develop_sources.py" \
                    --collection-root "${COLLECTIONS_DIRECTORY}" \
                    --expected-branch "${ND_GIT_BRANCH}" \
                    --expected-commit "${ND_GIT_COMMIT}"
            '''
        }
        env.REQUIRED_FILES_READY = 'true'
        // The requested branch was validated and installed in the Clone Repository stage.
    }

    applyFabricRound(ndfcConfig)

    echo "⏱ Stage 'NDFC ${ndfcConfig.version}${roundTag} - Fabric Tests' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
    // The Consul runner and nd_ensure_switches.yaml read these exact environment
    // variables. Bind them around the complete lifecycle so switch onboarding and
    // the included nd_manage_switches test receive the masked device credential.
    withCredentials([usernamePassword(credentialsId: SWITCH_CREDENTIALS_ID,
                                      usernameVariable: 'ANSIBLE_NXOS_SWITCH_USERNAME',
                                      passwordVariable: 'ANSIBLE_NXOS_SWITCH_PASSWORD')]) {
        // Fail before onboarding or destructive integration setup if the Jenkins
        // credential is present but either field is blank. Never print credential
        // contents; the Jenkins credential binding masks them in Ansible subprocesses.
        sh '''#!/bin/bash
            set -euo pipefail
            if [ -z "${ANSIBLE_NXOS_SWITCH_USERNAME:-}" ]; then
                echo "❌ Jenkins credential SWITCH_CREDENTIALS has an empty username; provide valid switch login credentials." >&2
                exit 1
            fi
            if [ -z "${ANSIBLE_NXOS_SWITCH_PASSWORD:-}" ]; then
                echo "❌ Jenkins credential SWITCH_CREDENTIALS has an empty password; provide valid switch login credentials." >&2
                exit 1
            fi
            echo "✅ Switch credential binding is present (values masked)."
        '''
        generateDynamicInventory(ndfcConfig)
        // Full preflight and post/home recovery guard the round boundaries.
        // Physical targets recheck topology; the first reuses the successful preflight.
        // Controller/logical targets need no physical-switch guard.
        // Set before pre-flight: a partial transfer must still get home recovery.
        env.ND_HOME_RECOVERY_STATUS = 'unverified'
        env.HOME_RESTORE_REQUIRED = 'true'
        def preflightCompleted = false
        def primaryFailure = null
        try {
            runSwitchPreflight(ndfcConfig)
            preflightCompleted = true
            runFabricTest(ndfcConfig)
        } catch (Exception e) {
            primaryFailure = e
            throw e
        } finally {
            try {
                if (preflightCompleted) {
                    runSwitchPostRestore(ndfcConfig)
                } else {
                    env.ND_SWITCH_RESTORE_FAILED = 'true'
                    env.PIPELINE_FAILED = 'true'
                    echo "NDP_SWITCH_ACTIVE_ROUND_RESTORE_SKIPPED: ${ndfcConfig.fabric_name}; pre-flight did not complete. Outer home-fabric recovery remains required."
                }
            } catch (Exception recoveryError) {
                if (primaryFailure != null) {
                    rethrowIfInterrupt(primaryFailure)
                    rethrowIfInterrupt(recoveryError)
                    echo "NDP_SWITCH_SECONDARY_RECOVERY_ERROR: ${recoveryError.getClass().getName()}; preserving the primary failure"
                    throw primaryFailure
                }
                throw recoveryError
            }
        }
    }
}

/**
 * Enforced switch-membership pre-flight. Before the module suite runs it confirms
 * every canonical fabric switch is present in ND and, for any that are missing,
 * adds them (ND erases and reloads each switch first) then recalculates & deploys the fabric,
 * and finally REQUIRES the full 6+2 topology to be confirmed present. A failure
 * FAILS the build so the suite never starts on a broken topology. Audit-only (no
 * mutation) during a prerequisite-only run.
 */
def runSwitchPreflight(ndfcConfig) {
    runSwitchMembershipSync(ndfcConfig, 'pre')
}

/**
 * Post-suite switch-membership restore. The nd_manage_switches integration
 * target is destructive against the real VXLAN_EVPN_Fabric — its base "Clean Up
 * Existing Devices" deletes every switch and the overridden/deleted test cases
 * remove the rest — and it ships no cleanup.yaml, so the suite leaves the fabric
 * emptied (most visibly 192.0.2.196 / vxlan_leaf_2). Re-run the same
 * self-healing onboard AFTER the suite so the canonical switches are restored at
 * the end of the run instead of staying missing until the next night's
 * pre-flight. An incomplete restore marks the build failed and blocks the next
 * round. The outer finally still attempts the return to the home fabric.
 */
def runSwitchPostRestore(ndfcConfig) {
    runSwitchMembershipSync(ndfcConfig, 'post')
}

/**
 * Shared switch-membership sync used by both the pre-flight and the post-suite
 * restore. phase 'pre' is an ENFORCED gate: it adds every missing canonical
 * switch, recalculates & deploys its fabric, then requires the full 6+2 topology
 * to be confirmed present — a failure here FAILS the build so the suite never
 * starts on a broken topology. phase 'post' restores switches a destructive module
 * removed; a failure blocks later rounds and keeps the build failed. The pre-flight always
 * onboards + recalculates & deploys (prerequisites are always applied).
 */
def runSwitchMembershipSync(ndfcConfig, phase, rosterFile = '') {
    def isPost = (phase != 'pre')
    def label = phase == 'home' ? 'home-fabric restore' : (isPost ? 'restore' : 'pre-flight')
    def rosterPath = rosterFile ?: "${COLLECTIONS_DIRECTORY}/integration_config.yml"
    def rehomeFabrics = (ndfcConfig.rehome_fabrics ?: []).join(',')
    if (env.ND_SWITCH_PREFLIGHT_READY != 'true') {
        // A missing membership guard must not be treated as a successful
        // pre-flight. Without it, a stale Consul runner can send an external
        // switch serial to a primary-fabric module and later modules can run
        // against an emptied/partial fabric.
        env.ND_SWITCH_RESTORE_FAILED = 'true'
        env.PIPELINE_FAILED = 'true'
        error("Switch membership ${label} cannot run: nd_ensure_switches.yaml is not available from Consul")
    }
    def stageName = "Switch ${label} on NDFC ${ndfcConfig.version}${ndfcConfig.round_tag ?: ''}"
    stage(stageName) {
        echo "⏱ Stage '${stageName}' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
        def inventoryFile = env.CURRENT_NDFC_INVENTORY ?: "${COLLECTIONS_DIRECTORY}/inventory.yaml"
        // Both phases onboard: pre-flight now ENFORCES add + recalculate & deploy +
        // confirm the full 6+2 topology, and post restores what a destructive module
        // removed. Only a prerequisite-only audit stays read-only.
        def autoOnboard = (env.ND_PREREQUISITE_ONLY_EFFECTIVE != 'true')
        def shellExit
        def timeoutLimit = env.ND_SWITCH_SYNC_TIMEOUT ?: '3600'
        try {
            shellExit = withEnv(["PREFLIGHT_INVENTORY=${inventoryFile}",
                         "PREFLIGHT_ROSTER=${rosterPath}",
                         "PREFLIGHT_REHOME_FABRICS=${rehomeFabrics}",
                         "PREFLIGHT_APPLY=${autoOnboard}",
                         "PREFLIGHT_FAIL_ON_MISSING=false",
                         "PREFLIGHT_TIMEOUT=${timeoutLimit}"]) {
                    sh(script: '''#!/bin/bash
                    set -e
                    cd ${COLLECTIONS_DIRECTORY}
                    source $HOME/ansible/venv/bin/activate
                    PLAYBOOK="${COLLECTIONS_DIRECTORY}/nd_ensure_switches.yaml"
                    if [ ! -f "${PREFLIGHT_INVENTORY}" ] || [ -L "${PREFLIGHT_INVENTORY}" ] || [ ! -s "${PREFLIGHT_INVENTORY}" ]; then
                        echo "❌ Pre-flight inventory not found or unsafe: ${PREFLIGHT_INVENTORY}" >&2
                        exit 1
                    fi
                    if [ ! -f "${PLAYBOOK}" ] || [ -L "${PLAYBOOK}" ] || [ ! -s "${PLAYBOOK}" ]; then
                        echo "❌ Pre-flight playbook missing or unsafe: ${PLAYBOOK}" >&2
                        exit 1
                    fi
                    if [ ! -f "${PREFLIGHT_ROSTER}" ] || [ -L "${PREFLIGHT_ROSTER}" ] || [ ! -s "${PREFLIGHT_ROSTER}" ]; then
                        echo "Required switch roster is missing or unsafe" >&2
                        exit 1
                    fi
                    if ! grep -q 'NDP_SWITCH_PREDELETE_DEPLOY_CONFIRMED' "${PLAYBOOK}"; then
                        echo "Required nd_ensure_switches.yaml lacks verified pre-delete deployment; publish the matching runtime release" >&2
                        exit 1
                    fi
                    echo "NDP_SWITCH_MEMBERSHIP_SYNC: apply=${PREFLIGHT_APPLY}, roster=${PREFLIGHT_ROSTER}, rehome=${PREFLIGHT_REHOME_FABRICS}"
                    # Bound the complete guard invocation. Only exit 124 means
                    # this wrapper's time limit; preserve every other exit status.
                    timeout "${PREFLIGHT_TIMEOUT}" ansible-playbook -i "${PREFLIGHT_INVENTORY}" "${PLAYBOOK}" \
                        -e "nd_switch_roster_file=${PREFLIGHT_ROSTER}" \
                        -e "nd_switch_rehome_fabrics_csv=${PREFLIGHT_REHOME_FABRICS}" \
                        -e "nd_switch_apply=${PREFLIGHT_APPLY}" \
                        -e "nd_switch_deploy=true" \
                        -e "nd_switch_preserve_config=false" \
                        -e "nd_switch_guard_timeout_seconds=${PREFLIGHT_TIMEOUT}" \
                        -e "nd_switch_settle_seconds=${ND_SWITCH_SETTLE_SECONDS:-45}" \
                        -e "nd_switch_require_full_roster=true" \
                        -e "nd_switch_fail_on_missing=${PREFLIGHT_FAIL_ON_MISSING}"
                    ''', returnStatus: true)
            }
        } catch (Exception e) {
            rethrowIfInterrupt(e)
            if (isPost) {
                env.ND_SWITCH_RESTORE_FAILED = 'true'
                env.PIPELINE_FAILED = 'true'
            }
            echo "NDP_SWITCH_MEMBERSHIP_COMMAND_EXCEPTION phase=${phase} fabric=${ndfcConfig.fabric_name} timeout_limit_seconds=${timeoutLimit} exception_class=${e.getClass().getName()}; command exit status is unavailable"
            if (!isPost || phase == 'home') { throw e }
            return
        }
        def classification = shellExit == 0 ? 'SUCCESS' :
            (shellExit == 124 ? 'TIMEOUT' : (shellExit == 2 ? 'ANSIBLE_FAILED' : 'COMMAND_FAILED'))
        echo "NDP_SWITCH_MEMBERSHIP_RESULT phase=${phase} fabric=${ndfcConfig.fabric_name} exit_code=${shellExit} classification=${classification} timeout_limit_seconds=${timeoutLimit}"
        if (shellExit != 0) {
            def explanation = shellExit == 124 ? "Guard exceeded its configured ${timeoutLimit}s limit." :
                (shellExit == 2 ? 'Ansible prerequisite task failed; this was not a timeout.' : 'Prerequisite command failed.')
            def reason = "Switch membership ${label} failed: ${explanation} phase=${phase}, fabric=${ndfcConfig.fabric_name}, exit_code=${shellExit}, classification=${classification}, timeout_limit_seconds=${timeoutLimit}."
            echo 'Inspect the first fatal Ansible task and PLAY RECAP, including any ND removal response. Search NDP_SWITCH_PREDELETE_RESPONSE, NDP_SWITCH_PREDELETE_DEPLOY_BLOCKED, NDP_SWITCH_REMOVE and NDP_SWITCH_CONFIRM_FAIL for the sanitized controller reason.'
            if (isPost) {
                env.ND_SWITCH_RESTORE_FAILED = 'true'
                env.PIPELINE_FAILED = 'true'
                echo "NDP_SWITCH_RESTORE_INCOMPLETE: ${label}, ${ndfcConfig.fabric_name}; later rounds blocked. ${reason}"
            }
            if (!isPost || phase == 'home') { error(reason) }
            return
        }
        if (isPost) { env.ND_SWITCH_RESTORE_FAILED = 'false' }
        echo "NDP_SWITCH_MEMBERSHIP_READY: ${label}, ${ndfcConfig.fabric_name}, full roster confirmed"
    }
}

def runFabricTest(ndfcConfig) {
    stage("${ndfcConfig.fabric_name} on NDFC ${ndfcConfig.version}") {
        script {
            echo "⏱ Stage '${ndfcConfig.fabric_name} on NDFC ${ndfcConfig.version}' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
            // PLAYBOOK_FILES is a @Field, so it is always in scope here -- no fallback list needed.
            def playbookFiles = PLAYBOOK_FILES

            // Active playbooks were already downloaded from Consul and installed
            // atomically by runNDFCVersionTests(). Keep this hook commented for
            // future per-playbook handling; a second download here would be unused.
            // playbookFiles.each { playbookName ->
            //     downloadFromConsul(playbookName)
            // }
            sh '''#!/bin/bash
                cd ${COLLECTIONS_DIRECTORY}
                echo "pwd: $(pwd)"
            '''

            // Prepare Groovy-side variables and call shell with them passed via environment
            // Use dynamic inventory if available, otherwise fallback to default inventory in collections dir
            def inventory_file = env.CURRENT_NDFC_INVENTORY ?: "${COLLECTIONS_DIRECTORY}/inventory.yaml"
            def inventoryVarsFile = "${inventory_file}.runtime-vars.json"
            // Must match the flag the version loop checks (NDFC_<versionId>_FAILED),
            // otherwise parseTestResults' failures never flip env.PIPELINE_FAILED.
            def failureFlagName = "NDFC_${ndfcConfig.versionId}_FAILED"
            def playbooksForShell = playbookFiles.join(' ')
            def secondaryFabricName = "${ndfcConfig.fabric_name_2 ?: 'External_Connectivity_Fabric'}".trim()
            def networkFabricName = ndfcConfig.fabric_name
            def testRunMarker = "${env.BUILD_TAG ?: 'manual'}-${ndfcConfig.versionId}-${new Date().format('yyyyMMddHHmmssSSS')}"
            // The vPC-pair switches come from this ND version's roster so a serial lives in one place only.
            def serialByName = [:]
            ndfcConfig.switches.each { sw -> serialByName[sw.name] = sw.serial }
            def vpcPairRows = []
            VPC_PAIR_EXECUTIONS.each { run ->
                def serial1 = serialByName[run.switch1]
                def serial2 = serialByName[run.switch2]
                if (!serial1 || !serial2) {
                    error("vPC pair ${run.id}: ${run.switch1} / ${run.switch2} are not both in the ${ndfcConfig.version} switch roster")
                }
                def pairFabric = run.id == 'advanced' ? ndfcConfig.fabric_name : run.fabric
                def pairType = run.id == 'advanced' ? ndfcConfig.vpc_pair_fabric_type : run.type
                vpcPairRows.add([id: run.id, fabric: pairFabric, type: pairType, switch1: serial1, switch2: serial2])
            }

            // These fixed identifiers end up in shell command lines, so refuse anything that is not a plain token.
            def runtimeIdentifiers = []
            vpcPairRows.each { row ->
                ['fabric', 'type', 'switch1', 'switch2'].each { key ->
                    runtimeIdentifiers.add([name: "vPC pair ${row.id} ${key}", value: row[key]])
                }
            }
            def unsafeRuntimeIdentifiers = runtimeIdentifiers.findAll { item ->
                item.value && !(item.value ==~ /^[A-Za-z0-9_.:-]+$/)
            }
            if (!unsafeRuntimeIdentifiers.isEmpty()) {
                error("Unsafe topology identifier(s): ${unsafeRuntimeIdentifiers.collect { it.name }.join(', ')}")
            }

            // The destructive switch lifecycle runs last and is followed by the canonical restore.
            // Run numbered links after fabric/resource tests and immediately before
            // nd_manage_switches, whose upstream setup removes all VXLAN members.
            def effectiveIntegrationModules = INTEGRATION_MODULES + INTERFACE_INTEGRATION_MODULES + TRAILING_INTEGRATION_MODULES
            // One standalone run (and output file) per fixed vPC pair: nd_vpc_pair.<id>.
            def standaloneTargets = vpcPairRows.collect { row -> "nd_vpc_pair.${row.id}".toString() }
            def orderedIntegrationTargets = []
            effectiveIntegrationModules.each { moduleName ->
                orderedIntegrationTargets.add(moduleName)
                if (moduleName == 'nd_manage_policy_group' && env.ND_PREREQUISITE_ONLY_EFFECTIVE != 'true') {
                    orderedIntegrationTargets.addAll(standaloneTargets)
                }
            }
            def plannedResultTargets = orderedIntegrationTargets.collect { [it, 'integration'] }
            if (env.ND_PREREQUISITE_ONLY_EFFECTIVE != 'true') {
                PLAYBOOK_FILES.each { plannedResultTargets.add([it, 'smoke']) }
            }
            def reportContextsForShell = plannedResultTargets.collect { target ->
                def context = resultContextForTarget(ndfcConfig, target[0], networkFabricName, vpcPairRows)
                def key = activityResultKey(ndfcConfig, target[0], testRunMarker)
                MODULE_ACTIVITY_RESULTS[key] = [module: target[0], nd: ndfcConfig.version,
                    round_label: ndfcConfig.round_label, run_id: testRunMarker, fabric: context.fabric, scope: context.scope,
                    result: 'UNKNOWN', coverage: 'UNKNOWN', counts: [:], case_totals: [:],
                    failure: 'result not collected; execution may be interrupted or not reached']
                "${target[0]}|${context.scope}|${context.fabric}"
            }.join('\n')
            def reportingLogDirectory = registerStructuredExecutions(ndfcConfig, plannedResultTargets,
                testRunMarker, networkFabricName, vpcPairRows)
            def integrationForShell = effectiveIntegrationModules.join(' ')
            def standaloneIntegrationForShell = standaloneTargets.join(' ')
            def vpcPairRunsForShell = vpcPairRows.collect { row -> "${row.id}|${row.fabric}|${row.type}|${row.switch1}|${row.switch2}".toString() }.join(' ')
            def profileCoverageForShell = (effectiveIntegrationModules + STANDALONE_INTEGRATION_MODULES).join(',')

            def duplicateIntegrationTargets = []
            INTEGRATION_MODULES.each { moduleName ->
                if (STANDALONE_INTEGRATION_MODULES.contains(moduleName)) {
                    duplicateIntegrationTargets.add(moduleName)
                }
            }
            if (!duplicateIntegrationTargets.isEmpty()) {
                error("Integration target(s) configured in both runners: ${duplicateIntegrationTargets.join(', ')}")
            }

            echo "📍 Using inventory file: ${inventory_file}"
            // Reset failure flag using Groovy function (not in shell)
            setFailureFlag(failureFlagName, false)
            echo "DEBUG: Reset ${failureFlagName} to false"
            echo "pwd: ${pwd()}"
            echo "ls -l: ${sh(script: 'ls -l', returnStdout: true)}"
            try {
                // Deploy
                stage("Tests Run ${ndfcConfig.fabric_name}") {
                    // echo timestamp when stage starts
                    echo "⏱ Stage 'Tests Run ${ndfcConfig.fabric_name}' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
                    // Infrastructure failures must escape; only a completed batch
                    // of collected module failures may continue to the next round.
                        echo "🚀 Beginning of function - Deploying ${ndfcConfig.fabric_name}"
                        echo "Using inventory file: ${inventory_file}"
                        //echo "Using playbook file: ${playbook_file}"
                        echo "Tests Run starts for ${ndfcConfig.fabric_name} to NDFC version: ${ndfcConfig.version}"
                        withEnv(["PLAYBOOK_LIST=${playbooksForShell}",
                                 "INTEGRATION_LIST=${integrationForShell}",
                                 "STANDALONE_INTEGRATION_LIST=${standaloneIntegrationForShell}",
                                 "ORDERED_INTEGRATION_LIST=${orderedIntegrationTargets.join(' ')}",
                                 "NDP_EFFECTIVE_MODULES=${profileCoverageForShell}",
                                 "VPC_PAIR_RUNS=${vpcPairRunsForShell}",
                                 "NETWORK_FABRIC_NAME=${networkFabricName}",
                                 "ND_REPORT_TARGET_CONTEXTS=${reportContextsForShell}",
                                 "TEST_RUN_MARKER=${testRunMarker}",
                                 "ND_REPORT_LOG_DIR=${reportingLogDirectory}",
                                 "ND_MODULE_BATCH_STATUS=${reportingLogDirectory}/module_batch.status",
                                 "ND_REPORT_DEBUG_ENABLED=${params.DEBUG == true}",
                                 "ND_REPORT_DEBUG_MODULES=${params.DEBUG_MODULES ?: ''}",
                                 "FABRIC_NAME=${ndfcConfig.fabric_name}",
                                 "SECONDARY_FABRIC_NAME=${secondaryFabricName}",
                                 "VERSION_ID=${ndfcConfig.versionId}",
                                 "INVENTORY_FILE=${inventory_file}",
                                 "INVENTORY_VARS_FILE=${inventoryVarsFile}",
                                 "WORKSPACE=${pwd()}"]) {
                            sh '''#!/bin/bash
                                # Keep running independent module/playbook pipelines after
                                # one Ansible failure; explicit prerequisite checks still exit.
                                set -e
                                [ ! -e "$ND_MODULE_BATCH_STATUS" ] && [ ! -L "$ND_MODULE_BATCH_STATUS" ] || exit 1

                                if [ "${ND_PREREQUISITE_ONLY_EFFECTIVE:-false}" = "true" ]; then
                                    echo "🔎 Prerequisite-only audit: skipping standalone and smoke playbooks"
                                    STANDALONE_INTEGRATION_LIST=""
                                    PLAYBOOK_LIST=""
                                fi

                                # Unique execution files are never cleared or overwritten.
                                # The queue begin gate rejects an already-started execution.

                                cd \${COLLECTIONS_DIRECTORY}
                                source \$HOME/ansible/venv/bin/activate

                                mkdir -p .nd_reporting_callbacks
                                cp "${ND_REPORTING_TOOLS}/nd_report.py" .nd_reporting_callbacks/nd_report.py
                                run_reported_playbook() {
                                    local result_module="$1" result_log="$2" result_phase="$3"
                                    shift 3
                                    export ND_RESULT_MODULE="${result_module}"
                                    case "${result_log}" in
                                        /*) export ND_RESULT_LOG="${result_log}" ;;
                                        *) export ND_RESULT_LOG="${PWD}/${result_log}" ;;
                                    esac
                                    export ND_RESULT_PHASE="${result_phase}"
                                    export ANSIBLE_CALLBACK_PLUGINS="${PWD}/.nd_reporting_callbacks"
                                    export ANSIBLE_STDOUT_CALLBACK=nd_report ANSIBLE_NOCOLOR=1
                                    export ND_REPORT_DEBUG=false ANSIBLE_VERBOSITY=0
                                    if [ "${ND_REPORT_DEBUG_ENABLED}" = true ]; then
                                        case ",${ND_REPORT_DEBUG_MODULES// /}," in
                                            ,,|*,"${result_module}",*) export ND_REPORT_DEBUG=true ANSIBLE_VERBOSITY=4 ;;
                                        esac
                                    fi
                                    local result_start result_end result_status
                                    result_start=$(date +%s)
                                    if "$@"; then result_status=0; else result_status=$?; fi
                                    result_end=$(date +%s)
                                    python "${ND_REPORTING_TOOLS}/nd_result_summary.py" record \\
                                        --log "${result_log}" --module "${result_module}" --run-id "${TEST_RUN_MARKER}" \\
                                        --started "${result_start}" --ended "${result_end}" --exit-code "${result_status}" \\
                                        --prerequisite-seconds "$((result_start - PREREQUISITE_START))" || return 125
                                    return "${result_status}"
                                }

                                begin_reported_module() {
                                    "$HOME/ansible/venv/bin/python" "$ND_REPORTING_TOOLS/nd_reporting_pipeline.py" begin \
                                        --root "$ND_REPORTING_ROOT" --version-id "$VERSION_ID" \
                                        --module "$1" --run-id "$TEST_RUN_MARKER" >/dev/null
                                }

                                close_reported_module() {
                                    # tee has drained, runner cleanup returned and the final
                                    # exit/end/duration markers have all been written.
                                    if ! "$HOME/ansible/venv/bin/python" "$ND_REPORTING_TOOLS/nd_reporting_pipeline.py" close \
                                        --root "$ND_REPORTING_ROOT" --version-id "$VERSION_ID" \
                                        --module "$1" --run-id "$TEST_RUN_MARKER" \
                                        --exit-code "$ANSIBLE_STATUS" --duration-seconds "$DURATION"; then
                                        echo "NDP_MODULE_CLOSE_FAILED: $1; final reconciliation will retain available evidence" >&2
                                        RUN_FAILURE=1
                                    fi
                                }

                                PROFILE_VALIDATOR="${COLLECTIONS_DIRECTORY}/validate_nd_prerequisites.py"
                                PROFILE_REGISTRY="${COLLECTIONS_DIRECTORY}/nd_prerequisite_profiles.yaml"
                                for required_file in "${PROFILE_VALIDATOR}" "${PROFILE_REGISTRY}"; do
                                    if [ ! -f "${required_file}" ] || [ -L "${required_file}" ] || [ ! -s "${required_file}" ]; then
                                        echo "❌ Jenkins profile coverage gate input is missing or unsafe: ${required_file}"
                                        exit 1
                                    fi
                                done
                                echo "🔎 Checking prerequisite-profile coverage for effective Jenkins modules"
                                python "${PROFILE_VALIDATOR}" coverage \
                                    --registry "${PROFILE_REGISTRY}" \
                                    --modules "${NDP_EFFECTIVE_MODULES}"
                                echo "✅ Jenkins prerequisite-profile coverage gate passed"

                                if ! command -v ansible-playbook &> /dev/null; then
                                    echo 'Error: ansible-playbook is not installed or not in PATH. Exiting.'
                                    exit 1
                                fi
                                # Verify inventory file exists
                                if [ ! -f "${INVENTORY_FILE}" ] || [ -L "${INVENTORY_FILE}" ] || [ ! -s "${INVENTORY_FILE}" ]; then
                                    echo "⚠️ Inventory file not found: ${INVENTORY_FILE}"
                                    echo "📂 Available inventory files in \${COLLECTIONS_DIRECTORY}:"
                                    ls -l \${COLLECTIONS_DIRECTORY}/inventory*.yaml || echo "No inventory files found"
                                    exit 1
                                fi
                                echo "✅ Using inventory file: ${INVENTORY_FILE}"

                                INVENTORY_VARS_TMP="${INVENTORY_VARS_FILE}.tmp"
                                cleanup_inventory_vars() {
                                    rm -f -- "${INVENTORY_VARS_TMP}" "${INVENTORY_VARS_FILE}"
                                }
                                trap cleanup_inventory_vars EXIT
                                umask 077
                                ansible-inventory -i "${INVENTORY_FILE}" --host nd_controller > "${INVENTORY_VARS_TMP}"
                                [ -s "${INVENTORY_VARS_TMP}" ] || {
                                    echo "❌ Failed to resolve runtime variables from ${INVENTORY_FILE}" >&2
                                    exit 1
                                }
                                mv -- "${INVENTORY_VARS_TMP}" "${INVENTORY_VARS_FILE}"
                                chmod 600 "${INVENTORY_VARS_FILE}"
                                echo "✅ Resolved protected runtime variables from dynamic inventory"
                                RUN_FAILURE=0
                                # Cap each module/playbook run so a hung ND call can't wedge the build for hours.
                                MODULE_TIMEOUT="${MODULE_TIMEOUT:-2400}"
                                # GreenField switch bring-up (nd_manage_switches) legitimately needs
                                # longer than lightweight modules; #16 was killed at 2400s mid switch-prep.
                                SWITCHES_MODULE_TIMEOUT="${SWITCHES_MODULE_TIMEOUT:-5400}"
                                TIMEOUT_CMD="$(command -v timeout >/dev/null 2>&1 && echo "timeout -k 60 ${MODULE_TIMEOUT}" || true)"

                                # --- Per-module switch-availability guard -------------------------
                                # Confirm the canonical 6+2 switches before physical targets and
                                # re-add any a prior destructive module (e.g. nd_manage_switches) removed,
                                # then recalculate & deploy, so a module never runs on a fabric that is
                                # missing a switch ("ND Error 400: Switch id <serial> not found"). Enforced
                                # add (apply=true) except during a prerequisite-only audit. Bounded by
                                # ND_SWITCH_GUARD_TIMEOUT (default 1800s) so greenfield reloads have time to finish.
                                # The enforced pre-flight already gates the suite start and
                                # the post-suite restore re-confirms at the end; this is the mid-suite heal.
                                # Fail closed: if the canonical roster cannot be confirmed/restored,
                                # do not run the module against a partial or stale fabric. The caller's
                                # `set -e` stops the shared-topology run before it can cascade failures.
                                SWITCH_GUARD_PLAYBOOK="${COLLECTIONS_DIRECTORY}/nd_ensure_switches.yaml"
                                SWITCH_GUARD_ROSTER="${COLLECTIONS_DIRECTORY}/integration_config.yml"
                                SWITCH_GUARD_TIMEOUT="${ND_SWITCH_GUARD_TIMEOUT:-1800}"
                                SWITCH_GUARD_APPLY="true"
                                if [ "${ND_PREREQUISITE_ONLY_EFFECTIVE:-false}" = "true" ]; then
                                    SWITCH_GUARD_APPLY="false"
                                fi
                                FIRST_TARGET_GUARD=true
                                ensure_switches_ready() {
                                    # Verify source purity before any module-specific lab changes.
                                    [ "$(git -C "$COLLECTIONS_DIRECTORY" remote get-url origin)" = "$ND_GIT_REPOSITORY" ] || { echo 'NDP_SELECTED_SOURCE_ORIGIN_MISMATCH' >&2; return 1; }
                                    python "${COLLECTIONS_DIRECTORY}/nd_verify_develop_sources.py" \
                                        --collection-root "${COLLECTIONS_DIRECTORY}" \
                                        --expected-branch "${ND_GIT_BRANCH}" \
                                        --expected-commit "${ND_GIT_COMMIT}" || return 1
                                    local _label="$1" _first="${FIRST_TARGET_GUARD}"
                                    FIRST_TARGET_GUARD=false
                                    if [ "${ND_SWITCH_PREFLIGHT_READY:-false}" != "true" ]; then
                                        echo "❌ [switch-guard] canonical switch pre-flight is unavailable; refusing to run ${_label}" >&2
                                        return 1
                                    fi
                                    # These targets own controller/logical fixtures, not lab switches.
                                    case "${2:-}" in
                                        nd_local_user|nd_manage_fabric_group_vxlan|nd_manage_fabric_group_members|nd_manage_fabric)
                                            echo "NDP_SWITCH_GUARD_NOT_APPLICABLE: ${2}; controller/logical fixture"
                                            return 0 ;;
                                    esac
                                    if [ "${_first}" = true ]; then
                                        echo "NDP_SWITCH_GUARD_REUSED_PREFLIGHT: ${_label}"
                                        return 0
                                    fi
                                    if [ ! -f "${SWITCH_GUARD_PLAYBOOK}" ] || [ -L "${SWITCH_GUARD_PLAYBOOK}" ] || [ ! -s "${SWITCH_GUARD_PLAYBOOK}" ]; then
                                        echo "❌ [switch-guard] playbook missing/unsafe; refusing to run ${_label}" >&2
                                        return 1
                                    fi
                                    local _gt
                                    _gt="$(command -v timeout >/dev/null 2>&1 && echo "timeout -k 30 ${SWITCH_GUARD_TIMEOUT}" || true)"
                                    echo "🔎 [switch-guard] Confirming canonical 6+2 switches before ${_label} (apply=${SWITCH_GUARD_APPLY}, timeout=${SWITCH_GUARD_TIMEOUT}s)"
                                    if ${_gt} ansible-playbook -i "${INVENTORY_FILE}" "${SWITCH_GUARD_PLAYBOOK}" \
                                            -e "nd_switch_roster_file=${SWITCH_GUARD_ROSTER}" \
                                            -e "nd_switch_apply=${SWITCH_GUARD_APPLY}" \
                                            -e "nd_switch_deploy=true" \
                                            -e "nd_switch_preserve_config=false" \
                                            -e "nd_switch_guard_timeout_seconds=${SWITCH_GUARD_TIMEOUT}" \
                                            -e "nd_switch_settle_seconds=${ND_SWITCH_SETTLE_SECONDS:-45}" \
                                            -e "nd_switch_require_full_roster=true" \
                                            -e "nd_switch_fail_on_missing=false"; then
                                        echo "✅ [switch-guard] Canonical switches confirmed before ${_label}"
                                    else
                                        echo "❌ [switch-guard] Could not confirm/restore the full canonical topology before ${_label}; refusing to run the module. Grep NDP_SWITCH_PREFLIGHT_MISSING / NDP_SWITCH_CONFIRM_FAIL and check device power/reachability." >&2
                                        return 1
                                    fi
                                }

                                # nd_vpc_pair runs once per fixed lab pair (VPC_PAIR_RUNS rows: id|fabric|type|switch1|switch2)
                                # immediately after nd_manage_policy_group, before destructive fabric-inventory targets.
                                # It is a complete playbook rather than a role, so execute it directly instead of using
                                # run_integration_module.yaml. A pair needs a cabled physical peer-link (virtual peering is
                                # unsupported on the N9K-C9300v lab switches); the module always runs, and the probe below only
                                # waits for ND to report that cable and logs NDP_VPC_PEERLINK_ABSENT when it never does.
                                run_standalone_integration() {
                                    local m="$1"
                                    local PEERLINK_PROBE="${INVENTORY_VARS_FILE}.peerlink-probe.yaml"
                                    echo "==========Running Standalone Integration Modules============="
                                    echo "🚀 Starting standalone integration test for $m"
                                    VPC_MODULE="${m%%.*}"
                                    VPC_RUN_ID="${m#*.}"
                                    VPC_ROW=""
                                    for row in ${VPC_PAIR_RUNS}; do
                                        case "${row}" in
                                            "${VPC_RUN_ID}|"*) VPC_ROW="${row}" ;;
                                        esac
                                    done
                                    if [ -z "${VPC_ROW}" ]; then
                                        echo "❌ No vPC pair definition for standalone target ${m}" >&2
                                        exit 1
                                    fi
                                    IFS='|' read -r _ VPC_FABRIC VPC_TYPE VPC_SW1 VPC_SW2 <<< "${VPC_ROW}"
                                    PREREQUISITE_START=$(date +%s)
                                    ensure_switches_ready "standalone module $m" "$m"
                                    TARGET_PLAYBOOK="${COLLECTIONS_DIRECTORY}/tests/integration/targets/${VPC_MODULE}/tasks/main.yaml"
                                    OUTPUT_FILE="${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt"

                                    if [ ! -f "${TARGET_PLAYBOOK}" ] || [ -L "${TARGET_PLAYBOOK}" ] || [ ! -s "${TARGET_PLAYBOOK}" ]; then
                                        echo "❌ Required standalone integration playbook is missing, empty, or unsafe: ${TARGET_PLAYBOOK}" >&2
                                        exit 1
                                    fi


                                    begin_reported_module "$m"
                                    echo "[MODULE: $m] Starting execution..." | tee -a "${OUTPUT_FILE}"
                                    echo "[RUN_MARKER: ${TEST_RUN_MARKER}]" | tee -a "${OUTPUT_FILE}"
                                    START_TIME=$(date +%s)
                                    echo "[TIMESTAMP_START: ${START_TIME}]" | tee -a "${OUTPUT_FILE}"

                                                                        # Only the canonical leaf pair has a verified physical peer-link allocation.
                                    cat > "${PEERLINK_PROBE}" <<'PEERLINK_PROBE_EOF'
[
    {
        "name": "vPC peer-link probe",
        "hosts": "nd_controller",
        "gather_facts": false,
        "tasks": [
            {
                "name": "Prepare the canonical leaf peer-link ports",
                "ansible.builtin.include_tasks": "{{ playbook_dir }}/nd_prerequisite/admin_up_interface.yaml",
                "loop": [
                    {"fabric": "{{ probe_fabric }}", "serial": "{{ probe_s1 }}", "ifname": "Ethernet1/2", "label": "vxlan_leaf_1/Ethernet1/2"},
                    {"fabric": "{{ probe_fabric }}", "serial": "{{ probe_s2 }}", "ifname": "Ethernet1/1", "label": "vxlan_leaf_2/Ethernet1/1"}
                ],
                "loop_control": {"loop_var": "_auif"},
                "when": "probe_prepare_peerlink | default(false) | bool"
            },
            {
                "name": "Read the links of the fabric",
                "cisco.nd.nd_rest": {"path": "/api/v1/manage/links?fabricName={{ probe_fabric }}", "method": "get"},
                "register": "_probe_links"
            },
            {
                "name": "Validate the link API response",
                "ansible.builtin.assert": {
                    "that": [
                        "_probe_links.status | default(0) | int == 200",
                        "_probe_links.current | default(none) is mapping",
                        "_probe_links.current.links | default(none) is sequence",
                        "_probe_links.current.links | default(none) is not string",
                        "_probe_links.current.links | default(none) is not mapping"
                    ],
                    "fail_msg": "NDP_VPC_PEERLINK_PROBE_FAILED - invalid link API response"
                }
            },
            {
                "name": "Report whether the two switches are linked",
                "ansible.builtin.debug": {
                    "msg": "{{ 'NDP_VPC_PEERLINK_PRESENT' if (_probe_links.current.links | selectattr('srcSwitchId', 'in', [probe_s1, probe_s2]) | selectattr('dstSwitchId', 'in', [probe_s1, probe_s2]) | selectattr('linkPresent', 'defined') | selectattr('linkPresent', 'equalto', true) | list | length > 0) else 'NDP_VPC_PEERLINK_ABSENT' }}"
                }
            }
        ]
    }
]
PEERLINK_PROBE_EOF
                                                                        local PREPARE_PEERLINK=false
                                                                        if [ "${VPC_RUN_ID}" = "advanced" ] && [ "${VPC_FABRIC}" = "${FABRIC_NAME}" ]; then
                                                                                PREPARE_PEERLINK=true
                                                                        fi
                                                                        local PROBE_TIMEOUT_CMD
                                                                        PROBE_TIMEOUT_CMD="$(command -v timeout >/dev/null 2>&1 && echo "timeout -k 30 ${VPC_PEERLINK_TIMEOUT:-180}" || true)"
                                    PEERLINK_TRY=0
                                    while :; do
                                                                                local PEERLINK_STATUS=0
                                                                                PEERLINK_RESULT="$(${PROBE_TIMEOUT_CMD} ansible-playbook -i "${INVENTORY_FILE}" "${PEERLINK_PROBE}" \
                                            -e "@${INVENTORY_VARS_FILE}" -e "probe_fabric=${VPC_FABRIC}" \
                                                                                        -e "probe_s1=${VPC_SW1}" -e "probe_s2=${VPC_SW2}" \
                                                                                        -e "probe_prepare_peerlink=${PREPARE_PEERLINK}" 2>&1)" || PEERLINK_STATUS=$?
                                                                                PREPARE_PEERLINK=false
                                                                                if [ "${PEERLINK_STATUS}" -ne 0 ] || ! printf '%s\n' "${PEERLINK_RESULT}" | grep -Eq 'NDP_VPC_PEERLINK_(PRESENT|ABSENT)'; then
                                                                                        printf '%s\n' "${PEERLINK_RESULT}" | tee -a "${OUTPUT_FILE}"
                                                                                        echo "NDP_VPC_PEERLINK_PROBE_FAILED [${m}] exit=${PEERLINK_STATUS}; running the module anyway, but recording the prerequisite error" | tee -a "${OUTPUT_FILE}"
                                                                                        RUN_FAILURE=1
                                                                                        break
                                                                                fi
                                                                                printf '%s\n' "${PEERLINK_RESULT}" | grep -q 'NDP_VPC_PEERLINK_PRESENT' && break
                                        PEERLINK_TRY=$((PEERLINK_TRY + 1))
                                        if [ "${PEERLINK_TRY}" -ge "${VPC_PEERLINK_ATTEMPTS:-6}" ]; then
                                                                                        echo "NDP_VPC_PEERLINK_ABSENT [integration.${m}]: ND reports no active physical peer-link between ${VPC_SW1} and ${VPC_SW2} in ${VPC_FABRIC}; running the module anyway (verify peer-link cabling and interface admin state)" | tee -a "${OUTPUT_FILE}"
                                            break
                                        fi
                                        sleep "${VPC_PEERLINK_WAIT_SECONDS:-20}"
                                    done
                                    rm -f -- "${PEERLINK_PROBE}"
                                    run_reported_playbook "$m" "${OUTPUT_FILE}" execution ${TIMEOUT_CMD} ansible-playbook -i "${INVENTORY_FILE}" "${TARGET_PLAYBOOK}" \
                                        -e "@${INVENTORY_VARS_FILE}" \
                                        -e "fabric_name=${VPC_FABRIC}" \
                                        -e "switch1_serial=${VPC_SW1}" \
                                        -e "switch2_serial=${VPC_SW2}" \
                                        -e "fabric_type=${VPC_TYPE}" \
                                        2>&1 | tee -a "${OUTPUT_FILE}"
                                    ANSIBLE_STATUS=${PIPESTATUS[0]}
                                    echo "[ANSIBLE_EXIT_STATUS: ${ANSIBLE_STATUS}]" | tee -a "${OUTPUT_FILE}"
                                    if [ "${ANSIBLE_STATUS}" -ne 0 ]; then
                                        RUN_FAILURE=1
                                    fi
                                    END_TIME=$(date +%s)
                                    DURATION=$((END_TIME - START_TIME))
                                    echo "[TIMESTAMP_END: ${END_TIME}]" | tee -a "${OUTPUT_FILE}"
                                    echo "[DURATION_SECONDS: ${DURATION}]" | tee -a "${OUTPUT_FILE}"
                                    echo "[MODULE: $m] Execution completed." | tee -a "${OUTPUT_FILE}"
                                    close_reported_module "$m"
                                }

                                echo "==========Running Integration Modules============="

                                # Run each integration module as its OWN playbook so each
                                # gets its own PLAY RECAP (passed/failed/skipped) + duration.
                                for m in ${ORDERED_INTEGRATION_LIST}; do
                                    case "${m}" in
                                        nd_vpc_pair.*)
                                            run_standalone_integration "${m}"
                                            continue
                                            ;;
                                    esac
                                    echo "🚀 Starting integ test for $m module"
                                    echo "========================================"
                                    echo "Running integration module: $m, pwd: $(pwd)"
                                    echo "========================================"
                                    PREREQUISITE_START=$(date +%s)
                                    ensure_switches_ready "integration module $m" "$m"
                                    if [ -f "${COLLECTIONS_DIRECTORY}/run_integration_module.yaml" ] && \
                                       [ ! -L "${COLLECTIONS_DIRECTORY}/run_integration_module.yaml" ] && \
                                       [ -s "${COLLECTIONS_DIRECTORY}/run_integration_module.yaml" ]; then
                                        begin_reported_module "$m"
                                        echo "[MODULE: $m] Starting execution..." | tee -a "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt"
                                        echo "[RUN_MARKER: ${TEST_RUN_MARKER}]" | tee -a "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt"
                                        START_TIME=$(date +%s)
                                        echo "[TIMESTAMP_START: ${START_TIME}]" | tee -a "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt"
                                        NETWORK_EXTRA_VARS=""
                                        if [ "${m}" = "nd_manage_networks" ]; then
                                            NETWORK_EXTRA_VARS="-e ansible_it_fabric=${NETWORK_FABRIC_NAME} -e nd_network_standalone_fabric=${NETWORK_FABRIC_NAME}"
                                        fi
                                        MODULE_TOPOLOGY_VARS=""
                                        if [ "${m}" = "nd_manage_switches" ]; then
                                            # The upstream switch target rebuilds exactly leaf/spine/border.
                                            MODULE_TOPOLOGY_VARS="-e ansible_switch1=192.0.2.195 -e ansible_switch1_serial=SERIAL00001 -e ansible_switch2=192.0.2.194 -e ansible_switch2_serial=SERIAL00003 -e ansible_switch3=192.0.2.88 -e ansible_switch3_serial=SERIAL00004"
                                        elif [ "${m}" = "nd_manage_l3out" ]; then
                                            # L3Out switch1 = vxlan_border_1 (SERIAL00004 / .88, role border): now cabled
                                            # to external_edge_1 (border_1 Eth1/1 routed <-> edge_1 Eth1/3, probe-confirmed
                                            # up/up) for the ext_l3_dci_link. border_1's baseline role is 'border', so the
                                            # verify-only l3out needs no role change. switch2 stays external_edge_1 (.89) on
                                            # Eth1/3. (Was leaf_1 while border_1 was uncabled; build #26 proved a leaf is
                                            # rejected "not a supported role for BGP L3Out".)
                                            MODULE_TOPOLOGY_VARS="-e nd_test_switch1_id=SERIAL00004 -e nd_test_switch1_mgmt_ip=192.0.2.88 -e nd_test_switch2_id=SERIAL00005 -e nd_test_switch2_mgmt_ip=192.0.2.89 -e nd_test_switch2_interface=Ethernet1/3"
                                        fi
                                        # ND 4.2 interface targets use their own nd_test_* vars (not the nd_manage_*
                                        # fabric/serial vars), so point them at THIS run's fabric + a real switch and
                                        # add the parent/member overrides each one needs. Both vars default to empty
                                        # for non-interface modules, so the command line stays unchanged for them.
                                        INTERFACE_TEST_VARS=""
                                        case "${m}" in
                                            nd_interface_*)
                                                # Interface tests use the declared default switch for this fabric round.
                                                INTERFACE_TEST_VARS="-e nd_test_fabric_name=${FABRIC_NAME} -e nd_test_switch_ip=192.0.2.195"
                                                ;;
                                        esac
                                        case "${m}" in
                                            nd_interface_subinterface_managed|nd_interface_subinterface_unmanaged)
                                                # PARENT MUST NEVER BE A FABRIC UNDERLAY UPLINK. On leaf_1 (.195)
                                                # Eth1/3 is the intra-fabric underlay to spine_1 Eth1/1 (and Eth1/2 the
                                                # leaf_1<->leaf_2 link); the subinterface test strips p2p/OSPF config,
                                                # which ND then refuses to rebuild ("Required [p2p]/OSPF configuration not
                                                # found") and holds the WHOLE VXLAN_EVPN_Fabric (spine_1/leaf_1/leaf_2/
                                                # border_1) in migration mode -- every later module then 207s "switches in
                                                # read-only mode" (live-proven configSave 500, build #27, 2026-09-16).
                                                # The default parent is the declared inter-fabric cable on leaf_1 Eth1/1.
                                                # The prerequisite gate validates the declared switch/parent and
                                                # rejects occupied or undeclared ports.
                                                # It journals temporary routedHost and memberless L3 Port-channel10 changes
                                                # and restores them after target cleanup, including failures.
                                                INTERFACE_TEST_VARS="${INTERFACE_TEST_VARS} -e nd_test_port_channel_parent=Port-channel10"
                                                ;;
                                            nd_interface_port_channel_access)
                                                INTERFACE_TEST_VARS="${INTERFACE_TEST_VARS} -e nd_test_pc_member_a=Ethernet1/10 -e nd_test_pc_member_b=Ethernet1/11 -e nd_test_pc_member_c=Ethernet1/12 -e nd_test_pc_member_d=Ethernet1/13"
                                                ;;
                                            nd_interface_port_channel_trunk_host)
                                                INTERFACE_TEST_VARS="${INTERFACE_TEST_VARS} -e nd_test_pc_member_a=Ethernet1/14 -e nd_test_pc_member_b=Ethernet1/15 -e nd_test_pc_member_c=Ethernet1/16 -e nd_test_pc_member_d=Ethernet1/17"
                                                ;;
                                            nd_interface_port_channel_routed)
                                                INTERFACE_TEST_VARS="${INTERFACE_TEST_VARS} -e nd_test_pc_member_a=Ethernet1/18 -e nd_test_pc_member_b=Ethernet1/19 -e nd_test_pc_member_c=Ethernet1/20 -e nd_test_pc_member_d=Ethernet1/21"
                                                ;;
                                        esac
                                        # Switch prep gets a longer cap than lightweight modules (see #16).
                                        if [ "${m}" = "nd_manage_switches" ]; then
                                            MOD_TIMEOUT="${SWITCHES_MODULE_TIMEOUT}"
                                        else
                                            MOD_TIMEOUT="${MODULE_TIMEOUT}"
                                        fi
                                        MOD_TIMEOUT_CMD="$(command -v timeout >/dev/null 2>&1 && echo "timeout -k 60 ${MOD_TIMEOUT}" || true)"
                                        run_reported_playbook "$m" "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt" prerequisites ${MOD_TIMEOUT_CMD} ansible-playbook -i "${INVENTORY_FILE}" "${COLLECTIONS_DIRECTORY}/run_integration_module.yaml" \
                                            -e "@${INVENTORY_VARS_FILE}" \
                                            -e "test_module=$m" \
                                            -e "fabric_name=${FABRIC_NAME}" \
                                            -e "nd_test_fabric2_name=${SECONDARY_FABRIC_NAME}" \
                                            -e "nd_prerequisite_enable=${ND_PREREQUISITE_ENABLE_EFFECTIVE}" \
                                            -e "nd_prerequisite_apply=${ND_PREREQUISITE_APPLY_EFFECTIVE}" \
                                            -e "nd_prerequisite_repair_baseline=true" \
                                            -e "nd_prerequisite_only=${ND_PREREQUISITE_ONLY_EFFECTIVE}" \
                                            -e "nd_prerequisite_mode=live" \
                                            -e "nd_prerequisite_run_id=${TEST_RUN_MARKER}_${m}" \
                                            ${NETWORK_EXTRA_VARS} ${MODULE_TOPOLOGY_VARS} ${INTERFACE_TEST_VARS} 2>&1 | tee -a "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt"
                                        ANSIBLE_STATUS=${PIPESTATUS[0]}
                                        echo "[ANSIBLE_EXIT_STATUS: ${ANSIBLE_STATUS}]" | tee -a "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt"
                                        if [ "${ANSIBLE_STATUS}" -ne 0 ]; then
                                            RUN_FAILURE=1
                                        fi
                                        END_TIME=$(date +%s)
                                        DURATION=$((END_TIME - START_TIME))
                                        echo "[TIMESTAMP_END: ${END_TIME}]" | tee -a "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt"
                                        echo "[DURATION_SECONDS: ${DURATION}]" | tee -a "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt"
                                        echo "[MODULE: $m] Execution completed." | tee -a "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${m}.txt"
                                        close_reported_module "$m"
                                    else
                                        echo "❌ Required Consul runner is missing, empty, or unsafe: run_integration_module.yaml" >&2
                                        exit 1
                                    fi
                                done

                                echo "==========Running Smoke Playbooks============="

                                # Run each smoke playbook if present
                                for pb in ${PLAYBOOK_LIST}; do
                                    ls -lrt

                                    echo "========================================"
                                    echo "Running playbook: \$pb, pwd: $(pwd)"
                                    echo "========================================"
                                    PREREQUISITE_START=$(date +%s)
                                    ensure_switches_ready "smoke playbook $pb"
                                    if [ -f "\${COLLECTIONS_DIRECTORY}/\$pb" ] && \
                                       [ ! -L "\${COLLECTIONS_DIRECTORY}/\$pb" ] && \
                                       [ -s "\${COLLECTIONS_DIRECTORY}/\$pb" ]; then

                                        begin_reported_module "$pb"
                                        echo "[PLAYBOOK: \$pb] Starting execution..." | tee -a "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt"
                                        echo "[RUN_MARKER: ${TEST_RUN_MARKER}]" | tee -a "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt"
                                        START_TIME=$(date +%s)
                                        echo "[TIMESTAMP_START: ${START_TIME}]" | tee -a "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt"
                                        echo "=============="
                                        echo "\$pb: ${pb}"
                                        echo "INVENTORY_FILE: ${INVENTORY_FILE}"
                                        run_reported_playbook "$pb" "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt" execution ${TIMEOUT_CMD} ansible-playbook -i "${INVENTORY_FILE}" "${COLLECTIONS_DIRECTORY}/${pb}" \
                                            -e "@${INVENTORY_VARS_FILE}" \
                                            2>&1 | tee -a "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt"
                                        ANSIBLE_STATUS=${PIPESTATUS[0]}
                                        echo "[ANSIBLE_EXIT_STATUS: ${ANSIBLE_STATUS}]" | tee -a "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt"
                                        if [ "${ANSIBLE_STATUS}" -ne 0 ]; then
                                            RUN_FAILURE=1
                                        fi
                                        END_TIME=$(date +%s)
                                        DURATION=$((END_TIME - START_TIME))
                                        echo "=============="
                                        echo "[TIMESTAMP_END: ${END_TIME}]" | tee -a "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt"
                                        echo "[DURATION_SECONDS: ${DURATION}]" | tee -a "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt"
                                        echo "[PLAYBOOK: \$pb] Execution completed." | tee -a "${ND_REPORT_LOG_DIR}/test_output_${FABRIC_NAME}_${VERSION_ID}_${pb}.txt"
                                        close_reported_module "$pb"
                                    else
                                        echo "❌ Required Consul playbook is missing, empty, or unsafe: \$pb" >&2
                                        exit 1
                                    fi
                                done

                                # Module case progress/skips are rendered once from the
                                # small structured summaries after both branches join.
                                echo "NDP_MODULE_BATCH_CLOSED: $FABRIC_NAME $VERSION_ID"
                                printf '%s\n' "$RUN_FAILURE" > "$ND_MODULE_BATCH_STATUS"
                                if [ "${RUN_FAILURE}" -ne 0 ]; then
                                    echo "❌ One or more Ansible runs failed; all independent runs were attempted" >&2
                                fi
                            '''
                            def batchStatus = sh(script: '''#!/bin/bash
                                set -euo pipefail
                                [ -f "$ND_MODULE_BATCH_STATUS" ] && [ ! -L "$ND_MODULE_BATCH_STATUS" ]
                                [ "$(wc -c < "$ND_MODULE_BATCH_STATUS")" -eq 2 ]
                                cat -- "$ND_MODULE_BATCH_STATUS"
                            ''', returnStdout: true).trim()
                            if (!(batchStatus in ['0', '1'])) { error('Invalid completed module-batch status') }
                            if (batchStatus == '1') {
                                setFailureFlag(failureFlagName, true)
                                env.PIPELINE_FAILED = 'true'
                                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE', catchInterruptions: false) {
                                    error('Collected module/reporting failures; continuation requires successful switch recovery')
                                }
                            }
                        }
                        echo "🚀 End of function - ${ndfcConfig.fabric_name}"
                        //parseDeploymentResults(ndfcConfig, failureFlagName)
                }

                echo "NDP_MODULE_REPORTS_QUEUED: ${ndfcConfig.fabric_name}; independent publisher owns completed evidence"
            } catch (Exception e) {
                setFailureFlag(failureFlagName, true)
                echo "❌ ${ndfcConfig.fabric_name} failed on ND ${ndfcConfig.version}: ${e.getMessage()}"
                throw e
            }
        }
    }
}


def generateDynamicInventory(ndfcConfig) {
    env.CURRENT_NDFC_INVENTORY = ''
    def inventoryFileName = "inventory_${ndfcConfig.versionId}.yaml"
    def inventoryDestination = "${COLLECTIONS_DIRECTORY}/${inventoryFileName}"
    def switchesByName = ndfcConfig.switches.collectEntries { [(it.name): it] }
    ['vxlan_leaf_1', 'vxlan_leaf_2', 'vxlan_spine_1', 'vxlan_border_1', 'vxlan_leaf_3', 'vxlan_leaf_4', 'external_edge_1', 'external_edge_2'].each { switchName ->
        if (!switchesByName[switchName]?.ip || !switchesByName[switchName]?.serial ||
            !switchesByName[switchName]?.fabric || !switchesByName[switchName]?.role) {
            error("Incomplete switch topology for ${switchName} in ND ${ndfcConfig.version}")
        }
    }
    // pipeline-utility-steps (writeJSON) is not installed and groovy.json.JsonOutput
    // is blocked by the Groovy script-security sandbox (RejectedAccessException),
    // so build the JSON with sandbox-whitelisted collect/join. Each switch map has a
    // fixed {name, ip, serial, fabric, role} shape of plain-string lab constants, so
    // simple concatenation yields valid JSON (verified to parse identically).
    def switchesJson = '[' + ndfcConfig.switches.collect { s ->
        '{"name":"' + s.name + '","ip":"' + s.ip + '","serial":"' + s.serial +
        '","fabric":"' + s.fabric + '","role":"' + s.role + '"}'
    }.join(',') + ']'
        withEnv(["INVENTORY_FILE_NAME=${inventoryFileName}",
                         "INVENTORY_HOST=${env.ANSIBLE_HOST}",
                         "INVENTORY_PRIMARY_FABRIC=${ndfcConfig.fabric_name}",
                         "INVENTORY_PRIMARY_FABRIC_TYPE=${ndfcConfig.primary_fabric_type}",
                         "INVENTORY_SECONDARY_FABRIC=${ndfcConfig.fabric_name_2}",
                         "INVENTORY_SWITCHES_JSON=${switchesJson}"]) {
                sh '''#!/bin/bash
                        set -euo pipefail
                        umask 077
                        python - <<'PY'
import json
import os

import yaml

switches = json.loads(os.environ["INVENTORY_SWITCHES_JSON"])
by_name = {switch["name"]: switch for switch in switches}
primary_fabric = os.environ["INVENTORY_PRIMARY_FABRIC"]
secondary_fabric = os.environ["INVENTORY_SECONDARY_FABRIC"]
primary_type = os.environ["INVENTORY_PRIMARY_FABRIC_TYPE"].lower()
if primary_type not in {"vxlanibgp", "vxlanebgp"}:
    raise ValueError("Unsupported primary fabric type for switch test applicability")

inventory = {
    "all": {
        "vars": {
            "ansible_user": os.environ["NDFC_USER"],
            "ansible_password": os.environ["NDFC_PASSWORD"],
            "ansible_python_interpreter": "python",
            "ansible_httpapi_validate_certs": False,
            "ansible_httpapi_use_ssl": True,
            "ansible_httpapi_login_domain": "local",
            "fabric_name": primary_fabric,
            "ansible_it_fabric": primary_fabric,
            "acl_test_fabric": primary_fabric,
            "nd_test_fabric_name": primary_fabric,
            "nd_test_fabric1_name": primary_fabric,
            "nd_test_fabric2_name": secondary_fabric,
            "nd_fabric_names": [primary_fabric, secondary_fabric],
            "nd_switches": switches,
            "ansible_switch1": by_name["vxlan_leaf_1"]["ip"],
            "ansible_switch2": by_name["vxlan_leaf_2"]["ip"],
            "ansible_sno_1": by_name["vxlan_leaf_1"]["serial"],
            "ansible_sno_2": by_name["vxlan_leaf_2"]["serial"],
            "switch_serial_1": by_name["vxlan_leaf_1"]["serial"],
            "switch_serial_2": by_name["vxlan_leaf_2"]["serial"],
            "switch_serial_3": by_name["vxlan_spine_1"]["serial"],
            "nd_test_switch1_id": by_name["vxlan_border_1"]["serial"],
            "nd_test_switch2_id": by_name["external_edge_1"]["serial"],
            "nd_test_switch1_mgmt_ip": by_name["vxlan_border_1"]["ip"],
            "nd_test_switch2_mgmt_ip": by_name["external_edge_1"]["ip"],
            "nd_test_vpc_pair2_peer1_ip": by_name["vxlan_leaf_3"]["ip"],
            "nd_test_vpc_pair2_peer2_ip": by_name["vxlan_leaf_4"]["ip"],
            "intf_1_2": "Ethernet1/2",
            "intf_1_3": "Ethernet1/3",
            "intf_1_10": "Ethernet1/10",
            "ansible_network_interface1": "Ethernet1/4",
            "nd_test_switch1_interface": "Ethernet1/1",
            "nd_test_switch2_interface": "Ethernet1/3",
            "nd_test_switch1_subif": "Ethernet1/2",
            "nd_test_switch2_subif": "Ethernet1/2",
            "test_groups": ["standalone"],
            "nd_network_test_topology": "standalone",
            "nd_vrf_test_topology": "standalone",
            "ansible_msd_parent_fabric": "",
            "ansible_msd_child_fabric": "",
            "ansible_msd_switch1": "",
            "ansible_mcfg_parent_fabric": "",
            "ansible_mcfg_child_fabric": "",
            "ansible_mcfg_switch1": "",
            "save": True,
            "deploy": True,
            "config_actions_type": "switch",
        },
        "children": {
            "nd": {
                "vars": {
                    "ansible_connection": "ansible.netcommon.httpapi",
                    "ansible_network_os": "cisco.nd.nd",
                },
                "hosts": {
                    "nd_controller": {
                        "ansible_host": os.environ["INVENTORY_HOST"],
                    }
                },
            }
        },
    }
}

with open(os.environ["INVENTORY_FILE_NAME"], "w", encoding="utf-8") as inventory_file:
    yaml.safe_dump(inventory, inventory_file, sort_keys=False)
PY
                '''
        }
    echo "✅ Generated dynamic inventory for NDFC ${ndfcConfig.version} -> ${inventoryFileName}"
    sh """#!/bin/bash
        set -euo pipefail
        [ -f '${inventoryFileName}' ] && [ ! -L '${inventoryFileName}' ] || {
            echo 'Required dynamic inventory is missing or unsafe' >&2
            exit 1
        }
        chmod 600 '${inventoryFileName}'
        [ -s '${inventoryFileName}' ] || {
            echo 'Required dynamic inventory is empty' >&2
            exit 1
        }
        [ ! -d '${inventoryDestination}' ] || {
            echo 'Dynamic inventory destination is unexpectedly a directory' >&2
            exit 1
        }
        mv -- '${inventoryFileName}' '${inventoryDestination}'
        [ -f '${inventoryDestination}' ] && [ ! -L '${inventoryDestination}' ] && [ -s '${inventoryDestination}' ] || {
            echo 'Dynamic inventory installation verification failed' >&2
            exit 1
        }
        chmod 600 '${inventoryDestination}'
    """
    env.CURRENT_NDFC_INVENTORY = inventoryDestination
    echo "Set CURRENT_NDFC_INVENTORY to ${env.CURRENT_NDFC_INVENTORY}"
    sh "ls -l ${env.CURRENT_NDFC_INVENTORY}"
}
