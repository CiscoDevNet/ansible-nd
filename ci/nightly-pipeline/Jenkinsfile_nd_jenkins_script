/**
 * Calculates wall-clock build duration from the Jenkins build start through the
 * time the post-build notification is assembled.
 */
def calculateRunDuration(long startTimeMillis, long endTimeMillis) {
    long elapsedMillis = endTimeMillis - startTimeMillis
    if (elapsedMillis < 0L) {
        elapsedMillis = 0L
    }
    long totalSeconds = elapsedMillis.intdiv(1000L)
    long hours = totalSeconds.intdiv(3600L)
    long minutes = (totalSeconds % 3600L).intdiv(60L)
    long seconds = totalSeconds % 60L
    hours > 0L ? "${hours}h ${minutes}m ${seconds}s" : "${minutes}m ${seconds}s"
}

/**
 * Bundles every log this build produced — per-module test/console output, the
 * module-wise skip summaries, the ansible-lint result and a consolidated run
 * summary — into ONE build-numbered zip, archives it (so it shows in the build's
 * artifact/file list) and records its name for the post{} Webex link. Runs on the
 * agent (COLLECTIONS_DIRECTORY + workspace exist here) and never fails the build.
 */
def activityResultKey(ndfcConfig, module, runId) {
    "${ndfcConfig.versionId}|${module}|${runId}".toString()
}

def activityCount(value) {
    value instanceof Number && value >= 0 ? value.toString() : '?'
}

def activityCountSum(rows, getter) {
    long known = 0
    boolean unknown = rows.isEmpty()
    rows.findAll { it.result != 'NOT_RUN' }.each { row ->
        def value = getter(row)
        if (value instanceof Number && value >= 0) { known += value.longValue() }
        else { unknown = true }
    }
    unknown ? (known ? "${known} + ?" : '?') : known.toString()
}

def moduleCaseTotals(rows) {
    ['passed', 'failed', 'skipped'].collectEntries { name ->
        [(name): activityCountSum(rows, { row -> row.case_totals?.get(name) })]
    }
}

def moduleCaseSummaryRows() {
    MODULE_ACTIVITY_RESULTS.values().collect { row ->
        def status = row.result == 'PASS' ? 'OK' : row.result
        def note = [row.capability_note,
            row.result == 'SKIP' ? row.skip_reason : row.failure,
            row.coverage == 'COMPLETE' ? '' : 'case coverage ' + (row.coverage ?: 'UNKNOWN')]
            .findAll { it }.join('; ')
        [status, row.module, row.fabric, row.nd, activityCount(row.case_totals?.passed),
         activityCount(row.case_totals?.failed), activityCount(row.case_totals?.skipped),
         row.duration ?: '-', note, row.scope].collect {
             (it ?: '').toString().replace('|', '/').replace('\n', ' ').replace('\r', ' ')
         }.join('|')
    }.join('\n')
}

def activityStageLabel(stage) {
    if (stage instanceof String) { return stage }
    if (!(stage instanceof Map)) { return 'Not observed' }
    if (stage.failed) { return 'Failed' }
    if (stage.successful || stage.observed) { return 'Yes' }
    if (stage.skipped) { return 'Skipped' }
    'Not observed'
}

def formatModuleActivityTable(results, buildNumber) {
    def states = ['merged', 'replaced', 'overridden', 'deleted', 'gathered']
    def headers = ['S.No.', 'Build', 'Module', 'Fabric type', 'Merged', 'Replaced',
                   'Overridden', 'Delete', 'Gather', 'Base', 'Cleanup', 'Skipped', 'Result / failure']
    def rows = []
    def groups = [:]
    results.each { record ->
        def key = record.module + '|' + record.nd
        if (!groups.containsKey(key)) { groups[key] = [] }
        groups[key].add(record)
    }
    int sequence = 0
    groups.values().each { group ->
        sequence++
        def display = []
        if (group.any { it.scope in ['iBGP', 'eBGP'] }) {
            ['iBGP', 'eBGP'].each { scope ->
                def matching = group.findAll { it.scope == scope }
                if (matching) { display.addAll(matching) }
                else { display.add([module: group[0].module, nd: group[0].nd, scope: scope,
                    result: 'NOT_RUN', display_only: true, failure: 'not scheduled']) }
            }
            display.addAll(group.findAll { !(it.scope in ['iBGP', 'eBGP']) })
        } else { display.addAll(group) }
        display.eachWithIndex { record, index ->
            def noExecution = record.result == 'NOT_RUN'
            def cells = [index == 0 ? sequence.toString() : '', buildNumber.toString(),
                         index == 0 ? record.module : '', record.scope ?: 'Unknown']
            states.each { state -> cells.add(noExecution ? '-' : activityCount(record.counts?.get(state)?.started)) }
            cells.add(record.display_only ? '-' : noExecution ? 'Not reached' : activityStageLabel(record.base))
            cells.add(record.display_only ? '-' : noExecution ? 'Not reached' : activityStageLabel(record.cleanup))
            cells.add(noExecution ? '-' : activityCount(record.case_totals?.skipped))
            def notes = [record.result ?: 'UNKNOWN']
            if (record.failure) { notes.add(record.failure) }
            if (!noExecution) {
                notes.add("cases passed ${activityCount(record.case_totals?.passed)}, failed ${activityCount(record.case_totals?.failed)}")
                if (record.counts?.other?.started instanceof Number && record.counts.other.started > 0) {
                    notes.add("other cases ${record.counts.other.started}")
                }
                if (record.coverage != 'COMPLETE') { notes.add('case coverage ' + (record.coverage ?: 'UNKNOWN')) }
            }
            cells.add(notes.join('; '))
            rows.add(cells)
        }
    }
    def addTotal = { label, scope, records ->
        def cells = ['', buildNumber.toString(), label, scope]
        states.each { state -> cells.add(activityCountSum(records, { row -> row.counts?.get(state)?.started })) }
        cells.addAll(['-', '-', activityCountSum(records, { row -> row.case_totals?.skipped })])
        def totals = moduleCaseTotals(records)
        cells.add("${records.count { it.validated == true }} validated executions / ${records.size()} selected; cases passed ${totals.passed}, failed ${totals.failed}")
        rows.add(cells)
    }
    results.collect { it.scope ?: 'Unknown' }.unique().each { scope ->
        addTotal('Subtotal', scope, results.findAll { (it.scope ?: 'Unknown') == scope })
    }
    addTotal('MAIN TOTAL', 'All scopes', results)
    def clean = { value -> (value ?: '').toString().replace('|', '/').replace('\r', ' ').replace('\n', ' ') }
    rows = rows.collect { row -> row.collect { clean(it) } }
    def widths = (0..<headers.size()).collect { int index ->
        ([headers[index].length()] + rows.collect { it[index].length() }).max()
    }
    def render = { cells -> '| ' + (0..<cells.size()).collect { int index ->
        cells[index].toString().padRight(widths[index])
    }.join(' | ') + ' |' }
    def table = ([render(headers), render(widths.collect { '-' * it })] + rows.collect { render(it) }).join('\n')
    "ND MODULE TEST ACTIVITY - Build ${buildNumber}\n\n${table}\n\n" +
        'State columns count distinct module cases started, not Ansible tasks or API calls.\n' +
        'Each case is assigned one primary tested state; verification gathers do not add Gather cases.\n' +
        'Base/Cleanup are separate observed-stage indicators and contribute no test cases.\n' +
        'Skipped counts explicitly fully skipped module cases; not reached is not skipped.\n' +
        '? = unavailable/incomplete count; N + ? = known subtotal with unknown contributions.\n' +
        'Other cases (such as validation) are included in case outcomes, outside the five state columns.\n' +
        'NOT_RUN counterpart rows are display-only and excluded from subtotals and the main total.\n' +
        'Mixed/shared results contain one combined execution and are counted once.\n'
}

def captureModuleActivity(ndfcConfig, module, testType, runId, context, logFile) {
    def key = activityResultKey(ndfcConfig, module, runId)
    def row = MODULE_ACTIVITY_RESULTS[key]
    try {
        withEnv(["ND_ACTIVITY_LOG=${logFile}", "ND_ACTIVITY_MODULE=${module}",
                 "ND_ACTIVITY_RUN=${runId}", "ND_ACTIVITY_FABRIC=${context.scope}",
                 "ND_ACTIVITY_TEST_TYPE=${testType}"]) {
            sh '''#!/bin/bash
                set -euo pipefail
                "$HOME/ansible/venv/bin/python" "$COLLECTIONS_DIRECTORY/nd_test_activity.py" summarize \\
                    --log "$ND_ACTIVITY_LOG" --module "$ND_ACTIVITY_MODULE" --run-id "$ND_ACTIVITY_RUN" \\
                    --build "$BUILD_NUMBER" --fabric "$ND_ACTIVITY_FABRIC" \\
                    --collection-root "$COLLECTIONS_DIRECTORY" --test-type "$ND_ACTIVITY_TEST_TYPE" \\
                    --output "$ND_ACTIVITY_LOG.activity.json"
            '''
        }
        def activity = new groovy.json.JsonSlurperClassic().parseText(readFile(file: "${logFile}.activity.json"))
        if (activity.module != module || activity.run_id != runId ||
            activity.build.toString() != BUILD_NUMBER.toString() || activity.fabric != context.scope || !activity.validated) {
            error('Module activity summary belongs to another execution')
        }
        row.putAll(activity)
        row.counts = activity.counts.collectEntries { state, count -> [(state): [started: count]] }
        row.counts.other = [started: activity.other_cases]
        row.case_totals = activity.testcase_totals ?: [:]
        row.failure = (activity.failure ?: []).join('; ')
        row.fabric = context.fabric
        row.scope = context.scope
        row.nd = ndfcConfig.version
        row.duration = '-'
    } catch (Exception e) {
        rethrowIfInterrupt(e)
        row.result = 'UNKNOWN'
        row.failure = 'module case report unavailable; see console'
        row.coverage = 'UNKNOWN'
        env.PIPELINE_FAILED = 'true'
        echo "⚠️ Module case report unavailable for ${module} (${context.scope}); Ansible result parsing will continue"
    }
}

/** Show modules blocked before execution without inventing test-case counts. */
def recordUnstartedRound(ndfcConfig, reason) {
    def pairRows = VPC_PAIR_EXECUTIONS.collect { run ->
        [id: run.id, fabric: run.id == 'advanced' ? ndfcConfig.fabric_name : run.fabric,
         type: run.id == 'advanced' ? ndfcConfig.vpc_pair_fabric_type : run.type]
    }
    def targets = []
    (INTEGRATION_MODULES + INTERFACE_INTEGRATION_MODULES + ['nd_resource_manager', 'nd_manage_fabric', 'nd_manage_links']).each { module ->
        targets.add(module)
        if (module == 'nd_manage_policy_group') {
            targets.addAll(pairRows.collect { "nd_vpc_pair.${it.id}".toString() })
        }
    }
    targets.addAll(PLAYBOOK_FILES)
    targets.each { module ->
        def prefix = "${ndfcConfig.versionId}|${module}|".toString()
        if (!MODULE_ACTIVITY_RESULTS.keySet().any { it.startsWith(prefix) }) {
            def context = resultContextForTarget(ndfcConfig, module, ndfcConfig.fabric_name, pairRows)
            MODULE_ACTIVITY_RESULTS[prefix + 'not-run'] = [module: module, nd: ndfcConfig.version,
                round_label: ndfcConfig.round_label, fabric: context.fabric, scope: context.scope,
                result: 'NOT_RUN', coverage: 'UNKNOWN', counts: [:], case_totals: [:],
                failure: (reason ?: 'round not reached').toString().replace('|', '/').replace('\n', ' ').take(170)]
        }
    }
}

