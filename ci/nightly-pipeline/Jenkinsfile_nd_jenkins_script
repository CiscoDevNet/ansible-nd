        stage('Test NDFC/ND Versions Sequentially') {
            steps {
                script {
                    // echo timestamp when stage starts
                    echo "⏱ Stage 'Test ND' started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
                    
                    
                    def baseNdfcVersions = [
                        // [
                        //     version: '3.2',
                        //     versionId: 'NDFC32',
                        //     host: 'NDFC_HOST_32',
                        //     server: '198.51.100.187',
                        //     credentials: 'NDFC_CREDENTIALS',
                        //     fabric_name: '${FABRIC_NAME}',
                        // ],
                        [
                            version: '4.3', 
                            versionId: 'ND43',
                            host: 'ND_HOST_43',
                            server: 'ANSIBLE_HOST',
                            credentials: 'ND_CREDENTIALS',
                            fabric_name: 'VXLAN_EVPN_Fabric',
                            fabric_name_2: 'External_Connectivity_Fabric',   // maps to nd_test_fabric2_name (l3out)
                            switches: [
                                [name: 'vxlan_leaf_1', ip: '192.0.2.195', serial: 'SERIAL00001', fabric: 'VXLAN_EVPN_Fabric', role: 'leaf'],
                                [name: 'vxlan_leaf_2', ip: '192.0.2.196', serial: 'SERIAL00002', fabric: 'VXLAN_EVPN_Fabric', role: 'leaf'],
                                [name: 'vxlan_spine_1', ip: '192.0.2.194', serial: 'SERIAL00003', fabric: 'VXLAN_EVPN_Fabric', role: 'spine'],
                                [name: 'vxlan_border_1', ip: '192.0.2.88', serial: 'SERIAL00004', fabric: 'VXLAN_EVPN_Fabric', role: 'border'],
                                [name: 'vxlan_leaf_3', ip: '192.0.2.85', serial: 'SERIAL00008', fabric: 'VXLAN_EVPN_Fabric', role: 'leaf'],
                                [name: 'vxlan_leaf_4', ip: '192.0.2.86', serial: 'SERIAL00009', fabric: 'VXLAN_EVPN_Fabric', role: 'leaf'],
                                [name: 'external_edge_1', ip: '192.0.2.89', serial: 'SERIAL00005', fabric: 'External_Connectivity_Fabric', role: 'edge_router'],
                                [name: 'external_edge_2', ip: '192.0.2.90', serial: 'SERIAL00006', fabric: 'External_Connectivity_Fabric', role: 'edge_router'],
                            ],
                            vpc_pair_switch1_serial: 'SERIAL00001',   // vxlan_leaf_1
                            vpc_pair_switch2_serial: 'SERIAL00002',   // vxlan_leaf_2
                            vpc_pair_fabric_type: 'vxlanIbgp',
                        ]
                    ]

                    def ndfcVersions = []
                    baseNdfcVersions.each { baseConfig ->
                        FABRIC_ROUNDS.each { fabricRound ->
                            ndfcVersions.add(buildRoundConfig(baseConfig, fabricRound))
                        }
                    }

                    // Set environment variable with active ND versions for build start notification
                    def activeVersions = ndfcVersions.collect { it.version }.unique().join(', ')
                    env.ACTIVE_FABRIC_ROUNDS = FABRIC_ROUNDS.collect { it.label }.join(' + ')
                    // DEBUG: Used for sample testing. def pb = 'dcnm_policy.yaml'
                    env.ACTIVE_DCNM_VERSIONS = activeVersions
                    echo "🎯 Active ND versions for this run: ${activeVersions}"

                    // Initialize global failure tracking
                    env.PIPELINE_FAILED = 'false'
                    env.ND_SWITCH_RESTORE_FAILED = 'false'
                    env.HOME_ROSTER_COPY_READY = 'false'
                    env.HOME_RESTORE_REQUIRED = 'false'
                    env.ND_HOME_RECOVERY_STATUS = 'not_required'
                    TEST_RESULT_SUMMARY_BUF = ''
                    TEST_RESULT_ARTIFACTS_BUF = ''
                    SKIPLIST_FILES_BUF = ''
                    SKIPLIST_DETAILS_BUF = ''
                    BUILD_FAILURE_REASON_BUF = ''
                    env.TOTAL_PASSED_COUNT = '0'
                    env.TOTAL_FAILED_COUNT = '0'
                    MODULE_ACTIVITY_RESULTS.clear()
                    env.MODULE_ACTIVITY_REPORT_FILE = ''

                    // Prerequisites are always enabled AND applied so the live setup is
                    // reconciled to the required setup before the tests; audit-only mode
                    // (the former ND_PREREQUISITE_ONLY) is removed. These effective env
                    // vars stay the single source the rest of the pipeline reads.
                    env.ND_PREREQUISITE_ENABLE_EFFECTIVE = 'true'
                    env.ND_PREREQUISITE_APPLY_EFFECTIVE = 'true'
                    env.ND_PREREQUISITE_ONLY_EFFECTIVE = 'false'

                    // Run lint on the freshly cloned collection BEFORE the version
                    // loop injects Consul operational files (reset_fabric.yaml, the
                    // per-module smoke playbooks, nd_prerequisite/*, and
                    // run_integration_module.yaml) into the collection root. Those
                    // injected runtime files are not part of the shipped collection and
                    // are not covered by its .ansible-lint, so linting after injection
                    // produced false failures that flipped the build to FAILURE.
                    // Best effort: never block the Webex notification.
                    try {
                        runLintCheck()
                    } catch (Exception e) {
                        rethrowIfInterrupt(e)
                        echo "⚠️ runLintCheck() failed but will not stop pipeline: ${e.getMessage()}"
                        env.PIPELINE_FAILED = 'true'
                    }

                    // Each ND version completes its iBGP/eBGP lifecycle before the
                    // next version. Recovery and reporting run even after a gate fails.
                    prepareStructuredReporting()
                    withCleanupPreservingFailure({
                        parallel(
                            'Sequential tests and recovery': {
                                def executionStatus = 'success'
                                withCleanupPreservingFailure({
                                    try {
                                        for (baseConfig in baseNdfcVersions) {
                                            def roundConfigs = FABRIC_ROUNDS.collect { buildRoundConfig(baseConfig, it) }
                                            def activeRound = roundConfigs[0]
                                            env.ND_SWITCH_RESTORE_FAILED = 'false'
                                            env.HOME_ROSTER_COPY_READY = 'false'
                                            env.HOME_RESTORE_REQUIRED = 'false'
                                            withCleanupPreservingFailure({
                                                for (ndfcConfig in roundConfigs) {
                                                    if (env.ND_SWITCH_RESTORE_FAILED == 'true') {
                                                        recordUnstartedRound(ndfcConfig, 'previous switch restore incomplete')
                                                        echo "NDP_SWITCH_ROUNDS_SKIPPED: ${ndfcConfig.round_label}; previous restore did not confirm the full roster"
                                                        continue
                                                    }
                                                    activeRound = ndfcConfig
                                                    def failureFlagName = "NDFC_${ndfcConfig.versionId}_FAILED"
                                                    setFailureFlag(failureFlagName, false)
                                                    env.CONSUL_SYNC_FAILED = 'false'
                                                    env.REQUIRED_FILES_READY = 'false'
                                                    try {
                                                        echo "NDP_FABRIC_ROUND_START: ND ${ndfcConfig.version} ${ndfcConfig.round_label} on ${ndfcConfig.fabric_name}; starting selected module suite"
                                                        runNDFCVersionTests(ndfcConfig)
                                                        if (isFailureFlagSet(failureFlagName)) { env.PIPELINE_FAILED = 'true' }
                                                        echo "NDP_FABRIC_ROUND_COMPLETE: ${ndfcConfig.round_label} module attempts collected"
                                                    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException e) {
                                                        recordUnstartedRound(ndfcConfig, 'round interrupted; see console')
                                                        throw e
                                                    } catch (Exception e) {
                                                        setFailureFlag(failureFlagName, true)
                                                        env.PIPELINE_FAILED = 'true'
                                                        recordUnstartedRound(ndfcConfig, e.getMessage() ?: 'round stopped before module execution')
                                                        def roundFailureReason = (e.getMessage() ?: 'round stopped before module execution').toString()
                                                            .replace('\r', ' ').replace('\n', ' ')
                                                            .replaceAll('(?i)\\b(?:password|passwd|pwd|token|secret|authorization|credentials?|community|username|api[_-]?key)\\b.*', '[credential details redacted]').take(500)
                                                        BUILD_FAILURE_REASON_BUF = (BUILD_FAILURE_REASON_BUF + "\nRound ND ${ndfcConfig.version} ${ndfcConfig.round_label} (${ndfcConfig.fabric_name}): ${roundFailureReason}").take(2400)
                                                        echo "NDP_FABRIC_ROUND_FAILED: ${ndfcConfig.round_label}: ${e.getMessage()}"
                                                        throw e
                                                    }
                                                    if (env.ND_SWITCH_RESTORE_FAILED == 'true') { continue }
                                                    if (env.ND_PREREQUISITE_ONLY_EFFECTIVE != 'true' &&
                                                        ndfcConfig.versionId != roundConfigs[-1].versionId) {
                                                        resetFabricBetweenVersions(ndfcConfig.round_tag ?: '')
                                                    }
                                                }
                                            }, {
                                                withCleanupPreservingFailure({
                                                    if (env.ND_PREREQUISITE_ONLY_EFFECTIVE != 'true') {
                                                        restoreHomeFabric(roundConfigs, activeRound)
                                                    }
                                                }, {
                                                    // Include every selected round even if an earlier
                                                    // interruption prevented it from being entered.
                                                    roundConfigs.each { recordUnstartedRound(it, 'not reached after an earlier round stopped') }
                                                })
                                            })
                                        }
                                    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException e) {
                                        executionStatus = 'interrupted'
                                        throw e
                                    } catch (Exception e) {
                                        executionStatus = (e instanceof InterruptedException) ? 'interrupted' : 'failed'
                                        throw e
                                    }
                                }, {
                                    // This terminal receipt follows every active/home
                                    // restoration attempt; reporting never gates recovery.
                                    try {
                                        finishStructuredExecution(executionStatus)
                                    } catch (Exception terminalError) {
                                        rethrowIfInterrupt(terminalError)
                                        env.PIPELINE_FAILED = 'true'
                                        echo 'NDP_EXECUTION_TERMINAL_WRITE_FAILED: final reconciliation required'
                                    }
                                })
                            },
                            'Independent artifact publishing': {
                                publishStructuredArtifacts()
                            },
                            failFast: false
                        )
                    }, {
                        withCleanupPreservingFailure({
                            foldStructuredResults()
                        }, {
                            publishModuleActivityReport()
                            bundleAllLogs()
                        })
                    })

                    // Clean workspace - best effort
                    try {
                        cleanWs()
                    } catch (Exception e) {
                        rethrowIfInterrupt(e)
                        echo "⚠️ cleanWs() failed but will not stop pipeline: ${e.getMessage()}"
                        env.PIPELINE_FAILED = 'true'
                    }

                    // The per-target runner intentionally continues after failures so
                    // every result can be collected. Convert the accumulated flag into
                    // the real Jenkins result after all versions and best-effort steps.
                    if (env.PIPELINE_FAILED == 'true') {
                        echo "❌ One or more required pipeline checks failed; marking the Jenkins build as FAILURE"
                        currentBuild.result = 'FAILURE'
                    }
                }
            }
        }
    }

