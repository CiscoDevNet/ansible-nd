                    SKIPLIST_DETAILS_BUF = ''
                    BUILD_FAILURE_REASON_BUF = ''
                    env.TOTAL_PASSED_COUNT = '0'
                    env.TOTAL_FAILED_COUNT = '0'
                    MODULE_ACTIVITY_RESULTS.clear()
                    env.MODULE_ACTIVITY_REPORT_FILE = ''

                    // Prerequisites are always enabled AND applied so the live setup is
                    // reconciled to the required setup before the tests; audit-only mode
                    // (the former ND_PREREQUISITE_ONLY) is removed. These effective env
                    // vars stay the single source the rest of the pipeline reads.
                    env.ND_PREREQUISITE_ENABLE_EFFECTIVE = 'true'
                    env.ND_PREREQUISITE_APPLY_EFFECTIVE = 'true'
                    env.ND_PREREQUISITE_ONLY_EFFECTIVE = 'false'

                    // Run lint on the freshly cloned collection BEFORE the version
                    // loop injects Consul operational files (reset_fabric.yaml, the
                    // per-module smoke playbooks, nd_prerequisite/*, and
                    // run_integration_module.yaml) into the collection root. Those
                    // injected runtime files are not part of the shipped collection and
                    // are not covered by its .ansible-lint, so linting after injection
                    // produced false failures that flipped the build to FAILURE.
                    // Best effort: never block the Webex notification.
                    try {
                        runLintCheck()
                    } catch (Exception e) {
                        rethrowIfInterrupt(e)
                        echo "⚠️ runLintCheck() failed but will not stop pipeline: ${e.getMessage()}"
                        env.PIPELINE_FAILED = 'true'
                    }

                    // Loop through every ND version and fabric round sequentially (iBGP first, then eBGP)
                    try {
                    for (ndfcConfig in ndfcVersions) {
                        if (env.ND_SWITCH_RESTORE_FAILED == 'true') {
                            currentBuild.result = 'UNSTABLE'
                            echo "NDP_SWITCH_ROUNDS_SKIPPED: skipping ND ${ndfcConfig.version}${ndfcConfig.round_tag ?: ''}; the previous restore did not confirm the full roster"
                            TEST_RESULT_SUMMARY_BUF += "\nABORT|round skipped${ndfcConfig.round_tag ?: ''}|${ndfcConfig.fabric_name}|${ndfcConfig.version}|-|-|-|-|previous switch restore incomplete"
                            recordUnstartedRound(ndfcConfig, 'previous switch restore incomplete')
                            continue
                        }
                        // Define failure flag for this NDFC version
                        def failureFlagName = "NDFC_${ndfcConfig.versionId}_FAILED"
                        setFailureFlag(failureFlagName, false)
                        env.CONSUL_SYNC_FAILED = 'false'
                        env.REQUIRED_FILES_READY = 'false'
                        
                        try {
                            echo "🚀 Starting tests for Nexus Dashboard/NDFC ${ndfcConfig.version}${ndfcConfig.round_tag ?: ''} on ${ndfcConfig.fabric_name}"
                            runNDFCVersionTests(ndfcConfig)
                            //DEBUG: Used for sample testing. parseTestResults(ndfcConfig, failureFlagName, pb)
                            echo "✅ Completed tests for Nexus Dashboard/NDFC ${ndfcConfig.version}${ndfcConfig.round_tag ?: ''}"
                            
                            // Check if this version failed
                            if (isFailureFlagSet(failureFlagName)) {
                                env.PIPELINE_FAILED = 'true'
                            }
                        } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException e) {
                            recordUnstartedRound(ndfcConfig, 'round interrupted; see console')
                            throw e
                        } catch (Exception e) {
                            echo "❌ NDFC ${ndfcConfig.version}${ndfcConfig.round_tag ?: ''} testing failed: ${e.getMessage()}"
                            setFailureFlag(failureFlagName, true)
                            env.PIPELINE_FAILED = 'true'
                            // A round that stops before (or while) producing results must still be visible in the
                            // Webex table, with the reason, instead of silently missing from it.
                            def abortReason = (e.getMessage() ?: e.toString()).replace('\n', ' ').replace('|', '/')
                            if (abortReason.length() > 170) {
                                abortReason = abortReason.substring(0, 170)
                            }
                            TEST_RESULT_SUMMARY_BUF += "\nABORT|round stopped${ndfcConfig.round_tag ?: ''}|${ndfcConfig.fabric_name}|${ndfcConfig.version}|-|-|-|-|${abortReason}"
                            recordUnstartedRound(ndfcConfig, abortReason)
                            if (env.CONSUL_SYNC_FAILED == 'true' || env.REQUIRED_FILES_READY != 'true') {
                                echo "🛑 Required runtime files were not freshly synchronized; aborting before reset or further tests"
                                throw e
                            }
                            if (env.ND_SWITCH_RESTORE_FAILED == 'true') {
                                echo "Switch restore failed; refusing to start another fabric round: ${e.getMessage()}"
                                continue
                            }
                            echo "🔄 Continuing to next NDFC version..."
                        } finally {
                            // Archive while the Docker agent still has a workspace.
                            // The retained small rows can also be printed in post{}.
                            publishModuleActivityReport()
                        }

                        // A prerequisite-only audit performs controller GETs only; do not
                        // mutate the lab with the normal reset after that audit.
                        if (env.ND_PREREQUISITE_ONLY_EFFECTIVE == 'true') {
                            echo "ℹ️ Skipping fabric reset during prerequisite-only audit"
                        } else {
                            // Reset fabric after each ND version (including the last one) - best effort
                            try {
                                resetFabricBetweenVersions(ndfcConfig.round_tag ?: '')
                            } catch (Exception e) {
                                echo "❌ resetFabricBetweenVersions() failed: ${e.getMessage()}"
                                env.PIPELINE_FAILED = 'true'
                                throw e
                            }
                        }
                    }

                    } finally {
                        try {
                            if (env.ND_PREREQUISITE_ONLY_EFFECTIVE != 'true') {
                                restoreHomeFabric(ndfcVersions)
                            }
                        } finally {
                            ndfcVersions.each { recordUnstartedRound(it, 'not reached after an earlier round stopped') }
                            publishModuleActivityReport()
                            bundleAllLogs()
                        }
                    }

                    // Clean workspace - best effort
                    try {
                        cleanWs()
                    } catch (Exception e) {
                        rethrowIfInterrupt(e)
                        echo "⚠️ cleanWs() failed but will not stop pipeline: ${e.getMessage()}"
                        env.PIPELINE_FAILED = 'true'
                    }

                    // The per-target runner intentionally continues after failures so
                    // every result can be collected. Convert the accumulated flag into
                    // the real Jenkins result after all versions and best-effort steps.
                    if (env.PIPELINE_FAILED == 'true') {
                        echo "❌ One or more required pipeline checks failed; marking the Jenkins build as FAILURE"
                        currentBuild.result = 'FAILURE'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                echo formatPhaseTimingTable(PHASE_TIMING_RESULTS.values().toList(),
                    (System.currentTimeMillis() - currentBuild.startTimeInMillis) / 1000.0)
                try {
                    echo "Post-build Webex notification block started at: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"

                    // Build the message in Groovy (avoid doing Groovy inside shell).
                    // The current pipeline runs ND 4.3; use the active-version
                    // environment value so the version is shown once in the title.
                    def activeNdVersions = (env.ACTIVE_DCNM_VERSIONS ?: '4.3').trim()
                    // The suite runs once per fabric round (e.g. "iBGP + eBGP"); show them in the title.
                    def activeRounds = (env.ACTIVE_FABRIC_ROUNDS ?: '').trim()
                    def roundsSuffix = activeRounds ? " (${activeRounds})" : ''
                    def notificationTitle = "ND ${activeNdVersions}${roundsSuffix} NIGHTLY NOTIFICATION"
                    def customWebexMessage = (params.WEBEX_CUSTOM_MESSAGE ?: '').trim()
                    def selectedBranch = (env.ND_GIT_BRANCH ?: 'develop').trim() ?: 'develop'
                    def selectedCommit = (env.ND_GIT_COMMIT ?: '').trim() ?: 'unavailable'
                    def caseTotals = moduleCaseTotals(MODULE_ACTIVITY_RESULTS.values().toList())
                    def totalPassed = caseTotals.passed
                    def totalFailed = caseTotals.failed
                    def resultTable = formatResultsTable(moduleCaseSummaryRows(), 'module test cases')
                    def artifactLinks = formatArtifactLinks(TEST_RESULT_ARTIFACTS_BUF)
                    def skippedTestLinks = formatSkippedTestLinks(SKIPLIST_FILES_BUF)
                    def runDuration = calculateRunDuration(
                        currentBuild.startTimeInMillis,
                        new Date().time
                    )
                    def lintSummary = (env.LINT_SUMMARY ?: '').trim()

                    def message = "${notificationTitle}\n"
                    if (customWebexMessage) {
                        message += "${customWebexMessage}\n\n"
                    }
                    message += "📊 Pipeline completed for the ND Nightly run - Build ${BUILD_NUMBER}\n"
                    message += "🌿 ansible-nd branch: ${selectedBranch}\n"
                    message += "🔖 ansible-nd commit: ${selectedCommit}\n"
                    message += "\n"
                    message += "Test cases passed: ${totalPassed}\n"
                    message += "Test cases failed: ${totalFailed}\n"
                    message += "\n📝 DETAILED TEST RESULTS:\n\n"
                    message += "${resultTable}\n"
                    message += "\n**Artifact links:**\n"
                    if (artifactLinks) {
                        message += "${artifactLinks}\n"
                    } else {
                        message += "- No per-module artifacts were captured\n"
                    }

                    if (lintSummary) {
                        message += "\n─────────\n"
                        message += "🧹 **Ansible-lint Results:**\n${lintSummary}\n"
                    }
                    if (skippedTestLinks) {
                        message += "${skippedTestLinks}\n"
                    }
                    if ((env.LOG_BUNDLE_FILE ?: '').trim()) {
                        message += "📦 [All logs (zip)](${JOB_URL}${BUILD_NUMBER}/artifact/${env.LOG_BUNDLE_FILE})\n"
                    }
                    if ((env.MODULE_ACTIVITY_REPORT_FILE ?: '').trim()) {
                        message += "📋 [Module test activity table](${JOB_URL}${BUILD_NUMBER}/artifact/${env.MODULE_ACTIVITY_REPORT_FILE})\n"
                    }
                    message += "⏱️ **Total run duration:** ${runDuration}"

                    // Webex limits message content to 7,439 characters before
                    // encryption. The ordinary report retains every artifact link;
                    // only the oversize fallback drops those long URLs while keeping
                    // the complete Markdown result table requested by the user.
                    final int WEBEX_SAFE_MESSAGE_LIMIT = 7000
                    def fullMessageLength = message.length()
                    echo "📨 Webex notification before size check (${fullMessageLength} characters):\n${message}"
                    if (fullMessageLength > WEBEX_SAFE_MESSAGE_LIMIT) {
                        def compactMessage = new StringBuilder()
                        compactMessage.append("${notificationTitle}\n")
                        if (customWebexMessage) {
                            compactMessage.append("${customWebexMessage}\n\n")
                        }
                        compactMessage.append("📊 Pipeline completed for the ND Nightly run - Build ${BUILD_NUMBER}\n")
                        compactMessage.append("🌿 ansible-nd branch: ${selectedBranch}\n")
                        compactMessage.append("🔖 ansible-nd commit: ${selectedCommit}\n")
                        compactMessage.append("\n")
                        compactMessage.append("Test cases passed: ${totalPassed}\n")
                        compactMessage.append("Test cases failed: ${totalFailed}\n")
                        compactMessage.append("\n📝 DETAILED TEST RESULTS:\n\n${resultTable}\n")
                        compactMessage.append("\n**Artifact links:**\n")
                        compactMessage.append("- Individual module links were omitted only because the complete message exceeded the Webex limit.\n")
                        compactMessage.append("- [Build artifacts (file list)](${JOB_URL}${BUILD_NUMBER}/artifact/)\n")
                        if (lintSummary) {
                            compactMessage.append("\n─────────\n")
                            compactMessage.append("🧹 **Ansible-lint Results:**\n${lintSummary}\n")
                        }
                        if (skippedTestLinks) {
                            compactMessage.append("${skippedTestLinks}\n")
                        }
                        if ((env.LOG_BUNDLE_FILE ?: '').trim()) {
                            compactMessage.append("📦 [All logs (zip)](${JOB_URL}${BUILD_NUMBER}/artifact/${env.LOG_BUNDLE_FILE})\n")
                        }
                        if ((env.MODULE_ACTIVITY_REPORT_FILE ?: '').trim()) {
                            compactMessage.append("📋 [Module test activity table](${JOB_URL}${BUILD_NUMBER}/artifact/${env.MODULE_ACTIVITY_REPORT_FILE})\n")
                        }
                        compactMessage.append("⏱️ **Total run duration:** ${runDuration}")
                        message = compactMessage.toString()
                        echo "📏 Webex message length: ${message.length()} characters"
                        echo "⚠️ Webex message shortened from ${fullMessageLength} to ${message.length()} characters"
                        echo "📨 Webex notification after compaction (${message.length()} characters):\n${message}"
                    } else {
                        echo "📏 Webex message length: ${message.length()} characters"
                    }

                    // Render the complete case table once. Splitting physical-fabric subgroups
                    // would create false NOT_RUN counterpart rows for cases present in another part.
                    def continuationHeader = "${notificationTitle} - Build ${BUILD_NUMBER}\n" +
                        "🌿 ansible-nd branch: ${selectedBranch}\n" +
                        "🔖 ansible-nd commit: ${selectedCommit}\n\n"
                    splitWebexMessage(message, continuationHeader, WEBEX_SAFE_MESSAGE_LIMIT).each { webexMessage ->
                        postWebexMarkdown(webexMessage)
                    }
                } catch (Exception e) {
                    rethrowIfInterrupt(e)
                    // Absolutely never let Webex notification break the pipeline
                    echo "⚠️ Webex notification post-build block encountered an error but will be ignored: ${e.getMessage()}"
                } finally {
                    // No FilePath is needed here; cleanup may already have removed it.
                    echo "\nFINAL MODULE TEST ACTIVITY TABLE\n" +
                        formatModuleActivityTable(MODULE_ACTIVITY_RESULTS.values().toList(), BUILD_NUMBER)
                }
            }
        }
        cleanup {
            script {
                // Also runs after early fail-closed Consul errors, when the normal
                // end-of-stage cleanup is bypassed. This prevents partially
                // downloaded inventories or other required files from persisting.
                // cleanWs() needs a workspace/FilePath; under the Docker agent that
                // context is gone in post{}, so keep it best-effort.
                try {
                    echo "🧹 Final workspace cleanup (including partial Consul downloads)"
                    cleanWs()
                } catch (Exception e) {
                    rethrowIfInterrupt(e)
                    echo "⚠️ Final cleanup skipped (no workspace context in post): ${e.getMessage()}"
                }
            }
        }
    }
}

/**
 * Runs ansible-lint with production profile and reports results
 */
def runLintCheck() {
    stage('Run Lint Check') {
            echo "⏱ Running lint check..."
            try {
            sh '''#!/bin/bash
            set -e
            cd ${COLLECTIONS_DIRECTORY}
            
            # Activate venv
            source $HOME/ansible/venv/bin/activate
            
            # Run ansible-lint with production profile and capture output
            echo "🔍 Running ansible-lint with production profile..."
            LINT_OUTPUT=$(ansible-lint --profile=production 2>&1) || LINT_STATUS=$?
            
            # Process the output to extract and format the summary
            if [ -n "$LINT_STATUS" ]; then
                # Full rule-violation table -> keep in the console log for debugging.
                SUMMARY_BLOCK=$(echo "$LINT_OUTPUT" | awk '/^# Rule Violation Summary/{f=1;next} /^Failed:/{print;exit} f')
                echo "# Rule Violation Summary"
                echo "$SUMMARY_BLOCK"

                # Single totals line, without the trailing "Profile ... required." text.
                FAILED_LINE=$(echo "$LINT_OUTPUT" | grep '^Failed:' | head -1 | sed 's/ Profile.*$//')
                FAILURE_COUNT=$(echo "$LINT_OUTPUT" | grep '^Failed:' | awk '{print $2}')
                echo ""
                echo "❌ Lint check failed with $FAILURE_COUNT violations"

                # Notification gets ONLY the single totals line (kept minimal); the full
                # rule table stays in the console log above for debugging.
                echo "$FAILED_LINE" > "${BASE_DIRECTORY}/lint_summary.txt"
                exit 1
            else
                echo "✅ ansible-lint check passed with no violations"
                echo "✅ ansible-lint check passed with no violations" > "${BASE_DIRECTORY}/lint_summary.txt"
            fi
            '''
            } finally {
                // Capture the lint summary (pass OR fail) into env so the post{} Webex
                // notification can include it; the Docker-agent workspace is gone by
                // post time, so it cannot be read from a file there.
                try {
                    def lintFilePath = "${BASE_DIRECTORY}/lint_summary.txt"
                    if (fileExists(lintFilePath)) {
                        env.LINT_SUMMARY = readFile(lintFilePath).trim()
                    }
                } catch (Exception e) {
                    rethrowIfInterrupt(e)
                    echo "⚠️ Could not capture lint summary into env: ${e.getMessage()}"
                }
            }
    }
}

/**
 * Sets a failure flag in the Jenkins environment.
 * @param flagName The name of the failure flag.
 * @param value Boolean indicating failure (true) or success (false).
 */
def setFailureFlag(flagName, value) {
    // Use Jenkins environment variables to track failure flags
    env."${flagName}" = value.toString()
}

/**
 * Checks if a failure flag is set in the Jenkins environment.
 * @param flagName The name of the failure flag.
 * @return true if failure flag is set to 'true', false otherwise.
 */
def isFailureFlagSet(flagName) {
    return env."${flagName}"?.toBoolean() ?: false
}

/**
 * Re-throw pipeline aborts/timeouts (build timeout or user abort) so a broad
 * catch (Exception e) can never swallow an interrupt and let a wedged build run on.
 */
def rethrowIfInterrupt(e) {
    if (e instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException ||
        e instanceof InterruptedException) {
        throw e
    }
}

/**
 * Verifies that an inventory file exists and provides helpful error messages if not.
 * @param inventoryPath The full path to the inventory file to verify.
 * @return true if file exists, throws error if not found.
 */
def verifyInventoryFile(inventoryPath) {
    def fileExists = sh(
        script: """
            if [ -f "${inventoryPath}" ]; then
                echo "✅ Inventory file verified: ${inventoryPath}"
                exit 0
            else
                echo "⚠️ Inventory file not found: ${inventoryPath}"
                echo "📂 Available inventory files in ${COLLECTIONS_DIRECTORY}:"
                ls -l ${COLLECTIONS_DIRECTORY}/inventory*.yaml 2>/dev/null || echo "No inventory files found"
                exit 1
            fi
        """,
        returnStatus: true
    )

    if (fileExists != 0) {
        error("Inventory file not found: ${inventoryPath}")
    }
    return true
}

/**
 * Archives test output file with timestamp and cleans up workspace.
 * @param ndfcConfig The NDFC configuration object.
 * @param playbookName The name of the playbook (e.g., 'dcnm_policy.yaml').
 */
def archiveTestOutput(ndfcConfig, playbookName, expectedRunMarker = '') {
    def timingKey = "${ndfcConfig.fabric_name}|${ndfcConfig.versionId}|${playbookName}|${expectedRunMarker}".toString()
    PHASE_TIMING_RESULTS[timingKey] = [:]
    def archiveStarted = System.currentTimeMillis()
    def archiveSucceeded = false
    def timestamp = new Date().format('yyyyMMdd_HHmmss')
    def baseFileName = "test_output_${ndfcConfig.fabric_name}_${ndfcConfig.versionId}_${playbookName}"
    def archivedFileName = "${baseFileName}_${timestamp}.txt"

    echo "📦 Archiving test output: ${archivedFileName}"

    try {
        sh """
            cd ${COLLECTIONS_DIRECTORY}
            if [ -f "${baseFileName}.txt" ]; then
                # Rename with timestamp
                mv "${baseFileName}.txt" "${archivedFileName}"
                echo "✅ Renamed to ${archivedFileName}"

                # Copy to workspace for archiving, then make it world-readable.
                # The container writes as root with a restrictive umask, so the
                # non-root Jenkins controller cannot read it in archiveArtifacts
                # and the archive fails with AccessDeniedException (build #14: 11/11).
                cp "${archivedFileName}" "${env.WORKSPACE}/${archivedFileName}"
                chmod 0644 "${env.WORKSPACE}/${archivedFileName}"
                echo "📋 Copied to workspace for archiving"
            else
                echo "⚠️ Base file not found: ${baseFileName}.txt"
                exit 1
            fi
        """

        // Archive the file from workspace
        archiveArtifacts artifacts: "${archivedFileName}", allowEmptyArchive: false, fingerprint: true
        archiveSucceeded = true
        echo "✅ Archived: ${archivedFileName}"

        // Clean up workspace copy after archiving
        sh "rm -f ${env.WORKSPACE}/${archivedFileName}"
        echo "🧹 Cleaned up workspace copy"
        return archivedFileName
    } catch (Exception e) {
        echo "⚠️ Failed to archive ${baseFileName}: ${e.getMessage()}"
        return ''
    } finally {
        def archiveSeconds = (System.currentTimeMillis() - archiveStarted) / 1000.0
        try {
            withEnv(["ND_REPORT_LOG=${COLLECTIONS_DIRECTORY}/${baseFileName}.txt",
                     "ND_REPORT_MODULE=${playbookName}", "ND_REPORT_RUN=${expectedRunMarker}",
                     "ND_REPORT_ARCHIVE_SECONDS=${archiveSeconds}",
                     "ND_REPORT_ARCHIVE_STATUS=${archiveSucceeded ? 'success' : 'failed'}",
                     "ND_REPORT_ARTIFACT=${archivedFileName}"]) {
                sh '''#!/bin/bash
                    set -e
                    "$HOME/ansible/venv/bin/python" "$COLLECTIONS_DIRECTORY/nd_result_summary.py" archive \\
                        --log "$ND_REPORT_LOG" --module "$ND_REPORT_MODULE" --run-id "$ND_REPORT_RUN" \\
                        --archive-seconds "$ND_REPORT_ARCHIVE_SECONDS" --archive-status "$ND_REPORT_ARCHIVE_STATUS"
                    for kind in execution phases summary activity; do
                        if [ -f "$ND_REPORT_LOG.$kind.json" ]; then
                            cp "$ND_REPORT_LOG.$kind.json" "$WORKSPACE/$ND_REPORT_ARTIFACT.$kind.json"
                            chmod 0644 "$WORKSPACE/$ND_REPORT_ARTIFACT.$kind.json"
                        fi
                    done
                '''
                def timingSummary = new groovy.json.JsonSlurperClassic().parseText(
                    readFile(file: "${archivedFileName}.summary.json"))
                if (timingSummary.module != playbookName || timingSummary.run_id != expectedRunMarker) {
                    error('Timing summary belongs to another run or module')
                }
                PHASE_TIMING_RESULTS[timingKey] = timingSummary.phase_seconds ?: [:]
                archiveArtifacts artifacts: "${archivedFileName}.*.json", allowEmptyArchive: false, fingerprint: true
                sh '''#!/bin/bash
                    rm -f -- "$WORKSPACE/$ND_REPORT_ARTIFACT.execution.json" "$WORKSPACE/$ND_REPORT_ARTIFACT.phases.json" "$WORKSPACE/$ND_REPORT_ARTIFACT.summary.json" "$WORKSPACE/$ND_REPORT_ARTIFACT.activity.json"
                '''
            }
        } catch (Exception metadataError) {
            echo "Failed to archive result metadata for ${playbookName}: ${metadataError.getMessage() ?: metadataError.getClass().getName()}"
            env.PIPELINE_FAILED = 'true'
        }
    }
}

/**
 * Archives the module-wise skipped-tests summary for a fabric/version and records
 * its artifact filename so the post{} Webex block can link it. Best-effort.
 */
def archiveSkipList(ndfcConfig) {
    def skipFileName = "skipped_tests_${ndfcConfig.fabric_name}_${ndfcConfig.versionId}.txt"
    try {
        def alreadyRecorded = (SKIPLIST_FILES_BUF ?: '').split('\n').findAll { it.trim() }.contains(skipFileName)
        if (alreadyRecorded) {
            return
        }
        // The summary is written into COLLECTIONS_DIRECTORY by the test-run shell.
        def present = sh(script: "cd ${COLLECTIONS_DIRECTORY} && [ -s '${skipFileName}' ]", returnStatus: true) == 0
        if (!present) {
            echo "ℹ️ No skipped-tests summary to archive: ${skipFileName}"
            return
        }
        sh """
            cd ${COLLECTIONS_DIRECTORY}
            cp "${skipFileName}" "${env.WORKSPACE}/${skipFileName}"
            chmod 0644 "${env.WORKSPACE}/${skipFileName}"
        """
        archiveArtifacts artifacts: "${skipFileName}", allowEmptyArchive: true, fingerprint: true
        def report = readFile(file: skipFileName).trim()
        if (report) {
            def compact = []
            def includeNumbered = false
            report.readLines().each { line ->
                def trimmed = line.trim()
                def keep = trimmed.startsWith('MODULE:') ||
                    trimmed.startsWith('RESULT:') ||
                    trimmed.startsWith('ANSIBLE EXIT STATUS:') ||
                    trimmed.startsWith('COMPLETED / OBSERVED TESTS:') ||
                    trimmed.startsWith('LAST COMPLETED / OBSERVED:') ||
                    trimmed.startsWith('FAILED TESTS:') ||
                    trimmed.startsWith('PENDING / FULLY SKIPPED TESTS:') ||
                    trimmed.startsWith('NOT OBSERVED / NOT REACHED TESTS:')
                if (trimmed ==~ /^\d+\..*/) {
                    keep = includeNumbered
                }
                if (trimmed.startsWith('FAILED TESTS:') || trimmed.startsWith('PENDING / FULLY SKIPPED TESTS:')) {
                    includeNumbered = true
                } else if (trimmed.startsWith('NOT OBSERVED / NOT REACHED TESTS:') ||
                           trimmed.startsWith('MODULE:') || trimmed.startsWith('====')) {
                    includeNumbered = false
                }
                if (keep) {
                    compact << line
                }
            }
            def details = (["### ${skipFileName}"] + compact).join('\n')
            SKIPLIST_DETAILS_BUF = (SKIPLIST_DETAILS_BUF ?: '').trim() ?
                "${SKIPLIST_DETAILS_BUF}\n\n${details}" : details
        }
        sh "rm -f ${env.WORKSPACE}/${skipFileName}"
        // Accumulate one filename per fabric/version for the Webex link.
        SKIPLIST_FILES_BUF = (SKIPLIST_FILES_BUF ?: '').trim() ? "${SKIPLIST_FILES_BUF}\n${skipFileName}" : skipFileName
        echo "📦 Archived skipped-tests summary: ${skipFileName}"
    } catch (Exception e) {
        echo "⚠️ Failed to archive skipped-tests summary ${skipFileName}: ${e.getMessage()}"
    }
}

def virtualPeerLinkCapabilityFailures(testOutput) {
    def cases = []
    def taskName = 'unidentified task'
    def failureLines = []
    def inspectFailure = {
        def evidence = failureLines.join(' ').toLowerCase()
        if (!evidence.contains('...ignoring') &&
            (evidence =~ /\b(?:n9k[-_ ]?c)?9300v\b/) &&
            (evidence =~ /virtual[ _-]+peer[ _-]*link|vpc[ _-]+fabric[ _-]+peering/) &&
            (evidence =~ /not supported|unsupported|does not support/)) {
            def label = taskName.replaceAll('[|\r\n\t`]', ' ').take(160)
            if (!cases.contains(label)) {
                cases.add(label)
            }
        }
        failureLines = []
    }
    (testOutput ?: '').split('\n').each { line ->
        if (line.startsWith('TASK [') || line.startsWith('PLAY ') || line.startsWith('PLAY RECAP')) {
            inspectFailure()
            if (line.startsWith('TASK [')) {
                int end = line.lastIndexOf(']')
                taskName = end > 6 ? line.substring(6, end) : 'unidentified task'
            }
        }
        if (line.startsWith('fatal:') || line.startsWith('ERROR!')) {
            inspectFailure()
            failureLines.add(line)
        } else if (!failureLines.isEmpty()) {
            failureLines.add(line)
        }
    }
    inspectFailure()
    cases
}

/**
 * Renders the accumulated per-module rows in TEST_RESULT_SUMMARY_BUF.
 * Rows are stored pipe-delimited as
 * "status|playbook|fabric|nd|passed|failed|skipped|duration|note".
 *
 * Webex does not document support for GitHub-style pipe tables, but it does
 * support fenced code blocks. Render a compact fixed-width table inside a
 * Markdown code block so columns remain aligned. Fabric scope is displayed per module; the ND column is shown when multiple
 * versions are present. Missing iBGP/eBGP counterpart rows are display-only.
 */
def formatPhaseDuration(seconds) {
    if (!(seconds instanceof Number) || seconds < 0 ||
        Double.isNaN(seconds.doubleValue()) || Double.isInfinite(seconds.doubleValue())) {
        return 'N/A'
    }
    long milliseconds = Math.round(seconds.doubleValue() * 1000)
    return String.format('%02dh %02dm %02d.%03ds',
        (long) (milliseconds / 3600000), (long) ((milliseconds % 3600000) / 60000),
        (long) ((milliseconds % 60000) / 1000), milliseconds % 1000)
}

def formatPhaseTimingTable(results, elapsedSeconds) {
    def phases = [prerequisites: 'Prerequisite setup', execution: 'Test execution',
                  cleanup: 'Cleanup', parsing: 'Result parsing', archiving: 'Log archiving']
    def rows = [['Activity', 'Duration', 'Measured / attempts']]
    double measuredTotal = 0
    int measurements = 0
    phases.each { phase, label ->
        def values = results.collect { it[phase] }.findAll { formatPhaseDuration(it) != 'N/A' }
        def seconds = values ? values.sum() : null
        if (seconds != null) {
            measuredTotal += seconds.doubleValue()
            measurements += values.size()
        }
        rows << [label, formatPhaseDuration(seconds), "${values.size()} / ${results.size()}"]
    }
    rows << ['Measured phase subtotal', formatPhaseDuration(measurements ? measuredTotal : null), '-']
    rows << ['Build elapsed (to report)', formatPhaseDuration(elapsedSeconds), '-']
    def lines = rows.collect { row ->
        row[0].padRight(27) + ' | ' + row[1].padLeft(18) + ' | ' + row[2]
    }
    lines.add(1, '-' * 72)
    return '\nFINAL TIME BREAKDOWN\n' + lines.join('\n') +
        '\nN/A = no measurement. Counts cover module attempts reaching reporting; interrupted timings may be partial.' +
        '\nPhase subtotal is not build wall time; other pipeline work is not included.' +
        '\nTarget-internal setup/cleanup is part of execution. Parsing is agent extraction only.' +
        '\nArchiving excludes metadata upload and the combined log bundle.'
}

def fabricScopeLabel(value) {
    def text = (value ?: '').toString().trim()
    if (text in ['iBGP', 'eBGP', 'External', 'Mixed', 'Logical', 'Controller', 'Unknown']) {
        return text
    }
    if (text in ['iBGP+External', 'eBGP+External']) {
        return text
    }
    def lower = text.toLowerCase()
    if (lower.contains('ebgp')) { return 'eBGP' }
    if (lower.contains('external')) { return 'External' }
    if (lower.contains('ibgp') || text == 'VXLAN_EVPN_Fabric') { return 'iBGP' }
    return 'Unknown'
}

def resultContextForTarget(ndfcConfig, token, networkFabricName = '', vpcPairRows = []) {
    def module = token.toString().replaceFirst(/\.yaml$/, '')
    def primary = (ndfcConfig.fabric_name ?: '').toString()
    def scope = fabricScopeLabel(ndfcConfig.fabric_type ?: primary)
    if (scope == 'Unknown') {
        scope = fabricScopeLabel(ndfcConfig.vpc_pair_fabric_type)
    }
    def fabric = primary
    if (module == 'nd_manage_networks') {
        fabric = (networkFabricName ?: primary).toString()
        scope = fabricScopeLabel(fabric)
    } else if (module.startsWith('nd_vpc_pair.')) {
        def pairId = module.substring('nd_vpc_pair.'.length())
        def pair = vpcPairRows.find { it.id.toString() == pairId }
        fabric = pair ? pair.fabric.toString() : primary
        scope = pair ? fabricScopeLabel(pair.type ?: pair.fabric) : 'Unknown'
    } else if (module == 'nd_local_user') {
        fabric = 'controller'
        scope = 'Controller'
    } else if (module == 'nd_manage_fabric') {
        fabric = 'disposable fabric matrix'
        scope = 'Mixed'
    } else if (module in ['nd_manage_fabric_group_vxlan', 'nd_manage_fabric_group_members']) {
        fabric = 'logical fabric groups'
        scope = 'Logical'
    } else if (module in ['nd_manage_l3out', 'nd_manage_links']) {
        fabric = primary + ', ' + (ndfcConfig.fabric_name_2 ?: 'External_Connectivity_Fabric')
        scope = scope + '+External'
    }
    [fabric: fabric, scope: scope]
}

def formatResultsTable(rawSummary, countUnit = 'Ansible tasks') {
    def lines = (rawSummary ?: '').split('\n').findAll { it.trim() }
    if (lines.isEmpty()) {
        return '(no per-module results captured)'
    }
    def cleanCell = { value ->
        (value ?: '').toString().replace('\r', ' ').replace('\n', ' ').replace('\t', ' ')
    }
    def records = lines.collect { line ->
        def fields = line.split('\\|', -1)
        def cell = { int index -> index < fields.size() ? cleanCell(fields[index]).trim() : '' }
        [status: cell(0), module: cell(1), fabric: cell(2), nd: cell(3),
         passed: cell(4), failed: cell(5), skipped: cell(6), duration: cell(7), note: cell(8),
         scope: cell(9) ?: fabricScopeLabel(cell(2))]
    }
    def groups = [:]
    records.each { record ->
        def key = record.module + '|' + record.nd
        if (!groups.containsKey(key)) { groups[key] = [] }
        groups[key].add(record)
    }
    def displayRecords = []
    groups.values().each { group ->
        // Missing counterpart rows are presentation only: never add them to task totals.
        if (group.any { it.scope in ['iBGP', 'eBGP'] }) {
            ['iBGP', 'eBGP'].each { scope ->
                def matching = group.findAll { it.scope == scope }
                if (matching) {
                    displayRecords.addAll(matching)
                } else {
                    displayRecords.add([status: 'NOT_RUN', module: group[0].module,
                        nd: group[0].nd, scope: scope, passed: '-', failed: '-', skipped: '-',
                        duration: 'not scheduled', note: ''])
                }
            }
            displayRecords.addAll(group.findAll { !(it.scope in ['iBGP', 'eBGP']) })
        } else {
            // Combined/shared/controller results cannot be divided into per-fabric counts.
            displayRecords.addAll(group)
        }
    }
    def showNd = records.collect { it.nd }.unique().size() > 1
    def headers = ['Status', 'Module', 'Fabric']
    if (showNd) { headers.add('ND') }
    headers.addAll(['Passed', 'Failed', 'Skipped', 'Duration'])
    def rows = displayRecords.collect { record ->
        def row = [record.status, record.module, record.scope]
        if (showNd) { row.add(record.nd) }
        def noExecution = record.status == 'NOT_RUN'
        row.addAll([noExecution ? '-' : record.passed, noExecution ? '-' : record.failed,
                    noExecution ? '-' : record.skipped, record.duration])
        row.collect { cleanCell(it) }
    }
    def widths = (0..<headers.size()).collect { int index ->
        ([headers[index].length()] + rows.collect { it[index].length() }).max()
    }
    def renderRow = { cells ->
        (0..<cells.size()).collect { int index ->
            def value = cells[index].toString()
            def padding = ' ' * (widths[index] - value.length())
            index < (showNd ? 4 : 3) ? value + padding : padding + value
        }.join('  ')
    }
    def separator = widths.collect { int width -> '-' * width }
    def skipNotes = records.findAll { it.status == 'SKIP' && it.note }
        .collect { "  ${it.module} (${it.scope}): ${it.note}" }
    def skipBlock = skipNotes ? "\n\nSKIPPED - lab substrate unavailable:\n${skipNotes.join('\n')}" : ''
    def resultNotes = records.findAll { it.status in ['FAIL', 'ERR', 'UNKNOWN', 'NOT_RUN'] && it.note }
        .collect { "  ${it.module} (${it.scope}) ${it.status}: ${it.note}" }
    def resultBlock = resultNotes ? "\n\nRESULT DETAILS:\n${resultNotes.join('\n')}" : ''
    // A fabric round that stopped before it could finish (pre-flight, preparation) is listed with its reason.
    def abortNotes = lines.collect { ln -> ln.split('\\|', -1) }
        .findAll { f -> f.size() > 8 && f[0].trim() == 'ABORT' && f[8].trim() }
        .collect { f -> "  ${f[1].trim()}: ${cleanCell(f[8]).trim()}" }
    def abortBlock = abortNotes ? "\n\nROUND NOT COMPLETED:\n${abortNotes.join('\n')}" : ''
    def capabilityRows = lines.collect { ln -> ln.split('\\|', -1) }
        .findAll { fields -> fields.size() > 8 && fields[8].startsWith('NDP_UNSUPPORTED_CAPABILITY count=') }
    int capabilityCount = 0
    def capabilityNotes = capabilityRows.collect { fields ->
        def count = fields[8].substring('NDP_UNSUPPORTED_CAPABILITY count='.length()).split(' ', 2)[0]
        capabilityCount += count as Integer
        "  ${cleanCell(fields[1])} [${cleanCell(fields[2])}]: ${cleanCell(fields[8])}"
    }
    def capabilityBlock = capabilityNotes ? "\n\nUNSUPPORTED CAPABILITY - N9K-C9300v virtual peer-link / vPC Fabric Peering:\n${capabilityCount} affected task case(s) across ${capabilityRows.size()} module/round result(s).\nFailure totals are unchanged; other failures may coexist.\n${capabilityNotes.join('\n')}" : ''
    "```\n${renderRow(headers)}\n${renderRow(separator)}\n${rows.collect { renderRow(it) }.join('\n')}${skipBlock}${resultBlock}${abortBlock}${capabilityBlock}\n```" +
        "\nPassed/Failed/Skipped = ${countUnit}. NOT_RUN = no execution for that fabric." +
        '\nMixed/shared rows contain one combined result; counts are included once.' +
        (countUnit == 'module test cases' ? '\n? = case count unavailable or incomplete; setup and cleanup are excluded.' : '')
}

def splitWebexMessage(message, continuationHeader = '', maxLength = 7000) {
    def text = (message ?: '').toString()
    if (text.length() <= maxLength) { return [text] }
    // Reserve enough room for a numbered part marker after all parts are known.
    int contentLimit = maxLength - 80
    def parts = []
    def current = new StringBuilder()
    boolean inFence = false
    def tableHeader = []
    def startContinuation = {
        current = new StringBuilder(continuationHeader.toString())
        if (inFence) {
            current.append('```\n')
            tableHeader.each { current.append(it).append('\n') }
        }
        if (current.length() + 8 >= contentLimit) {
            throw new IllegalArgumentException('Webex continuation header exceeds message capacity')
        }
    }
    def flushPart = {
        if (inFence) { current.append('```\n') }
        parts.add(current.toString().trim())
        startContinuation()
    }
    text.split('\n', -1).each { originalLine ->
        def line = originalLine.toString()
        boolean fenceLine = line.trim().startsWith('```')
        int reserve = inFence ? 4 : 0
        if (current.length() + line.length() + 1 + reserve > contentLimit && current.length() > 0) {
            flushPart()
        }
        // Preserve even an unusually long diagnostic line instead of truncating content.
        while (current.length() + line.length() + 1 + (inFence ? 4 : 0) > contentLimit) {
            int available = contentLimit - current.length() - 1 - (inFence ? 4 : 0)
            if (available <= 0) { throw new IllegalArgumentException('Webex message capacity exhausted') }
            current.append(line.substring(0, available)).append('\n')
            line = line.substring(available)
            flushPart()
        }
        current.append(line).append('\n')
        if (fenceLine) {
            inFence = !inFence
            if (inFence) { tableHeader = [] }
        } else if (inFence && tableHeader.size() < 2) {
            tableHeader.add(line)
        }
    }
    if (inFence) { current.append('```\n') }
    if (current.toString().trim()) { parts.add(current.toString().trim()) }
    parts.withIndex().collect { part, index ->
        def rendered = "📄 Report part ${index + 1}/${parts.size()}\n" + part
        if (rendered.length() > maxLength) {
            throw new IllegalArgumentException('Webex report part exceeds message limit')
        }
        rendered
    }
}


def splitWebexReport(message, int limit = 7000) {
    def remaining = message.toString()
    if (remaining.length() <= limit) {
        return [remaining]
    }
    def parts = []
    def inCodeBlock = false
    while (remaining) {
        int end = Math.min(remaining.length(), limit - 8)
        if (end < remaining.length()) {
            int newline = remaining.lastIndexOf('\n', end - 1)
            if (newline >= 0) {
                end = newline + 1
            } else if (Character.isHighSurrogate(remaining.charAt(end - 1))) {
                end--
            }
        }
        def prefix = inCodeBlock ? '```\n' : ''
        def body = remaining.substring(0, end)
        body.readLines().each { line ->
            if (line.trim().startsWith('```')) {
                inCodeBlock = !inCodeBlock
            }
        }
        parts.add(prefix + body + (inCodeBlock ? '\n```' : ''))
        remaining = remaining.substring(end)
    }
    parts
}

/**
 * Splits the accumulated result rows into one group per fabric (one per fabric round), keeping their order.
 * Each group's rows are returned as a raw summary string that formatResultsTable can render, so a result
 * table too long for one Webex message can be sent one fabric round at a time.
 */
def groupResultRowsByFabric(rawSummary) {
    def groups = []
    def current = null
    (rawSummary ?: '').split('\n').findAll { it.trim() }.each { ln ->
        def fields = ln.split('\\|', -1)
        def fabric = fields.size() > 2 ? fields[2].trim() : ''
        if (current == null || current.fabric != fabric) {
            current = [fabric: fabric, rows: []]
            groups.add(current)
        }
        current.rows.add(ln)
    }
    return groups.collect { group -> [fabric: group.fabric, rows: group.rows.join('\n')] }
}

/**
 * Posts one plain Markdown message to the Webex space. No Adaptive Card attachment is included, so Webex
 * renders the table and links in the message body. Never throws for a non-200 reply (a notification must
 * not break the pipeline); the caller wraps unexpected errors.
 */
def postWebexMarkdown(message) {
    def markdownJson = message.toString()
        .replace('\\', '\\\\')
        .replace('"', '\\"')
        .replace('\r', '\\r')
        .replace('\n', '\\n')
        .replace('\t', '\\t')
    // Emojis reach the console fine but Webex showed '?' because the httpRequest
    // client encodes the body as ISO-8859-1. Escape every non-ASCII char to a JSON
    // unicode escape so the payload is pure ASCII and the wire charset cannot matter.
    def asciiSafe = new StringBuilder()
    for (int i = 0; i < markdownJson.length(); i++) {
        char ch = markdownJson.charAt(i)
        if (ch > 0x7E || ch < 0x20) {
            asciiSafe.append(String.format('\\u%04x', (int) ch))
        } else {
            asciiSafe.append(ch)
        }
    }
    def payload = '{"roomId":"' + env.WEBEX_ROOM_ID +
        '","markdown":"' + asciiSafe.toString() + '"}'
    int payloadBytes = payload.getBytes('UTF-8').length
    echo "📦 Webex Markdown payload size: ${payloadBytes} bytes (${payload.length()} characters)"

    withCredentials([string(credentialsId: 'ANSIBLE_WEBEX_TOKEN', variable: 'WEBEX_TOKEN')]) {
        // Build a plain String without Groovy interpolation of the secret.
        def authorizationHeader = 'Bearer ' + env.WEBEX_TOKEN
        def resp = httpRequest(
            url: 'https://webexapis.com/v1/messages',
            httpMode: 'POST',
            contentType: 'APPLICATION_JSON_UTF8',
            customHeaders: [[name: 'Authorization', value: authorizationHeader, maskValue: true]],
            requestBody: payload,
            validResponseCodes: '100:599'
        )
        if (resp.status == 200) {
            echo "📊 Pipeline summary notification sent to Webex (HTTP ${resp.status})"
        } else {
            echo "⚠️ Webex notification returned HTTP ${resp.status} (ignored to keep pipeline running): ${resp.content}"
        }
    }
}

/**
 * Escapes text that is shown in a Webex Markdown link label.
 */
def escapeWebexMarkdown(value) {
    (value ?: '').toString()
        .replace('\\', '\\\\')
        .replace('|', '\\|')
        .replace('_', '\\_')
        .replace('*', '\\*')
        .replace('\r', ' ')
        .replace('\n', ' ')
}

/**
