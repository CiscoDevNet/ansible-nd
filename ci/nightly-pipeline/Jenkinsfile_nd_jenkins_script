git -C "${COLLECTIONS_DIRECTORY}" rev-parse --verify 'HEAD^{commit}' 2>/dev/null || true
''',
                        returnStdout: true
                    ).trim()
                    env.ND_GIT_COMMIT = (checkedOutCommit ==~ /(?:[0-9a-f]{40}|[0-9a-f]{64})/) ? checkedOutCommit : ''
