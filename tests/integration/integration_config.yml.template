# Integration test config template.
# Copy to integration_config.yml and fill in your local values.
# Do NOT commit integration_config.yml to git.
#
# Variables here are available as {{ nd_logging_config }}, {{ fabric_name }},
# etc. in integration test playbooks.

# Logging — absolute path to logging_config.json
nd_logging_config: <ABSOLUTE_PATH_TO>/plugins/module_utils/logging_config.json

# Fabric / switch info for policy and policy group tests
fabric_name: <FABRIC_NAME>
switch_serial_1: <SWITCH_SERIAL_NUMBER>
