        "REQUEST_PATH": "/api/v1/manage/fabrics/fabric_1/switches/FDO11111AAA/vpcPair",
        "MESSAGE": "OK",
        "DATA": {
            "switchId": "FDO11111AAA",
            "peerSwitchId": "FDO22222BBB",
            "vpcPairDetails": {
                "domainId": 100,
                "keepAliveVrf": "management"
            }
        }
    },
