    "test_create_bulk_207_00800c": {
        "TEST_NOTES": [
            "00800: bulk POST returns HTTP 207 Multi-Status mixing an exact-success item (Ethernet1/7) and a failed item (Ethernet1/8).",
            "Only the exact success is trusted (vault: multi-status-207-status-field-inconsistent); it must be queued for deploy",
            "so the failure-path finalizer ships it (PR #550 review)."
        ],
        "RETURN_CODE": 207,
        "METHOD": "POST",
        "REQUEST_PATH": "/api/v1/manage/fabrics/fabric_1/switches/FDO11111AAA/interfaces",
        "MESSAGE": "Multi-Status",
        "DATA": {
            "results": [
                {
                    "name": "Ethernet1/7",
                    "status": "success"
                },
                {
                    "name": "Ethernet1/8",
                    "status": "failed",
                    "message": "Invalid interface Ethernet1/8"
                }
            ]
        }
    },
