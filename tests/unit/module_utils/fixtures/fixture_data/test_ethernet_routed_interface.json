                },
                {
                    "interfaceName": "GigabitEthernet2",
                    "interfaceType": "ethernet",
                    "configData": {
                        "mode": "routed",
                        "networkOS": {
                            "networkOSType": "ios-xe",
                            "policy": {
                                "policyType": "csrMultisiteIfcMember",
                                "ip": "10.10.1.2",
                                "prefix": 30
                            }
                        }
                    }
                },
                {
                    "interfaceName": "loopback0",
                    "interfaceType": "loopback",
                    "configData": {
                        "mode": "managed",
                        "networkOS": {
                            "networkOSType": "ios-xe",
                            "policy": {
                                "policyType": "iosXeLoopback",
                                "ip": "10.2.0.2"
                            }
                        }
                    }
                },
                {
                    "interfaceName": "GigabitEthernet4",
                    "interfaceType": "ethernet",
                    "configData": {
                        "mode": "routed",
                        "networkOS": {
                            "networkOSType": "ios-xe",
                            "policy": {
                                "policyType": "iosXeRoutedHost",
                                "adminState": true,
                                "mtu": 1500,
                                "speed": "auto"
                            }
                        }
                    }
                }
