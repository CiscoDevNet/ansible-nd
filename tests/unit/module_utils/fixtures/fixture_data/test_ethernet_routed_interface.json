    "test_query_all_routed_00400c": {
        "TEST_NOTES": [
            "Interfaces for switch FDO11111AAA (NX-OS): one managed routedHost, one trunkHost (different mode/module),",
            "one system 'numbered' fabric link, one 'multiSiteLinkMember', one 'vrfLiteLinkMember' - the last three all",
            "carry configData.mode 'routed' and MUST be excluded (underlay safety).",
            "Ethernet1/20 is a defaults-only routedHost (border-gateway fabric default, incl. the ND-injected ptp key;",
            "lab-verified 2026-07-27 on a borderGateway where ALL unused ports default to routedHost) and MUST be",
            "excluded so state:overridden cannot bulldoze every unused port.",
            "Expect: only Ethernet1/7 (routedHost) is retained."
        ],
        "RETURN_CODE": 200,
        "METHOD": "GET",
        "REQUEST_PATH": "/api/v1/manage/fabrics/fabric_1/switches/FDO11111AAA/interfaces",
        "MESSAGE": "OK",
        "DATA": {
            "interfaces": [
                {
                    "interfaceName": "Ethernet1/7",
                    "interfaceType": "ethernet",
                    "configData": {
                        "mode": "routed",
                        "networkOS": {
                            "networkOSType": "nx-os",
                            "policy": {
                                "policyType": "routedHost",
                                "adminState": true,
                                "ip": "10.99.99.1",
                                "prefix": 30,
                                "description": "routed uplink"
                            }
                        }
                    }
                },
                {
                    "interfaceName": "Ethernet1/8",
                    "interfaceType": "ethernet",
                    "configData": {
                        "mode": "trunk",
                        "networkOS": {
                            "networkOSType": "nx-os",
                            "policy": {
                                "policyType": "trunkHost",
                                "allowedVlans": "1-100"
                            }
                        }
                    }
                },
                {
                    "interfaceName": "Ethernet1/1",
                    "interfaceType": "ethernet",
                    "configData": {
                        "mode": "routed",
                        "networkOS": {
                            "networkOSType": "nx-os",
                            "policy": {
                                "policyType": "numbered",
                                "ip": "10.4.0.1",
                                "prefix": 30
                            }
                        }
                    }
                },
                {
                    "interfaceName": "Ethernet1/3",
                    "interfaceType": "ethernet",
                    "configData": {
                        "mode": "routed",
                        "networkOS": {
                            "networkOSType": "nx-os",
                            "policy": {
                                "policyType": "multiSiteLinkMember",
                                "ip": "10.10.1.1",
                                "prefix": 30
                            }
                        }
                    }
                },
                {
                    "interfaceName": "Ethernet1/4",
                    "interfaceType": "ethernet",
                    "configData": {
                        "mode": "routed",
                        "networkOS": {
                            "networkOSType": "nx-os",
                            "policy": {
                                "policyType": "vrfLiteLinkMember",
                                "ip": "10.33.0.1",
                                "prefix": 30
                            }
                        }
                    }
                },
                {
                    "interfaceName": "Ethernet1/20",
                    "interfaceType": "ethernet",
                    "configData": {
                        "mode": "routed",
                        "networkOS": {
                            "networkOSType": "nx-os",
                            "policy": {
                                "policyType": "routedHost",
                                "adminState": true,
                                "fec": "auto",
                                "ipRedirects": false,
                                "mtu": 9216,
                                "netflow": false,
                                "pfc": false,
                                "pimDrPriority": 1,
                                "pimSparse": false,
                                "ptp": false,
                                "qos": false,
                                "speed": "auto"
                            }
                        }
                    }
                }
            ]
        }
    },
    "test_query_all_routed_00400d": {
