    "test_xe_ownership_00800b": {
        "TEST_NOTES": [
            "00800 (orchestrator): fabric links. GigabitEthernet1/0/48 on FDO22222BBB is the src endpoint of a link carrying an ND link policy",
            "(fabric-owned) while its own interface record reads as a defaults-only iosXeRoutedHost. The policyType value is illustrative:",
            "the guard treats ANY non-empty link policyType as ownership. GigabitEthernet1/0/47's link carries no policyType",
            "(discovered-only adjacency) and must NOT count as ownership.",
            "create_bulk must refuse GigabitEthernet1/0/48 before any POST."
        ],
        "RETURN_CODE": 200,
        "METHOD": "GET",
        "REQUEST_PATH": "/api/v1/manage/links?fabricName=fabric_1",
        "MESSAGE": "OK",
        "DATA": {
            "links": [
                {
                    "linkId": "LINK-UUID-2",
                    "linkType": "ethisl",
                    "linkPresent": true,
                    "linkDiscovered": true,
                    "configData": {},
                    "srcFabricName": "fabric_1",
                    "srcSwitchName": "C1_LE1",
                    "srcSwitchId": "FDO22222BBB",
                    "srcInterfaceName": "GigabitEthernet1/0/47",
                    "dstFabricName": "fabric_1",
                    "dstSwitchName": "C1_AP1",
                    "dstSwitchId": "FDO44444DDD",
                    "dstInterfaceName": "GigabitEthernet0/1"
                },
                {
                    "linkId": "LINK-UUID-1",
                    "linkType": "ethisl",
                    "linkPresent": true,
                    "linkDiscovered": false,
                    "configData": {
                        "policyType": "numbered"
                    },
                    "srcFabricName": "fabric_1",
                    "srcSwitchName": "C1_LE1",
                    "srcSwitchId": "FDO22222BBB",
                    "srcInterfaceName": "GigabitEthernet1/0/48",
                    "dstFabricName": "fabric_1",
                    "dstSwitchName": "C1_CORE1",
                    "dstSwitchId": "FDO33333CCC",
                    "dstInterfaceName": "GigabitEthernet1/0/1"
                }
            ],
            "meta": {
                "counts": {
                    "total": 2,
                    "remaining": 0
                }
            }
        }
    },
