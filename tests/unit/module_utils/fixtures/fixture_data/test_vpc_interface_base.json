        "RETURN_CODE": 200,
        "METHOD": "GET",
        "REQUEST_PATH": "/api/v1/manage/fabrics/fabric_1/switches",
        "MESSAGE": "OK",
        "DATA": {
            "switches": [
                {"fabricManagementIp": "192.168.1.1", "switchId": "FDO11111AAA"},
                {"fabricManagementIp": "192.168.1.2", "switchId": "FDO22222BBB"}
