    "test_loopback_interface_00770c": {
        "TEST_NOTES": [
            "query_all NX+XE union: nx loopback + xe iosXeLoopback + xe csrLoopback kept; userDefined excluded",
            "policyType names and the XE policy-object key set (adminState/description/ip/policyType, networkOSType nested inside networkOS) are lab-verified against the 2026-07-18 intent-path GETs; the surrounding envelope (interfaceName/interfaceType, switch IDs) mirrors sibling fixtures rather than a full wire capture."
        ],
        "RETURN_CODE": 200,
        "METHOD": "GET",
        "REQUEST_PATH": "/api/v1/manage/fabrics/fabric_1/switches/FDO12345ABF/interfaces",
        "MESSAGE": "OK",
        "DATA": {
            "interfaces": [
                {
                    "interfaceName": "loopback10",
                    "interfaceType": "loopback",
                    "configData": {"networkOS": {"networkOSType": "nx-os", "policy": {"policyType": "loopback"}}}
                },
                {
                    "interfaceName": "loopback11",
                    "interfaceType": "loopback",
                    "configData": {
                        "networkOS": {
                            "networkOSType": "ios-xe",
                            "policy": {
                                "adminState": true,
                                "description": "claude xe probe loopback11",
                                "ip": "10.11.11.1",
                                "policyType": "iosXeLoopback"
                            }
                        }
                    }
