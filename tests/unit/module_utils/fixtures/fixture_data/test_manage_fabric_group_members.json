{
    "TEST_NOTES": [
        "Fixture responses for test_manage_fabric_group_members orchestrator tests.",
        "The GET /fabrics/{fabricName}/members response wraps members in a 'fabrics' array."
    ],
    "members_ok": {
        "DATA": {
            "fabrics": [
                {"name": "member-fabric-1", "type": "vxlanIbgp"},
                {"name": "member-fabric-2", "type": "vxlanEbgp"}
            ]
        },
        "MESSAGE": "OK",
        "METHOD": "GET",
        "REQUEST_PATH": "/api/v1/manage/fabrics/GROUP1/members",
        "RETURN_CODE": 200,
        "TEST_NOTES": ["Two members returned from the fabric group members GET endpoint"]
    },
    "members_empty": {
        "DATA": {"fabrics": []},
        "MESSAGE": "OK",
        "METHOD": "GET",
        "REQUEST_PATH": "/api/v1/manage/fabrics/GROUP1/members",
        "RETURN_CODE": 200,
        "TEST_NOTES": ["Empty fabric group members response"]
    },
    "add_members_success": {
        "DATA": {
            "fabrics": [
                {"name": "member-fabric-1", "type": "vxlanIbgp"}
            ]
        },
        "MESSAGE": "OK",
        "METHOD": "POST",
        "REQUEST_PATH": "/api/v1/manage/fabrics/GROUP1/actions/addMembers",
        "RETURN_CODE": 200,
        "TEST_NOTES": ["Add members action succeeds"]
    },
    "remove_members_success": {
        "DATA": {},
        "MESSAGE": "OK",
        "METHOD": "POST",
        "REQUEST_PATH": "/api/v1/manage/fabrics/GROUP1/actions/removeMembers",
        "RETURN_CODE": 200,
        "TEST_NOTES": ["Remove members action succeeds"]
    },
    "probe_fabric_group": {
        "DATA": {"name": "GROUP1", "category": "fabricGroup", "type": "MFD"},
        "MESSAGE": "OK",
        "METHOD": "GET",
        "REQUEST_PATH": "/api/v1/oneManage/manage/fabrics/GROUP1",
        "RETURN_CODE": 200,
        "TEST_NOTES": [
            "OneManage fabric probe for a plain fabric group; category is not multiClusterFabricGroup",
            "so the orchestrator routes member operations to the Manage surface"
        ]
    },
    "probe_multicluster": {
        "DATA": {"name": "GROUP1", "category": "multiClusterFabricGroup", "type": "MCFG"},
        "MESSAGE": "OK",
        "METHOD": "GET",
        "REQUEST_PATH": "/api/v1/oneManage/manage/fabrics/GROUP1",
        "RETURN_CODE": 200,
        "TEST_NOTES": [
            "OneManage fabric probe for a multi-cluster fabric group; routes member operations",
            "to the OneManage surface"
        ]
    },
    "probe_not_found": {
        "DATA": {},
        "MESSAGE": "Not Found",
        "METHOD": "GET",
        "REQUEST_PATH": "/api/v1/oneManage/manage/fabrics/GROUP1",
        "RETURN_CODE": 404,
        "TEST_NOTES": [
            "Defensive only. No ND release observed returns 404 here -- 4.2.1 and 4.3.1 both answer",
            "400 (see probe_single_cluster and probe_mcfg_fabric_not_found). Retained so the 404",
            "branch of NOT_MULTICLUSTER_RETURN_CODES stays covered if a future release uses it"
        ]
    },
    "probe_single_cluster": {
        "DATA": {"code": 400, "description": "", "message": "Multi-cluster environment must be configured before using this feature"},
        "MESSAGE": "Bad Request",
        "METHOD": "GET",
        "REQUEST_PATH": "/api/v1/oneManage/manage/fabrics/GROUP1",
        "RETURN_CODE": 400,
        "TEST_NOTES": [
            "Captured from ND 4.2.1 and 4.3.1. A single-cluster controller rejects every OneManage",
            "path with this 400 before it resolves the fabric name"
        ]
    },
    "probe_mcfg_fabric_not_found": {
        "DATA": {"code": 400, "description": "", "message": "fabric not found"},
        "MESSAGE": "Bad Request",
        "METHOD": "GET",
        "REQUEST_PATH": "/api/v1/oneManage/manage/fabrics/GROUP1",
        "RETURN_CODE": 400,
        "TEST_NOTES": [
            "Captured from a multi-cluster ND 4.2.1 (clusters nd01 + nd02). A multi-cluster",
            "controller answers 400 'fabric not found' -- not 404 -- for a fabric that is not a",
            "multi-cluster fabric group, so the orchestrator routes to the Manage surface"
        ]
    },
    "probe_server_error": {
        "DATA": {},
        "MESSAGE": "Internal Server Error",
        "METHOD": "GET",
        "REQUEST_PATH": "/api/v1/oneManage/manage/fabrics/GROUP1",
        "RETURN_CODE": 500,
        "TEST_NOTES": [
            "A transient OneManage failure. It must not be read as 'not multi-cluster', which",
            "would send the run's writes to the Manage surface with the wrong payload shape"
        ]
    },
    "onemanage_members_ok": {
        "DATA": {
            "fabrics": [
                {"clusterName": "cluster-a", "fabricGroupName": "GROUP1", "name": "member-fabric-1", "type": "vxlanIbgp"},
                {"clusterName": "cluster-b", "fabricGroupName": "GROUP1", "name": "member-fabric-2", "type": "vxlanEbgp"}
            ]
        },
        "MESSAGE": "OK",
        "METHOD": "GET",
        "REQUEST_PATH": "/api/v1/oneManage/manage/fabrics/GROUP1/members",
        "RETURN_CODE": 200,
        "TEST_NOTES": ["Two multi-cluster fabric group members, each identified by cluster and name"]
    },
    "onemanage_add_success": {
        "DATA": {
            "fabrics": [
                {"clusterName": "cluster-a", "fabricGroupName": "GROUP1", "name": "member-fabric-1", "type": "vxlanIbgp"}
            ]
        },
        "MESSAGE": "OK",
        "METHOD": "POST",
        "REQUEST_PATH": "/api/v1/oneManage/manage/fabrics/GROUP1/actions/addMembers",
        "RETURN_CODE": 200,
        "TEST_NOTES": ["Add multi-cluster fabric group member action succeeds"]
    },
    "onemanage_remove_success": {
        "DATA": {},
        "MESSAGE": "OK",
        "METHOD": "POST",
        "REQUEST_PATH": "/api/v1/oneManage/manage/fabrics/GROUP1/actions/removeMembers",
        "RETURN_CODE": 200,
        "TEST_NOTES": ["Remove multi-cluster fabric group member action succeeds"]
    },
    "config_save_success": {
        "DATA": {"status": "Config save is completed"},
        "MESSAGE": "OK",
        "METHOD": "POST",
        "REQUEST_PATH": "/api/v1/manage/fabrics/GROUP1/actions/configSave",
        "RETURN_CODE": 200,
        "TEST_NOTES": ["Fabric group config save action succeeds"]
    },
    "deploy_success": {
        "DATA": {},
        "MESSAGE": "OK",
        "METHOD": "POST",
        "REQUEST_PATH": "/api/v1/manage/fabrics/GROUP1/actions/deploy",
        "RETURN_CODE": 200,
        "TEST_NOTES": ["Fabric group global deploy action succeeds"]
    },
    "switches_out_of_sync": {
        "DATA": {
            "switches": [
                {"serialNumber": "SN-INSYNC", "additionalData": {"configSyncStatus": "inSync"}},
                {"serialNumber": "SN-DRIFT", "additionalData": {"configSyncStatus": "outOfSync"}}
            ]
        },
        "MESSAGE": "OK",
        "METHOD": "GET",
        "REQUEST_PATH": "/api/v1/manage/fabrics/GROUP1/switches",
        "RETURN_CODE": 200,
        "TEST_NOTES": ["One in-sync switch and one out-of-sync switch; only the latter is deployed"]
    },
    "switch_deploy_success": {
        "DATA": {},
        "MESSAGE": "OK",
        "METHOD": "POST",
        "REQUEST_PATH": "/api/v1/manage/fabrics/GROUP1/switchActions/deploy",
        "RETURN_CODE": 200,
        "TEST_NOTES": ["Switch-level deploy action succeeds"]
    }
}
