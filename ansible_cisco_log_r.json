{
        "version": 1,
        "formatters": {
            "standard": {
                "class": "logging.Formatter",
                "format": "%(asctime)s - %(levelname)s - [%(name)s.%(funcName)s.%(lineno)d] %(message)s"
            }
        },
        "handlers": {
            "file": {
                "class": "logging.handlers.RotatingFileHandler",
                "formatter": "standard",
                "level": "DEBUG",
                "filename": "/Users/achengam/Documents/Ansible_Dev/NDBranch/ansible_collections/cisco/nd/Manage_Switches_R1.txt",
                "mode": "a",
                "encoding": "utf-8",
                "maxBytes": 50000000,
                "backupCount": 4
            }
        },
        "loggers": {
            "dcnm": {
                "handlers": [
                    "file"
                ],
                "level": "DEBUG",
                "propagate": false
            }
        },
        "root": {
            "level": "DEBUG",
            "handlers": [
                "file"
            ]
        }
}